{
  "schema": 1,
  "id": "probe/abspath-stops-at-vertical-tab",
  "oracle": "abspath ends at ASCII whitespace other than space and tab",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{python}",
      "-c",
      "import sys; sys.stdout.buffer.write(b'/a/b\\x0bc\\n')"
    ],
    "env": {},
    "unset": [],
    "stdin": "",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "exact",
      "value": "<abspath>\u000bc\n",
      "normalize": [
        "abspath"
      ]
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": []
  }
}
