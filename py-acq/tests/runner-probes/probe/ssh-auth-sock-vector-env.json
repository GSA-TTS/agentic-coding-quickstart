{
  "schema": 1,
  "id": "probe/ssh-auth-sock-vector-env",
  "oracle": "a vector that sets SSH_AUTH_SOCK in invoke.env gets its own value",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{python}",
      "-c",
      "import os, sys; sys.stdout.write(os.environ.get('SSH_AUTH_SOCK', '<unset>'))"
    ],
    "env": {
      "SSH_AUTH_SOCK": "/vector/agent.sock"
    },
    "unset": [],
    "stdin": "",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "exact",
      "value": "/vector/agent.sock",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": []
  }
}
