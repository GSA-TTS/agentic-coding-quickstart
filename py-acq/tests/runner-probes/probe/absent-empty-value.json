{
  "schema": 1,
  "id": "probe/absent-empty-value",
  "oracle": "an empty absent value is invalid (it could never pass)",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{python}",
      "-c",
      "import sys; sys.stdout.buffer.write(b'')"
    ],
    "env": {},
    "unset": [],
    "stdin": "",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "absent",
      "value": "",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": []
  }
}
