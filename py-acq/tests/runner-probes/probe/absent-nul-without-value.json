{
  "schema": 1,
  "id": "probe/absent-nul-without-value",
  "oracle": "absent fails NUL-holding output even when the value is truly missing: the search cannot be trusted (expected to FAIL)",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{python}",
      "-c",
      "import sys; sys.stdout.buffer.write(b'x\\x00y\\n')"
    ],
    "env": {},
    "unset": [],
    "stdin": "",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "absent",
      "value": "sentinel-9f2c",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": []
  }
}
