{
  "schema": 1,
  "id": "probe/tmpdir-is-literal",
  "oracle": "tmpdir matches TMPDIR as text: the '.' in the runner's TMPDIR (…/a.b/) is not a wildcard",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{python}",
      "-c",
      "import os, sys; sys.stdout.write(os.environ['TMPDIR'].rstrip('/').replace('.', 'X') + '\\n')"
    ],
    "env": {},
    "unset": [],
    "stdin": "",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "contains",
      "value": "/aXb\n",
      "normalize": [
        "tmpdir"
      ]
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": []
  }
}
