{
  "schema": 1,
  "id": "probe/absent-with-normalize",
  "oracle": "an absent assertion with a transform is invalid: abspath would rewrite the value it looks for",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{python}",
      "-c",
      "import sys; sys.stdout.buffer.write(b'/run/secret-9f2c\\n')"
    ],
    "env": {},
    "unset": [],
    "stdin": "",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "absent",
      "value": "/run/secret-9f2c",
      "normalize": [
        "abspath"
      ]
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": []
  }
}
