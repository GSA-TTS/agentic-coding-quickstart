{
  "schema": 1,
  "id": "probe/abspath-stops-at-quotes",
  "oracle": "abspath ends at a double quote, as in a JSON string",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{python}",
      "-c",
      "import sys; sys.stdout.buffer.write(b'{\"path\": \"/a/b\"}\\n')"
    ],
    "env": {},
    "unset": [],
    "stdin": "",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "exact",
      "value": "{\"path\": \"<abspath>\"}\n",
      "normalize": [
        "abspath"
      ]
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": []
  }
}
