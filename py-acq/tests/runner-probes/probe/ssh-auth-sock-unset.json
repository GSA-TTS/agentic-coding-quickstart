{
  "schema": 1,
  "id": "probe/ssh-auth-sock-unset",
  "oracle": "a developer's SSH_AUTH_SOCK never reaches a vector: the runner removes it",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{python}",
      "-c",
      "import os, sys; sys.stdout.write(os.environ.get('SSH_AUTH_SOCK', '<unset>'))"
    ],
    "env": {},
    "unset": [],
    "stdin": "",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "exact",
      "value": "<unset>",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": []
  }
}
