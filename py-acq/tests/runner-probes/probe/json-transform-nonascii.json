{
  "schema": 1,
  "id": "probe/json-transform-nonascii",
  "oracle": "json transform escapes non-ASCII as \\uXXXX",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{python}",
      "-c",
      "import sys; sys.stdout.buffer.write('{\"a\": \"é\"}'.encode())"
    ],
    "env": {},
    "unset": [],
    "stdin": "",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "exact",
      "value": "{\"a\":\"\\u00e9\"}",
      "normalize": [
        "json"
      ]
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": []
  }
}
