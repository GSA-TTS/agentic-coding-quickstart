{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "CLAUDE.md",
    "CONTRIBUTING.md",
    ".cursor/rules/*.md",
    ".github/copilot-instructions.md"
  ],
  "agent": {
    "compaction": { "temperature": 0 },
    "summary": { "temperature": 0 },
    "title": { "temperature": 0 }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 20000
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "dist/**",
      "build/**",
      ".next/**",
      ".cache/**",
      ".venv/**",
      "venv/**",
      "__pycache__/**",
      ".pytest_cache/**",
      ".mypy_cache/**",
      ".ruff_cache/**",
      "coverage/**"
    ]
  },
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*.tfvars": "deny",
      "*.tfvars.json": "deny",
      "**/.aws/*": "deny",
      "**/.gcloud/*": "deny",
      "**/.azure/*": "deny",
      "**/application_default_credentials.json": "deny",
      "*_accessKeys.csv": "deny",
      "**/kubeconfig*": "deny",
      "**/.kube/*": "deny",
      "**/.npmrc": "deny",
      "**/.pypirc": "deny",
      "**/pip.conf": "deny",
      "**/.docker/config.json": "deny",
      "**/.vault-token": "deny",
      "**/*.hclic": "deny",
      "**/.git-credentials": "deny",
      "**/.netrc": "deny",
      "*vault*.yml": "deny",
      "*vault*.yaml": "deny",
      "**/secrets/**": "deny",
      "**/credentials/**": "deny",
      "**/.secrets/**": "deny",
      ".env.example": "allow",
      "*.env.example": "allow",
      "*.tfvars.example": "allow"
    },
    "bash": {
      "*": "allow",
      "git push": "ask",
      "git push *": "ask",
      "git remote add *": "ask",
      "git remote set-url *": "ask",
      "gh pr create*": "ask",
      "gh api*": "ask",
      "gh pr merge*": "ask",
      "gh api*/pulls/*/merge*": "ask",
      "gh api*/merge*": "ask",
      "scp": "ask",
      "scp *": "ask",
      "sftp": "ask",
      "sftp *": "ask",
      "rsync": "ask",
      "rsync *": "ask",
      "nc": "ask",
      "nc *": "ask",
      "ncat": "ask",
      "ncat *": "ask",
      "netcat": "ask",
      "netcat *": "ask",
      "telnet": "ask",
      "telnet *": "ask",
      "rm *../*": "ask",
      "rm *..": "ask",
      "rm * /*": "ask",
      "rm -* /*": "ask",
      "rm -rf /*": "ask",
      "rm -rf ~*": "ask",
      "rm -rf $HOME*": "ask",
      "curl *-d*": "ask",
      "curl *--data*": "ask",
      "curl *-F*": "ask",
      "curl *--form*": "ask",
      "curl *-T*": "ask",
      "curl *--upload-file*": "ask",
      "curl *-X POST*": "ask",
      "curl *-X PUT*": "ask",
      "curl *--request POST*": "ask",
      "curl *--request PUT*": "ask",
      "wget *--post-data*": "ask",
      "wget *--post-file*": "ask",
      "wget *--method=POST*": "ask",
      "wget *--body-data*": "ask",
      "wget *--body-file*": "ask"
    }
  }
}
