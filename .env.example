# Agent Sandbox — Environment Variables
# Copy to .env, fill in values, then run 'make encrypt'
#
# Primary API key (for Anthropic-based agents like Claude/OpenCode)
ANTHROPIC_API_KEY=
#
# Optional: pass-through keys for non-Anthropic model providers.
# These are injected into the sandbox container as-is. Only needed
# if your agent uses OpenAI or OpenRouter models.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
#
# Optional: model override (passed to agent inside sandbox)
# AGENT_MODEL=claude-sonnet-4
#
# --- OpenAI-Compatible API Provider (for model discovery + OpenCode config) ---
# Set these to auto-discover models from any OpenAI-compatible API
# (GSA USAi, Ollama, vLLM, LiteLLM, etc.)
#
# Base URL of the API (must include /v1, e.g., https://api.example.gov/api/v1)
# OPENAI_COMPAT_BASE_URL=
#
# API key for the provider
# OPENAI_COMPAT_API_KEY=
#
# Display name for the provider (used in opencode.jsonc)
# OPENAI_COMPAT_PROVIDER_NAME=my-provider
