# Agent Sandbox — Environment Variables
# Run 'make quickstart' after editing this file.
#
# ============================================================================
# REQUIRED — Model Discovery (needed for 'make quickstart' and 'make config')
# ============================================================================
# These settings configure your OpenAI-compatible API provider.
# Supported providers: GSA USAi, Ollama, vLLM, LiteLLM, OpenRouter, etc.
#
# Base URL (must include /v1 path)
OPENAI_COMPAT_BASE_URL=
#
# API key for the provider
OPENAI_COMPAT_API_KEY=
#
# ============================================================================
# RECOMMENDED — GitHub Token (for git operations inside sandbox)
# ============================================================================
# Fine-grained PAT with scopes: contents:write, pull_requests:write, actions:read
# This allows the agent to: clone, commit, push, create PRs, monitor CI
# This does NOT allow: merging PRs, changing repo settings (human review required)
#
# Create one at: https://github.com/settings/personal-access-tokens/new
# Or run 'make setup-github' to open a pre-configured token creation page
#
GITHUB_TOKEN=
#
# ============================================================================
# OPTIONAL — Provider Display Name
# ============================================================================
# Human-readable name shown in opencode.json (default: custom-api)
# OPENAI_COMPAT_PROVIDER_NAME=my-provider
#
# ============================================================================
# OPTIONAL — Pass-through API Keys
# ============================================================================
# These are injected into the sandbox for agents that call APIs directly.
# Only set the ones you need.
#
# Anthropic API (for Claude-based agents)
# ANTHROPIC_API_KEY=
#
# OpenAI API (for GPT-based agents)
# OPENAI_API_KEY=
#
# OpenRouter (multi-provider routing)
# OPENROUTER_API_KEY=
#
# ============================================================================
# OPTIONAL — Model Override
# ============================================================================
# Force a specific model instead of the discovered default
# AGENT_MODEL=claude-sonnet-4
