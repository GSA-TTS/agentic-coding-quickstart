# Secrets — never commit
*.pem
*.key
.env
.env.enc

# SOPS config (generated per-user by 'make setup' with user's AGE public key)
.sops.yaml

# SOPS age key files (if accidentally created locally)
keys.txt
*.age

# macOS Keychain exports (sensitive)
*.keychain
*.keychain-db

# Generated config (contains endpoint URLs, generated by 'make config')
opencode.jsonc
opencode.json

# Audit logs
audit.log

# Docker state
.docker/

# Temporary files
*.tmp
*.bak
.*.bak
*.log
tmp/
temp/

# Core dumps
core
core.*

# Coverage/test output
coverage/
*.coverage
.coverage

# Python (if any scripting tools used)
__pycache__/
*.pyc
.pytest_cache/

# Node (if any tooling used)
node_modules/

# Shell history/debug
.bash_history
.sh_history

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*~
