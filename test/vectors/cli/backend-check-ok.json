{
  "schema": 1,
  "id": "cli/backend-check-ok",
  "oracle": "ADR-0040m version capability: a supported backend version passes the floor check",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": ["{acq}", "backend", "check", "msb", "--json"],
    "env": {
      "ACQ_MSB_BIN": "__stub__",
      "ACQ_MSB_VERSION": "0.7.7"
    },
    "unset": ["ACQ_SBX_INSTALLED", "ACQ_SBX_VERSION", "ACQ_MSB_INSTALLED", "ACQ_BACKEND"],
    "stdin": "",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "json",
      "value": {
        "schema_version": 1,
        "command": "backend check",
        "data": {"name": "msb", "installed": true, "version": "0.7.7"}
      },
      "normalize": []
    },
    "stderr": {"mode": "exact", "value": "", "normalize": []}
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": ["HOME", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_CACHE_HOME"]
  }
}
