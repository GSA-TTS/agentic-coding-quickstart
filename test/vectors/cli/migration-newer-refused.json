  },
  "expect": {
    "exit": 1,
    "stdout": {
      "mode": "json",
      "value": {
        "schema_version": 1,
        "command": "stop",
        "error": {"code": "state_schema_unsupported"}
      },
      "normalize": []
    },
    "stderr": {"mode": "exact", "value": "", "normalize": []}
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
