      "ACQ_SBX_INSTALLED": "0",
      "ACQ_STATE_SEED": "{\"msb/future\":{\"schema\":99,\"name\":\"future\",\"backend\":\"msb\"}}"
    },
    "unset": ["ACQ_BACKEND", "ACQ_STATE_DIR", "MSB_HOME", "ACQ_IMAGE", "ACQ_MSB_IMAGE", "ACQ_MSB_STUB_CATALOG", "ACQ_MSB_READY_TIMEOUT", "ACQ_MSB_STUB_FAIL", "ACQ_MSB_STUB_EXEC_EXIT", "ACQ_MSB_STUB_COPY_EXIT", "ACQ_MSB_STUB_EXIT_CODE", "ACQ_MSB_STUB_PORTS", "ACQ_SECURITY_MOUNT_STATE", "ACQ_MIGRATION_LOCK_TIMEOUT"],
    "stdin": "",
