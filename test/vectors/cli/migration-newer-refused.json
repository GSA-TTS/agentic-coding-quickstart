{
  "schema": 1,
  "id": "cli/migration-newer-refused",
  "oracle": "ADR-0041m fail-closed forward-only migration: a newer-schema record is refused with a stable code + remediation before any mutation",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": ["{acq}", "--backend", "msb", "stop", "box", "--json"],
    "env": {
      "ACQ_MSB_BIN": "__stub__",
      "ACQ_MSB_VERSION": "0.7.7",
