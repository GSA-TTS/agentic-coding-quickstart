{
  "schema": 1,
  "id": "cli/secret-rm-raw-placeholder-force",
  "oracle": "ADR-0038m \u00a748 raw-placeholder removal always passes -f with stdin closed, so sbx's confirm prompt never runs (the stub refuses on an unanswered prompt, and a 'n' on acq's own stdin must never reach it)",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{acq}",
      "--backend",
      "sbx",
      "secret",
      "rm",
      "sbx-cs-vecusai01",
      "--json"
    ],
    "env": {
      "ACQ_SBX_BIN": "__stub__",
      "ACQ_SBX_VERSION": "0.51.0",
      "ACQ_SBX_INSTALLED": "1",
      "ACQ_MSB_INSTALLED": "0",
      "ACQ_SBX_STUB_CUSTOM_SECRETS": "[{\"scope\":\"global\",\"env\":\"USAI_API_KEY\",\"placeholder\":\"sbx-cs-vecusai01\",\"targets\":[\"api.gsa.usai.gov\"]}]"
    },
    "unset": [
      "ACQ_BACKEND",
      "ACQ_STATE_DIR",
      "SBX_HOME",
      "ACQ_IMAGE",
      "ACQ_MSB_IMAGE",
      "ACQ_MSB_READY_TIMEOUT",
      "ACQ_SBX_STUB_CATALOG",
      "ACQ_SBX_STUB_FAIL",
      "ACQ_SBX_STUB_SECRETS",
      "ACQ_SBX_STUB_RAW_PLACEHOLDERS",
      "ACQ_SBX_STUB_SECRET_LS_RAW",
      "ACQ_PROVIDER_CREDENTIAL_BINDINGS",
      "ACQ_PROVIDER_CREDENTIAL_SEED"
    ],
    "stdin": "n\n",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "exact",
      "value": "{\"command\":\"secret rm\",\"data\":{\"placeholder\":\"sbx-cs-vecusai01\",\"value_state\":\"unset\"},\"schema_version\":1}",
      "normalize": [
        "json"
      ]
    },
    "stderr": {
      "mode": "exact",
      "value": "",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": [
      "HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_STATE_HOME",
      "XDG_CACHE_HOME",
      "ACQ_SECRET_STORE_DIR"
    ]
  }
}
