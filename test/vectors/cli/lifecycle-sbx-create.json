{
  "schema": 1,
  "id": "cli/lifecycle-sbx-create",
  "oracle": "ADR-0040m sbx provision capability: create a sandbox end to end against the sbx stub and record host-authoritative state (shell selects no agent kit, so no kit-apply is needed; opencode requires kit-apply, which is msb-only in this slice)",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
