{
  "schema": 1,
  "id": "cli/secret-rm-json",
  "oracle": "ADR-0038m \u00a7secret rm: exit 0 and value_state unset on success; never a value field",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{acq}",
      "--backend",
      "sbx",
      "secret",
      "rm",
      "-g",
      "usai",
      "--json"
    ],
    "env": {
      "ACQ_SBX_BIN": "__stub__",
      "ACQ_SBX_VERSION": "0.39.0",
      "ACQ_SBX_INSTALLED": "1",
      "ACQ_MSB_INSTALLED": "0",
      "ACQ_SBX_STUB_SECRETS": "{\"global\":{\"usai\":\"set\"}}"
    },
    "unset": [
      "ACQ_BACKEND",
      "ACQ_STATE_DIR",
      "SBX_HOME",
      "ACQ_IMAGE",
      "ACQ_MSB_IMAGE",
      "ACQ_MSB_READY_TIMEOUT",
      "ACQ_SBX_STUB_CATALOG",
      "ACQ_SBX_STUB_FAIL",
      "ACQ_SBX_STUB_SECRET_LS_RAW"
    ],
    "stdin": "",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "exact",
      "value": "{\"command\":\"secret rm\",\"data\":{\"scope\":\"global\",\"service\":\"usai\",\"value_state\":\"unset\"},\"schema_version\":1}",
      "normalize": [
        "json"
      ]
    },
    "stderr": {
      "mode": "exact",
      "value": "",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": [
      "HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_STATE_HOME",
      "XDG_CACHE_HOME",
      "ACQ_SECRET_STORE_DIR"
    ]
  }
}
