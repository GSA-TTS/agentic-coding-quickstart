{
  "schema": 1,
  "id": "cli/secret-import-all",
  "oracle": "secret import --all stores every detected host token (GITHUB_TOKEN, USAI_API_KEY) in the acq store, needs no backend, and reports outcomes without ever echoing a value",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{acq}",
      "secret",
      "import",
      "--all",
      "--json"
    ],
    "env": {
      "ACQ_MSB_INSTALLED": "0",
      "ACQ_SBX_INSTALLED": "0",
      "USAI_API_KEY": "vector-usai-0001",
      "GITHUB_TOKEN": "vector-gh-0002"
    },
    "unset": [
      "ACQ_BACKEND",
      "ACQ_STATE_DIR",
      "USAI_API_KEY",
      "GITHUB_TOKEN",
      "GH_TOKEN",
      "GITLAB_TOKEN",
      "ACQ_SECRET_IMPORT_ASSUME_YES",
      "ACQ_PROVIDER_CREDENTIAL_BINDINGS",
      "ACQ_PROVIDER_CREDENTIAL_SEED"
    ],
    "stdin": "",
    "timeout_ms": 10000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "exact",
      "value": "{\"command\":\"secret import\",\"data\":{\"dry_run\":false,\"imported\":2,\"mode\":\"all\",\"results\":[{\"existed\":false,\"outcome\":\"imported\",\"service\":\"github\",\"source_env\":\"GITHUB_TOKEN\"},{\"existed\":false,\"outcome\":\"imported\",\"service\":\"usai\",\"source_env\":\"USAI_API_KEY\"}],\"scope\":\"global\",\"scope_kind\":\"global\",\"skipped\":0},\"schema_version\":1}",
      "normalize": [
        "json"
      ]
    },
    "stderr": {
      "mode": "exact",
      "value": "",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": [
      "HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_STATE_HOME",
      "XDG_CACHE_HOME",
      "ACQ_SECRET_STORE_DIR"
    ]
  }
}
