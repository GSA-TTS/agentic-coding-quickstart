{
  "schema": 1,
  "id": "cli/secret-set-host-needs-env",
  "oracle": "secret set --host binds a host and an env var together: --host without --env (and no env mapping for the service) is refused before anything is stored",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{acq}",
      "--backend",
      "sbx",
      "secret",
      "set",
      "-g",
      "svc",
      "--host",
      "api.example.gov",
      "--json"
    ],
    "env": {
      "ACQ_SBX_BIN": "__stub__",
      "ACQ_SBX_VERSION": "0.39.0",
      "ACQ_SBX_INSTALLED": "1",
      "ACQ_MSB_INSTALLED": "0"
    },
    "unset": [
      "ACQ_BACKEND",
      "ACQ_STATE_DIR",
      "SBX_HOME",
      "ACQ_IMAGE",
      "ACQ_MSB_IMAGE",
      "ACQ_MSB_READY_TIMEOUT",
      "ACQ_SBX_STUB_CATALOG",
      "ACQ_SBX_STUB_FAIL",
      "ACQ_SBX_STUB_SECRETS",
      "ACQ_SBX_STUB_SECRET_LS_RAW"
    ],
    "stdin": "vector-value-0003\n",
    "timeout_ms": 10000
  },
  "expect": {
    "exit": 1,
    "stdout": {
      "mode": "json",
      "value": {
        "schema_version": 1,
        "command": "secret set",
        "error": {
          "code": "validation_failed"
        }
      },
      "normalize": []
    },
    "stderr": {
      "mode": "exact",
      "value": "",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": [
      "HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_STATE_HOME",
      "XDG_CACHE_HOME",
      "ACQ_SECRET_STORE_DIR"
    ]
  }
}
