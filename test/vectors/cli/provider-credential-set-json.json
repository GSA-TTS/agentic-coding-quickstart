{
  "schema": 1,
  "id": "cli/provider-credential-set-json",
  "oracle": "ADR-0038m \u00a72 provider-credential set success on msb: the value (stdin only) goes to the acq secret store, the binding reports provider/key_env/hosts/source_layer, never a value",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{acq}",
      "--backend",
      "msb",
      "provider-credential",
      "set",
      "usai",
      "USAI_API_KEY",
      "--host",
      "api.gsa.usai.gov",
      "--json"
    ],
    "env": {
      "ACQ_MSB_BIN": "__stub__",
      "ACQ_MSB_VERSION": "0.7.7",
      "ACQ_MSB_INSTALLED": "1",
      "ACQ_SBX_INSTALLED": "0"
    },
    "unset": [
      "ACQ_BACKEND",
      "ACQ_STATE_DIR",
      "MSB_HOME",
      "ACQ_IMAGE",
      "ACQ_MSB_IMAGE",
      "ACQ_MSB_READY_TIMEOUT",
      "ACQ_MSB_STUB_CATALOG",
      "ACQ_MSB_STUB_FAIL",
      "ACQ_MSB_STUB_SECRETS",
      "ACQ_MSB_STUB_SECRET_LS_RAW",
      "ACQ_MSB_STUB_ROTATE",
      "ACQ_PROVIDER_CREDENTIAL_BINDINGS",
      "ACQ_PROVIDER_CREDENTIAL_SEED"
    ],
    "stdin": "placeholder-provider-key-1234\n",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 0,
    "stdout": [
      {
        "mode": "json",
        "value": {
          "schema_version": 1,
          "command": "provider-credential set",
          "data": {
            "provider": "usai",
            "key_env": "USAI_API_KEY",
            "hosts": [
              "api.gsa.usai.gov"
            ],
            "source_layer": "provider-credentials"
          }
        },
        "normalize": []
      },
      {"mode": "absent", "value": "placeholder-provider-key-1234", "normalize": []}
    ],
    "stderr": {
      "mode": "exact",
      "value": "",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": [
      "HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_STATE_HOME",
      "XDG_CACHE_HOME",
      "ACQ_SECRET_STORE_DIR"
    ]
  }
}
