{
  "schema": 1,
  "id": "cli/secret-set-usai-sbx-custom",
  "oracle": "sbx credential routing (Bash _ACQ_SBX_BUILTIN_SERVICES): usai is not an sbx built-in, so `secret set -g usai` binds it to its pinned host with `sbx secret set-custom --host api.gsa.usai.gov --env USAI_API_KEY --value-stdin` (sbx >= 0.51.0), never the native `sbx secret set usai` route (stubbed to fail here), with the value on stdin only",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{acq}",
      "--backend",
      "sbx",
      "secret",
      "set",
      "-g",
      "usai",
      "--json"
    ],
    "env": {
      "ACQ_SBX_BIN": "__stub__",
      "ACQ_SBX_VERSION": "0.51.0",
      "ACQ_SBX_INSTALLED": "1",
      "ACQ_MSB_INSTALLED": "0",
      "ACQ_SBX_STUB_FAIL": "secret set"
    },
    "unset": [
      "ACQ_BACKEND",
      "ACQ_STATE_DIR",
      "SBX_HOME",
      "ACQ_IMAGE",
      "ACQ_MSB_IMAGE",
      "ACQ_MSB_READY_TIMEOUT",
      "ACQ_SBX_STUB_CATALOG",
      "ACQ_SBX_STUB_SECRETS",
      "ACQ_SBX_STUB_CUSTOM_SECRETS",
      "ACQ_SBX_STUB_RAW_PLACEHOLDERS",
      "ACQ_SBX_STUB_SECRET_LS_RAW",
      "ACQ_PROVIDER_CREDENTIAL_BINDINGS",
      "ACQ_PROVIDER_CREDENTIAL_SEED"
    ],
    "stdin": "vector-usai-0003\n",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "exact",
      "value": "{\"command\":\"secret set\",\"data\":{\"scope\":\"global\",\"scope_kind\":\"global\",\"service\":\"usai\",\"value_state\":\"set\"},\"schema_version\":1}",
      "normalize": [
        "json"
      ]
    },
    "stderr": {
      "mode": "exact",
      "value": "",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": [
      "HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_STATE_HOME",
      "XDG_CACHE_HOME",
      "ACQ_SECRET_STORE_DIR"
    ]
  }
}
