{
  "schema": 1,
  "id": "cli/secret-import-dry-run",
  "oracle": "secret import --dry-run reports what would be imported and writes nothing (Bash acq_secret_import parity)",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{acq}",
      "secret",
      "import",
      "--dry-run",
      "--force"
    ],
    "env": {
      "ACQ_MSB_INSTALLED": "0",
      "ACQ_SBX_INSTALLED": "0",
      "USAI_API_KEY": "vector-usai-0001"
    },
    "unset": [
      "ACQ_BACKEND",
      "ACQ_STATE_DIR",
      "USAI_API_KEY",
      "GITHUB_TOKEN",
      "GH_TOKEN",
      "GITLAB_TOKEN",
      "ACQ_SECRET_IMPORT_ASSUME_YES",
      "ACQ_PROVIDER_CREDENTIAL_BINDINGS",
      "ACQ_PROVIDER_CREDENTIAL_SEED"
    ],
    "stdin": "",
    "timeout_ms": 10000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "exact",
      "value": "secret import done: 1 imported, 0 skipped\n",
      "normalize": [
        "crlf"
      ]
    },
    "stderr": {
      "mode": "contains",
      "value": "acq: [dry-run] would import 'usai' from $USAI_API_KEY (",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": [
      "HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_STATE_HOME",
      "XDG_CACHE_HOME",
      "ACQ_SECRET_STORE_DIR"
    ]
  }
}
