{
  "schema": 1,
  "id": "cli/secret-ls-entry-bad-shape",
  "oracle": "ADR-0040m error vocabulary secret_unreadable: a wrong-shape *entry* in the secret listing fails closed (never silently dropped)",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": ["{acq}", "--backend", "msb", "secret", "ls", "--json"],
    "env": {
      "ACQ_MSB_BIN": "__stub__",
      "ACQ_MSB_VERSION": "0.7.7",
      "ACQ_MSB_INSTALLED": "1",
      "ACQ_SBX_INSTALLED": "0",
      "ACQ_MSB_STUB_SECRET_LS_RAW": "[{\"scope\":\"global\",\"service\":\"usai\",\"value_state\":\"set\"}, 123]"
