{
  "schema": 1,
  "id": "cli/backend-check-bin-override-blocked",
  "oracle": "ADR-0040m version floor fail-closed: an ACQ_MSB_BIN override is version-checked like the PATH binary, so a blocked msb 0.7.1 named by the override is refused with backend_version_unsupported before any mutating backend call",
  "tier": 1,
  "backend": null,
  "platform": "linux",
  "invoke": {
    "argv": [
      "{acq}",
      "--backend",
      "msb",
      "create",
      "opencode",
      ".",
      "--name",
      "floor-test",
      "--json"
    ],
    "env": {
      "ACQ_MSB_BIN": "python3 -c \"import sys; a = sys.argv[1:]; sys.exit(print('msb 0.7.1') if a == ['--version'] else 'fake msb 0.7.1: refused to run ' + ' '.join(a))\"",
      "ACQ_SBX_INSTALLED": "0"
    },
    "unset": [
      "ACQ_BACKEND",
      "ACQ_STATE_DIR",
      "ACQ_MSB_INSTALLED",
      "ACQ_MSB_VERSION",
      "ACQ_SBX_BIN",
      "ACQ_SBX_VERSION",
      "MSB_HOME",
      "ACQ_IMAGE",
      "ACQ_MSB_IMAGE"
    ],
    "stdin": "",
    "timeout_ms": 10000
  },
  "expect": {
    "exit": 1,
    "stdout": {
      "mode": "json",
      "value": {
        "schema_version": 1,
        "command": "create",
        "error": {
          "code": "backend_version_unsupported"
        }
      },
      "normalize": []
    },
    "stderr": {
      "mode": "exact",
      "value": "",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": [
      "HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_STATE_HOME",
      "XDG_CACHE_HOME"
    ]
  }
}
