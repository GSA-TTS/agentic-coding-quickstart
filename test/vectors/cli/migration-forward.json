{
  "schema": 1,
  "id": "cli/migration-forward",
  "oracle": "ADR-0041m forward migration: a legacy v0 record migrates forward in place and the mutating verb then reads it (run re-attach succeeds with the migrated agent)",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": ["{acq}", "--backend", "msb", "run", "legacy", "--json"],
    "env": {
      "ACQ_MSB_BIN": "__stub__",
      "ACQ_MSB_VERSION": "0.7.7",
      "ACQ_MSB_INSTALLED": "1",
      "ACQ_SBX_INSTALLED": "0",
      "ACQ_MSB_STUB_CATALOG": "{\"legacy\":\"running\"}",
      "ACQ_STATE_SEED": "{\"msb/legacy\":{\"name\":\"legacy\",\"backend\":\"msb\",\"agent\":\"opencode\",\"workspace\":\"/w\"}}"
    },
    "unset": ["ACQ_BACKEND", "ACQ_STATE_DIR", "MSB_HOME", "ACQ_IMAGE", "ACQ_MSB_IMAGE", "ACQ_MSB_READY_TIMEOUT", "ACQ_MSB_STUB_FAIL", "ACQ_MSB_STUB_EXEC_EXIT", "ACQ_MSB_STUB_COPY_EXIT", "ACQ_MSB_STUB_EXIT_CODE", "ACQ_MSB_STUB_PORTS", "ACQ_SECURITY_MOUNT_STATE", "ACQ_MIGRATION_LOCK_TIMEOUT"],
    "stdin": "",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "json",
      "value": {
        "schema_version": 1,
        "command": "run",
        "data": {"name": "legacy", "backend": "msb", "agent": "opencode", "state": "running", "action": "reattached"}
      },
      "normalize": []
    },
    "stderr": {"mode": "contains", "value": "[stub exec]", "normalize": []}
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": ["HOME", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_CACHE_HOME"]
  }
}
