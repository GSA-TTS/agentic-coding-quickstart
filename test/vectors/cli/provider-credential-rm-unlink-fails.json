{
  "schema": 1,
  "id": "cli/provider-credential-rm-unlink-fails",
  "oracle": "ADR-0038m fail-closed provider-credential rm: when the binding record cannot be deleted, rm exits 1 (failure) instead of reporting removed true while the binding is still listed. Not runnable as a superuser, which can delete regardless of permissions",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{python}",
      "-I",
      "test/vectors/drivers/seeded-run.py",
      "[[[\"--backend\",\"msb\",\"provider-credential\",\"set\",\"usai\",\"USAI_API_KEY\",\"--host\",\"api.gsa.usai.gov\"],true,0],{\"lock_bindings\":true},[[\"--backend\",\"msb\",\"provider-credential\",\"rm\",\"usai\",\"--json\"],false,null]]",
      "{acq}"
    ],
    "env": {
      "ACQ_MSB_BIN": "__stub__",
      "ACQ_MSB_VERSION": "0.7.7",
      "ACQ_MSB_INSTALLED": "1",
      "ACQ_SBX_INSTALLED": "0"
    },
    "unset": [
      "ACQ_BACKEND",
      "ACQ_STATE_DIR",
      "ACQ_SECRET_NO_LIVE_REFEED",
      "ACQ_PROVIDER_CREDENTIAL_BINDINGS",
      "ACQ_PROVIDER_CREDENTIAL_SEED",
      "USAI_API_KEY",
      "GITHUB_TOKEN",
      "GH_TOKEN",
      "GITLAB_TOKEN",
      "GIT_DIR",
      "GIT_WORK_TREE",
      "GIT_CEILING_DIRECTORIES",
      "MSB_HOME",
      "ACQ_IMAGE",
      "ACQ_MSB_IMAGE",
      "ACQ_MSB_READY_TIMEOUT",
      "ACQ_MSB_STUB_CATALOG",
      "ACQ_MSB_STUB_FAIL",
      "ACQ_MSB_STUB_FAIL_ADD",
      "ACQ_MSB_STUB_FAIL_RM",
      "ACQ_MSB_STUB_SECRETS",
      "ACQ_MSB_STUB_SECRET_LS_RAW",
      "ACQ_MSB_STUB_ROTATE"
    ],
    "stdin": "vector-provider-sentinel-3e9a\n",
    "timeout_ms": 15000
  },
  "expect": {
    "exit": 1,
    "stdout": {
      "mode": "json",
      "value": {
        "schema_version": 1,
        "command": "provider-credential rm",
        "error": {
          "code": "failure"
        }
      },
      "normalize": []
    },
    "stderr": {
      "mode": "exact",
      "value": "",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": [
      "HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
