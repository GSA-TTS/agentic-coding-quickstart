{
  "schema": 1,
  "id": "cli/version-human",
  "oracle": "ADR-0038m §2 human output by default on stdout",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": ["{acq}", "version"],
    "env": {
      "ACQ_VERSION": "0.1.0",
      "ACQ_SOURCE_REVISION": "0000000000000000000000000000000000000000",
      "ACQ_SBX_INSTALLED": "0",
      "ACQ_MSB_INSTALLED": "0"
    },
    "unset": ["ACQ_BACKEND", "ACQ_SBX_BIN", "ACQ_MSB_BIN", "ACQ_SBX_VERSION", "ACQ_MSB_VERSION"],
    "stdin": "",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "contains",
      "value": "acq version:",
      "normalize": []
    },
    "stderr": {
      "mode": "exact",
      "value": "",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": ["HOME", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_CACHE_HOME"]
  }
}
