{
  "schema": 1,
  "id": "cli/cp-unc-host-sbx",
  "oracle": "ADR-0029 UNC host path: sbx cp forwards a UNC/network host path verbatim to the backend (resolved natively), accepted like a plain-drive path",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": ["{acq}", "--backend", "sbx", "--json", "cp", "//server/share/file.txt", "box:/tmp/dest.txt"],
    "env": {
      "ACQ_SBX_BIN": "__stub__",
      "ACQ_SBX_VERSION": "0.39.0",
      "ACQ_SBX_INSTALLED": "1",
      "ACQ_MSB_INSTALLED": "0",
      "ACQ_SBX_STUB_CATALOG": "{\"box\":\"running\"}"
    },
    "unset": ["ACQ_BACKEND", "ACQ_STATE_DIR", "MSB_HOME", "SBX_HOME", "ACQ_IMAGE", "ACQ_MSB_IMAGE", "ACQ_SBX_READY_TIMEOUT", "ACQ_SBX_STUB_FAIL", "ACQ_SBX_STUB_EXEC_EXIT", "ACQ_SBX_STUB_COPY_EXIT", "ACQ_SBX_STUB_EXIT_CODE", "ACQ_SBX_STUB_SECRETS", "ACQ_SBX_STUB_SECRET_LS_RAW", "ACQ_SBX_STUB_RAW_PLACEHOLDERS", "ACQ_SBX_STUB_ALLOWED_SOURCES", "ACQ_SBX_STUB_ROTATE", "ACQ_MSB_STUB_CATALOG", "ACQ_MSB_STUB_FAIL", "ACQ_MSB_STUB_SECRETS", "ACQ_MSB_STUB_SECRET_LS_RAW", "ACQ_MSB_STUB_ROTATE"],
    "stdin": "",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "json",
      "value": {
        "schema_version": 1,
        "command": "cp",
        "data": {"name": "box", "host": "//server/share/file.txt", "guest": "/tmp/dest.txt", "direction": "in", "exit_code": 0}
      },
      "normalize": []
    },
    "stderr": {"mode": "exact", "value": "", "normalize": []}
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": ["HOME", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_CACHE_HOME"]
  }
}
