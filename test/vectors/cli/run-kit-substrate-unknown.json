{
  "schema": 1,
  "id": "cli/run-kit-substrate-unknown",
  "oracle": "ADR-0030 bring-your-own image contract: a kit on an overridden image whose substrate state is unverified fails closed with validation_failed (no half-provisioned sandbox)",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": ["{acq}", "--backend", "msb", "run", "opencode", ".", "--name", "oc-box", "--image", "docker.io/docker/sandbox-templates:shell-docker", "--json"],
    "env": {
      "ACQ_MSB_BIN": "__stub__",
      "ACQ_MSB_VERSION": "0.7.7",
      "ACQ_MSB_INSTALLED": "1",
      "ACQ_SBX_INSTALLED": "0"
    },
    "unset": ["ACQ_BACKEND", "ACQ_STATE_DIR", "MSB_HOME", "ACQ_IMAGE", "ACQ_MSB_IMAGE", "ACQ_MSB_STUB_CATALOG", "ACQ_MSB_READY_TIMEOUT", "ACQ_MSB_STUB_FAIL", "ACQ_KIT_APPLIED_SEED", "ACQ_SUBSTRATE_STATE"],
    "stdin": "",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 1,
    "stdout": {
      "mode": "json",
      "value": {
        "schema_version": 1,
        "command": "run",
        "error": {"code": "validation_failed"}
      },
      "normalize": []
    },
    "stderr": {"mode": "exact", "value": "", "normalize": []}
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": ["HOME", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_CACHE_HOME"]
  }
}
