{
  "schema": 1,
  "id": "cli/ls-list-timeout-msb",
  "oracle": "A backend listing that does not answer within ACQ_LIST_TIMEOUT seconds makes ls fail closed with the stable timeout code and a message naming the listing and the knob, instead of waiting forever (the 1 ms budget is shorter than any start of the msb stub, so the listing always outlasts it)",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": ["{acq}", "--backend", "msb", "ls", "--json"],
    "env": {
      "ACQ_MSB_BIN": "__stub__",
      "ACQ_MSB_VERSION": "0.7.7",
      "ACQ_MSB_INSTALLED": "1",
      "ACQ_SBX_INSTALLED": "0",
      "ACQ_MSB_STUB_CATALOG": "{\"alpha\":\"running\"}",
      "ACQ_LIST_TIMEOUT": "0.001"
    },
    "unset": ["ACQ_BACKEND", "ACQ_STATE_DIR", "MSB_HOME", "ACQ_IMAGE", "ACQ_MSB_IMAGE", "ACQ_MSB_READY_TIMEOUT", "ACQ_MSB_STUB_FAIL"],
    "stdin": "",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 1,
    "stdout": {
      "mode": "json",
      "value": {
        "schema_version": 1,
        "command": "ls",
        "error": {
          "code": "timeout",
          "message": "'msb list' did not answer within 0.001s",
          "remediation": "check that msb responds ('msb list'); set ACQ_LIST_TIMEOUT to a larger number of seconds if it is only slow, then retry"
        }
      },
      "normalize": []
    },
    "stderr": {"mode": "exact", "value": "", "normalize": []}
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": ["HOME", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_CACHE_HOME"]
  }
}
