{
  "schema": 1,
  "id": "cli/backend-list-autodetect-keeps-sbx",
  "oracle": "ADR-0038m §2 backend list active_backend auto-detect: with both backends installed and an existing sbx sandbox, auto-detect keeps sbx (Bash _auto_detect_backend both-sbx), so the user's sbx sandboxes stay reachable",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": ["{acq}", "backend", "list", "--json"],
    "env": {
      "ACQ_SBX_BIN": "__stub__",
      "ACQ_SBX_VERSION": "0.50.1",
      "ACQ_SBX_STUB_CATALOG": "{\"old-box\":\"running\"}",
      "ACQ_MSB_BIN": "__stub__",
      "ACQ_MSB_VERSION": "0.7.7"
    },
    "unset": ["ACQ_SBX_INSTALLED", "ACQ_MSB_INSTALLED", "ACQ_BACKEND", "ACQ_SBX_STUB_FAIL"],
    "stdin": "",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "json",
      "value": {
        "schema_version": 1,
        "command": "backend list",
        "data": {
          "active_backend": "sbx",
          "backends": [
            {"name": "sbx", "installed": true, "version": "0.50.1"},
            {"name": "msb", "installed": true, "version": "0.7.7"}
          ]
        }
      },
      "normalize": []
    },
    "stderr": {"mode": "exact", "value": "", "normalize": []}
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": ["HOME", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_CACHE_HOME"]
  }
}
