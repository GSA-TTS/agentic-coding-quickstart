{
  "schema": 1,
  "id": "cli/version-json-backend",
  "oracle": "ADR-0038m §2 version required data fields: the active backend (resolved like every other verb, here by auto-detect with only msb installed), its detected version, and the pinned control-plane commit, never placeholders",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": ["{acq}", "version", "--json"],
    "env": {
      "ACQ_VERSION": "0.1.0",
      "ACQ_SOURCE_REVISION": "0000000000000000000000000000000000000000",
      "ACQ_MSB_BIN": "__stub__",
      "ACQ_MSB_VERSION": "msb 0.7.11",
      "ACQ_MSB_INSTALLED": "1",
      "ACQ_SBX_INSTALLED": "0"
    },
    "unset": ["ACQ_BACKEND", "ACQ_SBX_BIN", "ACQ_SBX_VERSION"],
    "stdin": "",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "json",
      "value": {
        "schema_version": 1,
        "command": "version",
        "data": {
          "impl": "python",
          "acq_version": "0.1.0",
          "source_revision": "0000000000000000000000000000000000000000",
          "backend": "msb",
          "backend_version": "0.7.11",
          "kit_control_plane_ref": "941a286f912b99475429c3c00db49a99af5b241e"
        }
      },
      "normalize": []
    },
    "stderr": {"mode": "exact", "value": "", "normalize": []}
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": ["HOME", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_CACHE_HOME"]
  }
}
