{
  "schema": 1,
  "id": "cli/secret-ls-msb",
  "oracle": "msb secret-list from the acq store: each entry reports scope/service/value_state and the ENV@HOST binding msb would use (the usai trust anchor, and a --host/--env custom endpoint), never a value; a service msb cannot bind is refused before it is stored",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{python}",
      "-I",
      "test/vectors/drivers/seeded-run.py",
      "[[[\"--backend\",\"msb\",\"secret\",\"set\",\"-g\",\"usai\"],true,0],[[\"--backend\",\"msb\",\"secret\",\"set\",\"box\",\"gitlab\",\"--host\",\"workshop.cloud.gov\",\"--env\",\"GITLAB_TOKEN\"],true,0],[[\"--backend\",\"msb\",\"secret\",\"set\",\"-g\",\"orphan\"],true,1],[[\"--backend\",\"msb\",\"secret\",\"ls\",\"--json\"],false,null]]",
      "{acq}"
    ],
    "env": {
      "ACQ_MSB_BIN": "__stub__",
      "ACQ_MSB_VERSION": "0.7.7",
      "ACQ_MSB_INSTALLED": "1",
      "ACQ_SBX_INSTALLED": "0"
    },
    "unset": [
      "ACQ_BACKEND",
      "ACQ_STATE_DIR",
      "MSB_HOME",
      "ACQ_IMAGE",
      "ACQ_MSB_IMAGE",
      "ACQ_MSB_READY_TIMEOUT",
      "ACQ_MSB_STUB_CATALOG",
      "ACQ_MSB_STUB_FAIL",
      "ACQ_SECRET_NO_LIVE_REFEED",
      "ACQ_PROVIDER_CREDENTIAL_BINDINGS",
      "ACQ_PROVIDER_CREDENTIAL_SEED",
      "USAI_API_KEY",
      "GITHUB_TOKEN",
      "GH_TOKEN",
      "GITLAB_TOKEN"
    ],
    "stdin": "vector-msb-sentinel-7c41",
    "timeout_ms": 10000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "exact",
      "value": "{\"command\":\"secret ls\",\"data\":{\"secrets\":[{\"binding\":\"GITLAB_TOKEN@workshop.cloud.gov\",\"scope\":\"box\",\"scope_kind\":\"sandbox\",\"service\":\"gitlab\",\"value_state\":\"set\"},{\"binding\":\"USAI_API_KEY@api.gsa.usai.gov\",\"scope\":\"global\",\"scope_kind\":\"global\",\"service\":\"usai\",\"value_state\":\"set\"}]},\"schema_version\":1}",
      "normalize": [
        "json"
      ]
    },
    "stderr": {
      "mode": "exact",
      "value": "",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": [
      "HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_STATE_HOME",
      "XDG_CACHE_HOME",
      "ACQ_SECRET_STORE_DIR"
    ]
  }
}
