{
  "schema": 1,
  "id": "cli/name-create-invalid",
  "oracle": "Bash parity (acq_sandbox_name_check): an explicit --name outside [A-Za-z0-9_-] fails closed (validation_failed) before any backend call",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": ["{acq}", "--backend", "msb", "create", "opencode", ".", "--name", "bad.name", "--json"],
    "env": {
      "ACQ_MSB_BIN": "__stub__",
      "ACQ_MSB_VERSION": "0.7.7",
      "ACQ_MSB_INSTALLED": "1",
      "ACQ_SBX_INSTALLED": "0"
    },
    "unset": ["ACQ_BACKEND", "ACQ_STATE_DIR", "MSB_HOME", "ACQ_IMAGE", "ACQ_MSB_IMAGE", "ACQ_MSB_STUB_CATALOG", "ACQ_MSB_READY_TIMEOUT", "ACQ_MSB_STUB_FAIL"],
    "stdin": "",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 1,
    "stdout": {
      "mode": "json",
      "value": {
        "schema_version": 1,
        "command": "create",
        "error": {
          "code": "validation_failed",
          "message": "invalid sandbox name 'bad.name'."
        }
      },
      "normalize": []
    },
    "stderr": {
      "mode": "exact",
      "value": "",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": ["HOME", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_CACHE_HOME", "ACQ_SECRET_STORE_DIR"]
  }
}
