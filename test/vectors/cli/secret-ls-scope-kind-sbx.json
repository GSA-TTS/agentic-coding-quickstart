{
  "schema": 1,
  "id": "cli/secret-ls-scope-kind-sbx",
  "oracle": "JSON scope_kind on sbx secret ls: sbx labels the global scope and a sandbox named 'global' both 'global', so once sbx has a sandbox named 'global' that label reports scope_kind unknown; other sandboxes report sandbox",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{acq}",
      "--backend",
      "sbx",
      "secret",
      "ls",
      "--json"
    ],
    "env": {
      "ACQ_SBX_BIN": "__stub__",
      "ACQ_SBX_VERSION": "0.51.0",
      "ACQ_SBX_INSTALLED": "1",
      "ACQ_MSB_INSTALLED": "0",
      "ACQ_SBX_STUB_CATALOG": "{\"global\":\"running\"}",
      "ACQ_SBX_STUB_SECRETS": "{\"global\":{\"github\":\"set\"},\"mybox\":{\"github\":\"set\"}}"
    },
    "unset": [
      "ACQ_BACKEND",
      "ACQ_STATE_DIR",
      "SBX_HOME",
      "ACQ_IMAGE",
      "ACQ_MSB_IMAGE",
      "ACQ_MSB_READY_TIMEOUT",
      "ACQ_SBX_STUB_FAIL",
      "ACQ_SBX_STUB_CUSTOM_SECRETS",
      "ACQ_SBX_STUB_RAW_PLACEHOLDERS",
      "ACQ_SBX_STUB_SECRET_LS_RAW",
      "ACQ_PROVIDER_CREDENTIAL_BINDINGS",
      "ACQ_PROVIDER_CREDENTIAL_SEED"
    ],
    "stdin": "",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "exact",
      "value": "{\"command\":\"secret ls\",\"data\":{\"secrets\":[{\"scope\":\"global\",\"scope_kind\":\"unknown\",\"service\":\"github\",\"value_state\":\"set\"},{\"scope\":\"mybox\",\"scope_kind\":\"sandbox\",\"service\":\"github\",\"value_state\":\"set\"}]},\"schema_version\":1}",
      "normalize": [
        "json"
      ]
    },
    "stderr": {
      "mode": "exact",
      "value": "",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": [
      "HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_STATE_HOME",
      "XDG_CACHE_HOME",
      "ACQ_SECRET_STORE_DIR"
    ]
  }
}
