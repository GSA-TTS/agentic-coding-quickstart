{
  "schema": 1,
  "id": "cli/usai-rotate-sbx",
  "oracle": "ADR-0012 / ADR-0008 key-rotate on sbx: rotation stores the new key and re-sets every custom secret that carries it with `secret set-custom --placeholder P --value-stdin`, keeping each placeholder (the global entry and the sandbox-scoped one, reported as refed); the value goes only on stdin (the stub refuses an argv --value) and the driver fails the vector if it appears in any output",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{python}",
      "-I",
      "test/vectors/drivers/seeded-run.py",
      "[[[\"--backend\",\"sbx\",\"usai-rotate-api-key\",\"--json\"],true,null]]",
      "{acq}"
    ],
    "env": {
      "ACQ_SBX_BIN": "__stub__",
      "ACQ_SBX_VERSION": "0.51.0",
      "ACQ_SBX_INSTALLED": "1",
      "ACQ_MSB_INSTALLED": "0",
      "ACQ_SBX_STUB_CUSTOM_SECRETS": "[{\"scope\":\"global\",\"env\":\"USAI_API_KEY\",\"placeholder\":\"sbx-cs-global-1\",\"targets\":[\"api.gsa.usai.gov\"]},{\"scope\":\"rot-a\",\"env\":\"USAI_API_KEY\",\"placeholder\":\"sbx-cs-rot-a-1\",\"targets\":[\"api.gsa.usai.gov\"]}]"
    },
    "unset": [
      "ACQ_BACKEND",
      "ACQ_STATE_DIR",
      "MSB_HOME",
      "SBX_HOME",
      "ACQ_IMAGE",
      "ACQ_MSB_IMAGE",
      "ACQ_MSB_READY_TIMEOUT",
      "ACQ_MSB_STUB_CATALOG",
      "ACQ_MSB_STUB_FAIL",
      "ACQ_MSB_STUB_FAIL_ADD",
      "ACQ_MSB_STUB_FAIL_RM",
      "ACQ_SBX_STUB_CATALOG",
      "ACQ_SBX_STUB_FAIL",
      "ACQ_SBX_STUB_SECRETS",
      "ACQ_SBX_STUB_FAIL_CUSTOM_SCOPES",
      "ACQ_SECRET_NO_LIVE_REFEED",
      "ACQ_PROVIDER_CREDENTIAL_BINDINGS",
      "ACQ_PROVIDER_CREDENTIAL_SEED",
      "USAI_API_KEY",
      "GITHUB_TOKEN",
      "GH_TOKEN",
      "GITLAB_TOKEN"
    ],
    "stdin": "vector-rotate-sentinel-5e19",
    "timeout_ms": 15000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "json",
      "value": {
        "schema_version": 1,
        "command": "usai-rotate-api-key",
        "data": {
          "provider": "usai",
          "key_env": "USAI_API_KEY",
          "rotated": true,
          "backends": [
            {
              "backend": "sbx",
              "refed": [
                "rot-a"
              ],
              "kept_own": []
            }
          ]
        }
      },
      "normalize": []
    },
    "stderr": {
      "mode": "exact",
      "value": "",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": [
      "HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_STATE_HOME",
      "XDG_CACHE_HOME",
      "ACQ_SECRET_STORE_DIR"
    ]
  }
}
