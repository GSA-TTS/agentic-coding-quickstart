{
  "schema": 1,
  "id": "cli/provider-credential-ls-json",
  "oracle": "ADR-0038m §2 provider-credential ls required data: provider/key_env/hosts/source_layer, non-secret bindings only — never a value field",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": ["{acq}", "provider-credential", "ls", "--json"],
    "env": {
      "ACQ_PROVIDER_CREDENTIAL_SEED": "[{\"provider\":\"usai\",\"key_env\":\"USAI_API_KEY\",\"hosts\":[\"api.gsa.usai.gov\"]}]"
    },
    "unset": ["ACQ_STATE_DIR", "ACQ_PROVIDER_CREDENTIAL_BINDINGS", "ACQ_MSB_BIN", "ACQ_MSB_INSTALLED", "ACQ_SBX_INSTALLED"],
    "stdin": "",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "exact",
      "value": "{\"command\":\"provider-credential ls\",\"data\":{\"bindings\":[{\"hosts\":[\"api.gsa.usai.gov\"],\"key_env\":\"USAI_API_KEY\",\"provider\":\"usai\",\"source_layer\":\"provider-credentials\"}]},\"schema_version\":1}",
      "normalize": ["json"]
    },
    "stderr": {"mode": "exact", "value": "", "normalize": []}
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": ["HOME", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_CACHE_HOME"]
  }
}
