{
  "schema": 1,
  "id": "cli/start-keeps-no-provider-kits",
  "oracle": "Bash acq_provider_selection_load: a sandbox keeps the provider selection it was created with. Created with --no-provider-kits while a usai key is stored, it is bound with nothing; a later start without the flag (where the default provider kit would be selected) neither binds the usai key nor applies the provider kit",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{python}",
      "-I",
      "test/vectors/drivers/seeded-run.py",
      "[{\"git_repos\":{}},[[\"--backend\",\"msb\",\"secret\",\"set\",\"-g\",\"usai\"],true,0],[[\"--backend\",\"msb\",\"create\",\"shell\",\"{workspace}\",\"--name\",\"np-start\",\"--no-provider-kits\",\"--json\"],false,0],[[\"--backend\",\"msb\",\"stop\",\"np-start\"],false,0],[[\"--backend\",\"msb\",\"start\",\"np-start\",\"--json\"],false,null]]",
      "{acq}"
    ],
    "env": {
      "ACQ_MSB_BIN": "__stub__",
      "ACQ_MSB_VERSION": "0.7.7",
      "ACQ_MSB_INSTALLED": "1",
      "ACQ_SBX_INSTALLED": "0"
    },
    "unset": [
      "ACQ_BACKEND",
      "ACQ_STATE_DIR",
      "MSB_HOME",
      "ACQ_IMAGE",
      "ACQ_MSB_IMAGE",
      "ACQ_MSB_READY_TIMEOUT",
      "ACQ_MSB_STUB_CATALOG",
      "ACQ_MSB_STUB_FAIL",
      "ACQ_SECRET_NO_LIVE_REFEED",
      "ACQ_PROVIDER_CREDENTIAL_BINDINGS",
      "ACQ_PROVIDER_CREDENTIAL_SEED",
      "ACQ_CONFIG_SEED",
      "ACQ_EXTRA_KITS",
      "ACQ_PROVIDER_KITS",
      "USAI_API_KEY",
      "GITHUB_TOKEN",
      "GH_TOKEN",
      "GITLAB_TOKEN"
    ],
    "stdin": "vector-np-start-sentinel-91c2",
    "timeout_ms": 20000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "json",
      "value": {
        "schema_version": 1,
        "command": "start",
        "data": {
          "name": "np-start",
          "backend": "msb",
          "state": "running",
          "was_running": false,
          "secret_bindings": [],
          "kits": [
            "zscaler-ca-certificate",
            "agentic-coding-playbook",
            "git-ssh-sign"
          ]
        }
      },
      "normalize": []
    },
    "stderr": {
      "mode": "exact",
      "value": "",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": [
      "HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_STATE_HOME",
      "XDG_CACHE_HOME",
      "ACQ_SECRET_STORE_DIR"
    ]
  }
}
