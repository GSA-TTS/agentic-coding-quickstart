{
  "schema": 1,
  "id": "cli/passthrough-backend-missing",
  "oracle": "ADR-0038m §1 passthrough: a forwarded verb whose backend CLI cannot be run fails with backend_not_found (exit 1, envelope under --json) and no forwarding notice",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{acq}",
      "--backend",
      "msb",
      "--json",
      "image",
      "list"
    ],
    "env": {
      "ACQ_MSB_BIN": "/nonexistent/acq-vector/msb",
      "ACQ_MSB_VERSION": "0.7.11",
      "ACQ_MSB_INSTALLED": "1",
      "ACQ_SBX_INSTALLED": "0"
    },
    "unset": [
      "ACQ_BACKEND",
      "ACQ_STATE_DIR",
      "MSB_HOME",
      "ACQ_IMAGE",
      "ACQ_MSB_IMAGE",
      "ACQ_MSB_STUB_CATALOG",
      "ACQ_MSB_READY_TIMEOUT",
      "ACQ_MSB_STUB_FAIL",
      "ACQ_MSB_STUB_EXEC_EXIT",
      "ACQ_MSB_STUB_COPY_EXIT",
      "ACQ_MSB_STUB_EXIT_CODE",
      "ACQ_MSB_STUB_PORTS"
    ],
    "stdin": "",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 1,
    "stdout": {
      "mode": "json",
      "value": {
        "schema_version": 1,
        "command": "image",
        "error": {
          "code": "backend_not_found"
        }
      },
      "normalize": []
    },
    "stderr": {
      "mode": "exact",
      "value": "",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": [
      "HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_STATE_HOME",
      "XDG_CACHE_HOME"
    ]
  }
}
