{
  "schema": 1,
  "id": "cli/passthrough-sbx-bin-seam",
  "oracle": "ADR-0038m §1 passthrough on sbx forwards to the same binary the sbx adapter runs (the ACQ_SBX_BIN seam), with the notice and the backend's status",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{acq}",
      "--backend",
      "sbx",
      "echo",
      "hello",
      "sbx"
    ],
    "env": {
      "ACQ_SBX_BIN": "__stub__",
      "ACQ_SBX_VERSION": "0.51.0",
      "ACQ_SBX_INSTALLED": "1",
      "ACQ_MSB_INSTALLED": "0"
    },
    "unset": [
      "ACQ_BACKEND",
      "ACQ_STATE_DIR",
      "ACQ_SBX_READY_TIMEOUT",
      "ACQ_SBX_STUB_EXIT_CODE",
      "ACQ_SBX_STUB_CATALOG",
      "ACQ_SBX_STUB_FAIL"
    ],
    "stdin": "",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "contains",
      "value": "hello sbx",
      "normalize": []
    },
    "stderr": {
      "mode": "contains",
      "value": "forwarding to 'sbx'",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": [
      "HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_STATE_HOME",
      "XDG_CACHE_HOME"
    ]
  }
}
