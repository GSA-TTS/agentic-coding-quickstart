{
  "schema": 1,
  "id": "cli/secret-has-usage",
  "oracle": "ADR-0038m §secret has: silent predicate, exit 2 on a usage error (no service), still no stdout body",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": ["{acq}", "--backend", "msb", "secret", "has"],
    "env": {
      "ACQ_MSB_BIN": "__stub__",
      "ACQ_MSB_VERSION": "0.7.7",
      "ACQ_MSB_INSTALLED": "1",
      "ACQ_SBX_INSTALLED": "0"
    },
    "unset": ["ACQ_BACKEND", "ACQ_STATE_DIR", "MSB_HOME", "ACQ_IMAGE", "ACQ_MSB_IMAGE", "ACQ_MSB_READY_TIMEOUT", "ACQ_MSB_STUB_CATALOG", "ACQ_MSB_STUB_FAIL", "ACQ_MSB_STUB_SECRETS", "ACQ_MSB_STUB_SECRET_LS_RAW"],
    "stdin": "",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 2,
    "stdout": {"mode": "exact", "value": "", "normalize": []},
    "stderr": {"mode": "contains", "value": "usage: acq secret has", "normalize": []}
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": ["HOME", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_CACHE_HOME"]
  }
}
