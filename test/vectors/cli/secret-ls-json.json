{
  "schema": 1,
  "id": "cli/secret-ls-json",
  "oracle": "ADR-0038m §2 secret ls required data: scope/service/value_state, non-secret bindings only — never a value field",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": ["{acq}", "--backend", "msb", "secret", "ls", "--json"],
    "env": {
      "ACQ_MSB_BIN": "__stub__",
      "ACQ_MSB_VERSION": "0.7.7",
      "ACQ_MSB_INSTALLED": "1",
      "ACQ_SBX_INSTALLED": "0",
      "ACQ_MSB_STUB_SECRETS": "{\"global\":{\"usai\":\"set\"},\"mybox\":{\"github\":\"set\"}}"
    },
    "unset": ["ACQ_BACKEND", "ACQ_STATE_DIR", "MSB_HOME", "ACQ_IMAGE", "ACQ_MSB_IMAGE", "ACQ_MSB_READY_TIMEOUT", "ACQ_MSB_STUB_CATALOG", "ACQ_MSB_STUB_FAIL", "ACQ_MSB_STUB_SECRET_LS_RAW"],
    "stdin": "",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "exact",
      "value": "{\"command\":\"secret ls\",\"data\":{\"secrets\":[{\"scope\":\"global\",\"service\":\"usai\",\"value_state\":\"set\"},{\"scope\":\"mybox\",\"service\":\"github\",\"value_state\":\"set\"}]},\"schema_version\":1}",
      "normalize": ["json"]
    },
    "stderr": {"mode": "exact", "value": "", "normalize": []}
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": ["HOME", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_CACHE_HOME"]
  }
}
