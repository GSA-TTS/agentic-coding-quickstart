{
  "schema": 1,
  "id": "cli/backend-set-unknown",
  "oracle": "ADR-0038m drop invalid persisted backends: `backend set` refuses a name that is not sbx or msb (usage, exit 2) before writing",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{acq}",
      "backend",
      "set",
      "podman",
      "--json"
    ],
    "env": {},
    "unset": [
      "ACQ_BACKEND",
      "ACQ_STATE_DIR",
      "ACQ_CONFIG_SEED",
      "ACQ_MIGRATION_LOCK_TIMEOUT"
    ],
    "stdin": "",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 2,
    "stdout": {
      "mode": "json",
      "value": {
        "schema_version": 1,
        "command": "backend set",
        "error": {
          "code": "usage"
        }
      },
      "normalize": []
    },
    "stderr": {
      "mode": "exact",
      "value": "",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": [
      "HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_STATE_HOME",
      "XDG_CACHE_HOME"
    ]
  }
}
