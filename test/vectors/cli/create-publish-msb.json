{
  "schema": 1,
  "id": "cli/create-publish-msb",
  "oracle": "ADR-0034 --publish HOST:GUEST on an msb create becomes a create-time -p mapping: ports then reports it as declared, origin create",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{python}",
      "-I",
      "test/vectors/drivers/seeded-run.py",
      "[{\"git_repos\":{}},[[\"--backend\",\"msb\",\"secret\",\"set\",\"-g\",\"usai\"],true,0],[[\"--backend\",\"msb\",\"create\",\"shell\",\"{workspace}\",\"--name\",\"pub\",\"--publish\",\"6868:6767\",\"--json\"],false,0],[[\"--backend\",\"msb\",\"ports\",\"pub\",\"--json\"],false,null]]",
      "{acq}"
    ],
    "env": {
      "ACQ_MSB_BIN": "__stub__",
      "ACQ_MSB_VERSION": "0.7.7",
      "ACQ_MSB_INSTALLED": "1",
      "ACQ_SBX_INSTALLED": "0",
      "ACQ_MSB_HOST_PROBE_STUB": "1"
    },
    "unset": [
      "ACQ_BACKEND",
      "ACQ_STATE_DIR",
      "MSB_HOME",
      "ACQ_IMAGE",
      "ACQ_MSB_IMAGE",
      "ACQ_MSB_STUB_CATALOG",
      "ACQ_MSB_READY_TIMEOUT",
      "ACQ_MSB_STUB_FAIL",
      "ACQ_MSB_STUB_PORTS",
      "ACQ_MSB_HOST_PORTS_BUSY",
      "ACQ_MSB_HOST_PROBE_UNKNOWN",
      "ACQ_MSB_FORCE_SERVE_PORT",
      "USAI_API_KEY",
      "ACQ_PROVIDER_CREDENTIAL_BINDINGS",
      "ACQ_PROVIDER_CREDENTIAL_SEED",
      "ACQ_MSB_STUB_PROBE"
    ],
    "stdin": "vector-usai-sentinel-p0b1",
    "timeout_ms": 15000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "json",
      "value": {
        "schema_version": 1,
        "command": "ports",
        "data": {
          "name": "pub",
          "ports": [
            {
              "host_port": 6868,
              "guest_port": 6767,
              "origin": "create"
            }
          ]
        }
      },
      "normalize": []
    },
    "stderr": {
      "mode": "exact",
      "value": "",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": [
      "HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_STATE_HOME",
      "XDG_CACHE_HOME",
      "ACQ_SECRET_STORE_DIR"
    ]
  }
}
