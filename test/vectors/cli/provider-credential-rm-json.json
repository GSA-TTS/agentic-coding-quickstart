{
  "schema": 1,
  "id": "cli/provider-credential-rm-json",
  "oracle": "ADR-0038m §provider-credential rm: exit 0 and removed true on removing a configured binding; credential_removed is false when no credential was stored for it",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": ["{acq}", "provider-credential", "rm", "usai", "--json"],
    "env": {
      "ACQ_PROVIDER_CREDENTIAL_SEED": "[{\"provider\":\"usai\",\"key_env\":\"USAI_API_KEY\",\"hosts\":[\"api.gsa.usai.gov\"]}]"
    },
    "unset": ["ACQ_STATE_DIR", "ACQ_PROVIDER_CREDENTIAL_BINDINGS", "ACQ_MSB_BIN", "ACQ_MSB_INSTALLED", "ACQ_SBX_INSTALLED"],
    "stdin": "",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "exact",
      "value": "{\"command\":\"provider-credential rm\",\"data\":{\"credential_removed\":false,\"provider\":\"usai\",\"removed\":true},\"schema_version\":1}",
      "normalize": ["json"]
    },
    "stderr": {"mode": "exact", "value": "", "normalize": []}
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": ["HOME", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_CACHE_HOME", "ACQ_SECRET_STORE_DIR"]
  }
}
