{
  "schema": 1,
  "id": "cli/run-opencode-applies-builtins",
  "oracle": "Built-in kits on msb: acq run opencode . applies every built-in kit (CA trust, USAi provider, playbook, git signing) and then the bundled opencode agent kit, in Bash's order, on a sandbox whose read-only host-config mount was confirmed",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{acq}",
      "--backend",
      "msb",
      "run",
      "opencode",
      ".",
      "--name",
      "oc-box",
      "--json"
    ],
    "env": {
      "ACQ_MSB_BIN": "__stub__",
      "ACQ_MSB_VERSION": "0.7.7",
      "ACQ_MSB_INSTALLED": "1",
      "ACQ_SBX_INSTALLED": "0"
    },
    "unset": [
      "ACQ_BACKEND",
      "ACQ_STATE_DIR",
      "MSB_HOME",
      "ACQ_IMAGE",
      "ACQ_MSB_IMAGE",
      "ACQ_MSB_STUB_CATALOG",
      "ACQ_MSB_READY_TIMEOUT",
      "ACQ_MSB_STUB_FAIL",
      "ACQ_MSB_STUB_EXEC_EXIT",
      "ACQ_MSB_STUB_COPY_EXIT",
      "ACQ_MSB_STUB_EXIT_CODE",
      "ACQ_MSB_STUB_PORTS",
      "ACQ_MSB_STUB_MOUNT_RW",
      "ACQ_MSB_STUB_RO_WRITABLE",
      "ACQ_SECURITY_MOUNT_STATE",
      "ACQ_KIT_APPLIED_SEED",
      "ACQ_EXTRA_KITS",
      "ACQ_PROVIDER_KITS",
      "ACQ_MIGRATION_LOCK_TIMEOUT"
    ],
    "stdin": "",
    "timeout_ms": 10000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "json",
      "value": {
        "schema_version": 1,
        "command": "run",
        "data": {
          "name": "oc-box",
          "backend": "msb",
          "agent": "opencode",
          "action": "created",
          "image": "ghcr.io/gsa-tts/agentic-coding-patterns/devenv-shell@sha256:0b5f4cc95c8fa7dd7f3ffd02b56e63d0caf9b151421ff6ea3cb34b2139e3966c",
          "kit": "opencode",
          "entrypoint": "opencode",
          "ro_host_config": true,
          "kits": [
            "zscaler-ca-certificate",
            "usai-provider",
            "agentic-coding-playbook",
            "git-ssh-sign",
            "opencode"
          ]
        }
      },
      "normalize": []
    },
    "stderr": {
      "mode": "contains",
      "value": "[stub exec]",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": [
      "HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_STATE_HOME",
      "XDG_CACHE_HOME",
      "ACQ_SECRET_STORE_DIR"
    ]
  }
}
