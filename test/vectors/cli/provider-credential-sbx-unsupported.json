{
  "schema": 1,
  "id": "cli/provider-credential-sbx-unsupported",
  "oracle": "ADR-0040m unsupported-capability fail-closed: provider-credential set is unsupported on the sbx adapter in this slice (exit 1)",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": ["{acq}", "--backend", "sbx", "provider-credential", "set", "usai", "USAI_API_KEY", "--host", "api.gsa.usai.gov", "--json"],
    "env": {
      "ACQ_MSB_BIN": "__stub__",
      "ACQ_SBX_VERSION": "0.39.0",
      "ACQ_SBX_INSTALLED": "1",
      "ACQ_MSB_INSTALLED": "0"
    },
    "unset": ["ACQ_BACKEND", "ACQ_STATE_DIR", "MSB_HOME", "ACQ_IMAGE", "ACQ_MSB_IMAGE", "ACQ_MSB_READY_TIMEOUT", "ACQ_MSB_STUB_CATALOG", "ACQ_MSB_STUB_FAIL", "ACQ_MSB_STUB_SECRETS", "ACQ_MSB_STUB_SECRET_LS_RAW", "ACQ_MSB_STUB_ROTATE", "ACQ_PROVIDER_CREDENTIAL_BINDINGS", "ACQ_PROVIDER_CREDENTIAL_SEED"],
    "stdin": "value-1\n",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 1,
    "stdout": {
      "mode": "json",
      "value": {
        "schema_version": 1,
        "command": "provider-credential set",
        "error": {"code": "unsupported_capability"}
      },
      "normalize": []
    },
    "stderr": {"mode": "exact", "value": "", "normalize": []}
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": ["HOME", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_CACHE_HOME"]
  }
}
