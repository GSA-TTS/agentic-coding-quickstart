{
  "schema": 1,
  "id": "cli/backend-check-installed-ignored-for-missing-bin",
  "oracle": "ADR-0040m version floor fail-closed: ACQ_MSB_INSTALLED=1 is an offline test seam honoured only for the bundled __stub__; with ACQ_MSB_BIN naming a program that does not exist, the forced 'installed' is ignored and the missing CLI is refused with backend_not_found",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{acq}",
      "backend",
      "check",
      "msb",
      "--json"
    ],
    "env": {
      "ACQ_MSB_BIN": "/nonexistent/msb",
      "ACQ_MSB_INSTALLED": "1",
      "ACQ_SBX_INSTALLED": "0"
    },
    "unset": [
      "ACQ_BACKEND",
      "ACQ_STATE_DIR",
      "ACQ_MSB_VERSION",
      "ACQ_SBX_BIN",
      "ACQ_SBX_VERSION",
      "MSB_HOME",
      "ACQ_IMAGE",
      "ACQ_MSB_IMAGE"
    ],
    "stdin": "",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 1,
    "stdout": {
      "mode": "json",
      "value": {
        "schema_version": 1,
        "command": "backend check",
        "error": {
          "code": "backend_not_found"
        }
      },
      "normalize": []
    },
    "stderr": {
      "mode": "exact",
      "value": "",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": [
      "HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_STATE_HOME",
      "XDG_CACHE_HOME"
    ]
  }
}
