{
  "schema": 1,
  "id": "cli/doctor-msb-installed",
  "oracle": "Backend doctor reports installed supported versions without prompts and preserves the diagnostic JSON envelope",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{acq}",
      "--backend",
      "msb",
      "doctor",
      "--json"
    ],
    "env": {
      "ACQ_SBX_INSTALLED": "0",
      "ACQ_MSB_INSTALLED": "1",
      "ACQ_MSB_BIN": "__stub__",
      "ACQ_MSB_VERSION": "0.7.7"
    },
    "unset": [
      "ACQ_RUNTIME"
    ],
    "stdin": "",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "json",
      "value": {
        "schema_version": 1,
        "command": "doctor",
        "data": {
          "status": "warn",
          "checks": [
            {
              "id": "runtime",
              "status": "pass"
            },
            {
              "id": "backend",
              "status": "pass"
            },
            {
              "id": "backend-sbx",
              "status": "warn"
            },
            {
              "id": "backend-msb",
              "status": "pass"
            },
            {
              "id": "backend-msb-readiness",
              "status": "pass"
            },
            {
              "id": "state",
              "status": "pass"
            },
            {
              "id": "config-schema",
              "status": "pass"
            },
            {
              "id": "config-backend",
              "status": "pass"
            },
            {
              "id": "bash-import",
              "status": "pass"
            }
          ]
        }
      },
      "normalize": []
    },
    "stderr": {
      "mode": "exact",
      "value": "",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": [
      "HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_STATE_HOME",
      "XDG_CACHE_HOME"
    ]
  }
}
