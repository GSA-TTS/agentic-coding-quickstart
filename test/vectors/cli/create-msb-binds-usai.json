{
  "schema": 1,
  "id": "cli/create-msb-binds-usai",
  "oracle": "msb create binds every injectable secret as `--secret ENV@HOST` (reported as secret_bindings): the stored usai key is bound to api.gsa.usai.gov, the value reaches msb only through its environment (the stub refuses a missing variable or a value inside any argv element), and the value appears in no output",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{python}",
      "-I",
      "test/vectors/drivers/seeded-run.py",
      "[{\"git_repos\":{}},[[\"--backend\",\"msb\",\"secret\",\"set\",\"-g\",\"usai\"],true,0],[[\"--backend\",\"msb\",\"create\",\"shell\",\"{workspace}\",\"--name\",\"bind-box\",\"--json\"],false,null]]",
      "{acq}"
    ],
    "env": {
      "ACQ_MSB_BIN": "__stub__",
      "ACQ_MSB_VERSION": "0.7.7",
      "ACQ_MSB_INSTALLED": "1",
      "ACQ_SBX_INSTALLED": "0"
    },
    "unset": [
      "ACQ_BACKEND",
      "ACQ_STATE_DIR",
      "MSB_HOME",
      "ACQ_IMAGE",
      "ACQ_MSB_IMAGE",
      "ACQ_MSB_READY_TIMEOUT",
      "ACQ_MSB_STUB_CATALOG",
      "ACQ_MSB_STUB_FAIL",
      "ACQ_SECRET_NO_LIVE_REFEED",
      "ACQ_PROVIDER_CREDENTIAL_BINDINGS",
      "ACQ_PROVIDER_CREDENTIAL_SEED",
      "USAI_API_KEY",
      "GITHUB_TOKEN",
      "GH_TOKEN",
      "GITLAB_TOKEN"
    ],
    "stdin": "vector-msb-sentinel-7c41",
    "timeout_ms": 10000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "json",
      "value": {
        "schema_version": 1,
        "command": "create",
        "data": {
          "name": "bind-box",
          "backend": "msb",
          "state": "running",
          "secret_bindings": [
            "USAI_API_KEY@api.gsa.usai.gov"
          ]
        }
      },
      "normalize": []
    },
    "stderr": {
      "mode": "exact",
      "value": "",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": [
      "HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_STATE_HOME",
      "XDG_CACHE_HOME",
      "ACQ_SECRET_STORE_DIR"
    ]
  }
}
