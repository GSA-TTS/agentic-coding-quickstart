{
  "schema": 1,
  "id": "cli/run-stale-bundle-advisory",
  "oracle": "ADR-0016 run re-attaching a sandbox built from an older kit bundle notes it on stderr and, without a terminal (and always under --json), says how to refresh later and launches anyway: it never prompts or blocks",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{python}",
      "-I",
      "test/vectors/drivers/seeded-run.py",
      "[{\"git_repos\":{}},[[\"--backend\",\"msb\",\"secret\",\"set\",\"-g\",\"usai\"],true,0],[[\"--backend\",\"msb\",\"create\",\"shell\",\"{workspace}\",\"--name\",\"box\",\"--json\"],false,0],[[\"--backend\",\"msb\",\"run\",\"box\",\"--json\"],false,null]]",
      "{acq}"
    ],
    "env": {
      "ACQ_MSB_BIN": "__stub__",
      "ACQ_MSB_VERSION": "0.7.7",
      "ACQ_MSB_INSTALLED": "1",
      "ACQ_SBX_INSTALLED": "0",
      "ACQ_KIT_PROVENANCE_SEED": "{\"box\":\"0000000000000000000000000000000000000000\"}"
    },
    "unset": [
      "ACQ_BACKEND",
      "ACQ_STATE_DIR",
      "MSB_HOME",
      "ACQ_IMAGE",
      "ACQ_MSB_IMAGE",
      "ACQ_MSB_STUB_CATALOG",
      "ACQ_MSB_READY_TIMEOUT",
      "ACQ_MSB_STUB_FAIL",
      "ACQ_MSB_STUB_EXEC_EXIT",
      "ACQ_UPDATE_CHECK",
      "USAI_API_KEY",
      "ACQ_PROVIDER_CREDENTIAL_BINDINGS",
      "ACQ_PROVIDER_CREDENTIAL_SEED",
      "ACQ_MSB_STUB_PROBE"
    ],
    "stdin": "vector-usai-sentinel-u0c1",
    "timeout_ms": 20000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "json",
      "value": {
        "schema_version": 1,
        "command": "run",
        "data": {
          "name": "box",
          "action": "reattached"
        }
      },
      "normalize": []
    },
    "stderr": [
      {
        "mode": "contains",
        "value": "      To refresh later: acq kit update box",
        "normalize": []
      },
      {
        "mode": "contains",
        "value": "      To silence this check: ACQ_UPDATE_CHECK=0 (or acq run --no-update-check).",
        "normalize": []
      },
      {
        "mode": "contains",
        "value": "acq: note: 'box' was built from an older kit bundle than your pinned",
        "normalize": []
      },
      {
        "mode": "absent",
        "value": "[y/N]"
      }
    ]
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": [
      "HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_STATE_HOME",
      "XDG_CACHE_HOME",
      "ACQ_SECRET_STORE_DIR"
    ]
  }
}
