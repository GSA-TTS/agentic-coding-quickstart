{
  "schema": 1,
  "id": "cli/kit-update-yes",
  "oracle": "ADR-0038m §3 / §46 kit update --yes reapplies the kit bundle in place and only then records applied_ref, so the sandbox reports current",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": ["{acq}", "--backend", "msb", "kit", "update", "mybox", "--yes", "--json"],
    "env": {
      "ACQ_MSB_BIN": "__stub__",
      "ACQ_MSB_VERSION": "0.7.7",
      "ACQ_MSB_INSTALLED": "1",
      "ACQ_SBX_INSTALLED": "0",
      "ACQ_MSB_STUB_CATALOG": "{\"mybox\": \"running\"}"
    },
    "unset": ["ACQ_BACKEND", "ACQ_STATE_DIR", "MSB_HOME", "ACQ_IMAGE", "ACQ_MSB_IMAGE", "ACQ_MSB_STUB_FAIL", "ACQ_MSB_READY_TIMEOUT", "ACQ_KIT_PROVENANCE_SEED"],
    "stdin": "",
    "timeout_ms": 10000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "json",
      "value": {
        "schema_version": 1,
        "command": "kit update",
        "data": {
          "sandbox": "mybox",
          "backend": "msb",
          "local": "941a286f912b99475429c3c00db49a99af5b241e",
          "applied": "941a286f912b99475429c3c00db49a99af5b241e",
          "status": "current",
          "action": "refreshed",
          "kits": ["zscaler-ca-certificate", "usai-provider", "agentic-coding-playbook", "git-ssh-sign"]
        }
      },
      "normalize": []
    },
    "stderr": {"mode": "exact", "value": "", "normalize": []}
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": ["HOME", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_CACHE_HOME"]
  }
}
