{
  "schema": 1,
  "id": "cli/doctor-msb-blocked",
  "oracle": "Backend doctor preserves Bash diagnostic and refusal behavior in the Python JSON envelope",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{acq}",
      "--backend",
      "msb",
      "doctor",
      "--json"
    ],
    "env": {
      "ACQ_SBX_INSTALLED": "0",
      "ACQ_MSB_INSTALLED": "1",
      "ACQ_MSB_BIN": "__stub__",
      "ACQ_MSB_VERSION": "0.7.2"
    },
    "unset": [
      "ACQ_RUNTIME"
    ],
    "stdin": "",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "contains",
      "value": "acq refuses msb 0.7.2",
      "normalize": []
    },
    "stderr": {
      "mode": "exact",
      "value": "",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": [
      "HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_STATE_HOME",
      "XDG_CACHE_HOME"
    ]
  }
}
