{
  "schema": 1,
  "id": "cli/usai-rotate-msb-partial",
  "oracle": "ADR-0012 key-rotate on msb, partial re-feed: when `msb modify --secret` fails for one running sandbox the command exits 1 naming the sandbox that did not get the new key and the one that did, the store keeps the new key, and re-running the rotation once the failure clears exits 0; the key never appears in any step's output",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{python}",
      "-I",
      "test/vectors/drivers/seeded-run.py",
      "[[[\"--backend\",\"msb\",\"secret\",\"set\",\"-g\",\"usai\"],true,0],[[\"--backend\",\"msb\",\"create\",\"shell\",\".\",\"--name\",\"rot-a\",\"--json\"],false,0],[[\"--backend\",\"msb\",\"create\",\"shell\",\".\",\"--name\",\"rot-b\",\"--json\"],false,0],[[\"--backend\",\"msb\",\"usai-rotate-api-key\",\"--json\"],true,null],{\"env\":{\"ACQ_MSB_STUB_FAIL_ADD\":null}},[[\"--backend\",\"msb\",\"usai-rotate-api-key\",\"--json\"],true,0]]",
      "{acq}"
    ],
    "env": {
      "ACQ_MSB_BIN": "__stub__",
      "ACQ_MSB_VERSION": "0.7.7",
      "ACQ_MSB_INSTALLED": "1",
      "ACQ_SBX_INSTALLED": "0",
      "ACQ_MSB_STUB_FAIL_ADD": "rot-b"
    },
    "unset": [
      "ACQ_BACKEND",
      "ACQ_STATE_DIR",
      "MSB_HOME",
      "SBX_HOME",
      "ACQ_IMAGE",
      "ACQ_MSB_IMAGE",
      "ACQ_MSB_READY_TIMEOUT",
      "ACQ_MSB_STUB_CATALOG",
      "ACQ_MSB_STUB_FAIL",
      "ACQ_MSB_STUB_FAIL_RM",
      "ACQ_SBX_STUB_CATALOG",
      "ACQ_SBX_STUB_FAIL",
      "ACQ_SBX_STUB_SECRETS",
      "ACQ_SBX_STUB_CUSTOM_SECRETS",
      "ACQ_SBX_STUB_FAIL_CUSTOM_SCOPES",
      "ACQ_SECRET_NO_LIVE_REFEED",
      "ACQ_PROVIDER_CREDENTIAL_BINDINGS",
      "ACQ_PROVIDER_CREDENTIAL_SEED",
      "USAI_API_KEY",
      "GITHUB_TOKEN",
      "GH_TOKEN",
      "GITLAB_TOKEN"
    ],
    "stdin": "vector-rotate-sentinel-5e19",
    "timeout_ms": 15000
  },
  "expect": {
    "exit": 1,
    "stdout": {
      "mode": "json",
      "value": {
        "schema_version": 1,
        "command": "usai-rotate-api-key",
        "error": {
          "code": "failure",
          "message": "stored the new USAi key in the acq secret store, but not every sandbox received it (msb: not re-fed: rot-b (msb modify failed); re-fed: rot-a)",
          "remediation": "re-run 'acq usai-rotate-api-key' with the same key to retry them, or recreate them"
        }
      },
      "normalize": []
    },
    "stderr": {
      "mode": "exact",
      "value": "",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": [
      "HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_STATE_HOME",
      "XDG_CACHE_HOME",
      "ACQ_SECRET_STORE_DIR"
    ]
  }
}
