{
  "schema": 1,
  "id": "cli/provider-credential-set-schema-error-no-orphan",
  "oracle": "ADR-0038m / ADR-0041m provider-credential set ordering: an unreadable (newer-schema) binding record fails closed with state_schema_unsupported before the value reaches the backend, so sbx holds no orphaned USAI_API_KEY custom secret afterwards",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{python}",
      "-I",
      "test/vectors/drivers/seeded-run.py",
      "[{\"binding_record\":\"usai\",\"text\":\"{\\\"schema\\\":99,\\\"provider\\\":\\\"usai\\\",\\\"key_env\\\":\\\"USAI_API_KEY\\\",\\\"hosts\\\":[\\\"api.gsa.usai.gov\\\"]}\\n\"},[[\"--backend\",\"sbx\",\"provider-credential\",\"set\",\"usai\",\"USAI_API_KEY\",\"--host\",\"api.gsa.usai.gov\",\"--json\"],true,null],[[\"--backend\",\"sbx\",\"secret\",\"has\",\"-g\",\"USAI_API_KEY\"],false,1]]",
      "{acq}"
    ],
    "env": {
      "ACQ_SBX_BIN": "__stub__",
      "ACQ_SBX_VERSION": "0.51.0",
      "ACQ_SBX_INSTALLED": "1",
      "ACQ_MSB_INSTALLED": "0"
    },
    "unset": [
      "ACQ_BACKEND",
      "ACQ_STATE_DIR",
      "ACQ_SECRET_NO_LIVE_REFEED",
      "ACQ_PROVIDER_CREDENTIAL_BINDINGS",
      "ACQ_PROVIDER_CREDENTIAL_SEED",
      "USAI_API_KEY",
      "GITHUB_TOKEN",
      "GH_TOKEN",
      "GITLAB_TOKEN",
      "GIT_DIR",
      "GIT_WORK_TREE",
      "GIT_CEILING_DIRECTORIES",
      "MSB_HOME",
      "SBX_HOME",
      "ACQ_IMAGE",
      "ACQ_MSB_IMAGE",
      "ACQ_SBX_STUB_CATALOG",
      "ACQ_SBX_STUB_FAIL",
      "ACQ_SBX_STUB_SECRETS",
      "ACQ_SBX_STUB_SECRET_LS_RAW",
      "ACQ_SBX_STUB_RAW_PLACEHOLDERS",
      "ACQ_SBX_STUB_ALLOWED_SOURCES",
      "ACQ_SBX_STUB_ROTATE"
    ],
    "stdin": "vector-orphan-sentinel-51c0\n",
    "timeout_ms": 15000
  },
  "expect": {
    "exit": 1,
    "stdout": {
      "mode": "json",
      "value": {
        "schema_version": 1,
        "command": "provider-credential set",
        "error": {
          "code": "state_schema_unsupported"
        }
      },
      "normalize": []
    },
    "stderr": {
      "mode": "exact",
      "value": "",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": [
      "HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_STATE_HOME",
      "XDG_CACHE_HOME",
      "ACQ_SECRET_STORE_DIR"
    ]
  }
}
