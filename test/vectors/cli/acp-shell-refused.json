{
  "schema": 1,
  "id": "cli/acp-shell-refused",
  "oracle": "ADR-0053m invariant 4: shell is not an ACP server; refused with exit 2 and an empty stdout",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{acq}",
      "--backend",
      "msb",
      "acp",
      "shell",
      "."
    ],
    "env": {
      "ACQ_MSB_BIN": "__stub__",
      "ACQ_MSB_VERSION": "0.7.7",
      "ACQ_MSB_INSTALLED": "1",
      "ACQ_SBX_INSTALLED": "0"
    },
    "unset": [
      "ACQ_BACKEND",
      "ACQ_STATE_DIR",
      "MSB_HOME",
      "ACQ_IMAGE",
      "ACQ_MSB_IMAGE",
      "ACQ_MSB_STUB_CATALOG",
      "ACQ_MSB_READY_TIMEOUT",
      "ACQ_MSB_STUB_FAIL",
      "ACQ_MSB_STUB_EXEC_EXIT",
      "ACQ_MSB_STUB_COPY_EXIT",
      "ACQ_MSB_STUB_EXIT_CODE",
      "ACQ_MSB_STUB_PORTS"
    ],
    "stdin": "",
    "timeout_ms": 15000
  },
  "expect": {
    "exit": 2,
    "stdout": {
      "mode": "exact",
      "value": "",
      "normalize": []
    },
    "stderr": {
      "mode": "contains",
      "value": "not an ACP-capable agent",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": [
      "HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_STATE_HOME",
      "XDG_CACHE_HOME"
    ]
  }
}
