{
  "schema": 1,
  "id": "cli/create-sbx-ssh-agent-notice",
  "oracle": "sbx create with a host SSH_AUTH_SOCK set prints the one-time trust-boundary notice (the sbx CLI forwards the agent itself; acq only makes the implicit forward a conscious choice, ADR-0021) and the create result is unchanged",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{python}",
      "-I",
      "test/vectors/drivers/seeded-run.py",
      "[{\"git_repos\":{}},[[\"--backend\",\"sbx\",\"create\",\"shell\",\"{workspace}\",\"--name\",\"sbx-agent-test\",\"--json\"],false,null]]",
      "{acq}"
    ],
    "env": {
      "ACQ_SBX_BIN": "__stub__",
      "ACQ_SBX_VERSION": "0.39.0",
      "ACQ_SBX_INSTALLED": "1",
      "ACQ_MSB_INSTALLED": "0",
      "ACQ_SBX_STUB_CUSTOM_SECRETS": "[{\"scope\": \"global\", \"env\": \"USAI_API_KEY\", \"placeholder\": \"sbx-cs-usai\", \"targets\": [\"api.gsa.usai.gov\"]}]",
      "SSH_AUTH_SOCK": "/nonexistent/acq-vector-agent.sock"
    },
    "unset": [
      "ACQ_BACKEND",
      "ACQ_STATE_DIR",
      "MSB_HOME",
      "SBX_HOME",
      "ACQ_IMAGE",
      "ACQ_MSB_IMAGE",
      "ACQ_SBX_READY_TIMEOUT",
      "ACQ_SBX_STUB_CATALOG",
      "ACQ_SBX_STUB_FAIL",
      "ACQ_SBX_STUB_SECRETS",
      "ACQ_SBX_STUB_SECRET_LS_RAW",
      "ACQ_SBX_STUB_RAW_PLACEHOLDERS",
      "ACQ_SBX_STUB_ALLOWED_SOURCES",
      "ACQ_SBX_STUB_ROTATE",
      "ACQ_MSB_STUB_CATALOG",
      "ACQ_MSB_STUB_FAIL",
      "ACQ_MSB_STUB_SECRETS",
      "ACQ_MSB_STUB_SECRET_LS_RAW",
      "ACQ_MSB_STUB_ROTATE",
      "ACQ_SBX_STUB_PROBE",
      "ACQ_PROVIDER_KITS",
      "ACQ_PROVIDER_CREDENTIAL_BINDINGS",
      "ACQ_PROVIDER_CREDENTIAL_SEED"
    ],
    "stdin": "",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "json",
      "value": {
        "schema_version": 1,
        "command": "create",
        "data": {
          "name": "sbx-agent-test",
          "backend": "sbx",
          "agent": "shell",
          "state": "running",
          "kit": null,
          "kits": [
            "zscaler-ca-certificate",
            "usai-provider",
            "agentic-coding-playbook",
            "git-ssh-sign"
          ]
        }
      },
      "normalize": []
    },
    "stderr": {
      "mode": "exact",
      "value": "acq(sbx): sbx forwards your host ssh-agent into the guest because SSH_AUTH_SOCK is set. Guest code can use every key the agent holds while the sandbox runs; unset SSH_AUTH_SOCK to opt out, or run 'ssh-add -c' to confirm each use. See ADR-0021.\n",
      "normalize": [
        "crlf"
      ]
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": [
      "HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_STATE_HOME",
      "XDG_CACHE_HOME"
    ]
  }
}
