{
  "schema": 1,
  "id": "cli/backend-check-not-found",
  "oracle": "ADR-0040m version floor fail-closed: an absent backend CLI is refused with backend_not_found",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": ["{acq}", "backend", "check", "sbx", "--json"],
    "env": {
      "ACQ_SBX_INSTALLED": "0"
    },
    "unset": ["ACQ_SBX_VERSION", "ACQ_MSB_INSTALLED", "ACQ_MSB_VERSION", "ACQ_BACKEND"],
    "stdin": "",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 1,
    "stdout": {
      "mode": "json",
      "value": {
        "schema_version": 1,
        "command": "backend check",
        "error": {"code": "backend_not_found"}
      },
      "normalize": []
    },
    "stderr": {"mode": "exact", "value": "", "normalize": []}
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": ["HOME", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME", "XDG_CACHE_HOME"]
  }
}
