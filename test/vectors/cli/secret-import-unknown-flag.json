{
  "schema": 1,
  "id": "cli/secret-import-unknown-flag",
  "oracle": "secret import refuses an unknown flag as a usage error (exit 2) before reading the environment or the store",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": [
      "{acq}",
      "secret",
      "import",
      "usai",
      "--bogus",
      "--json"
    ],
    "env": {
      "ACQ_MSB_INSTALLED": "0",
      "ACQ_SBX_INSTALLED": "0",
      "USAI_API_KEY": "vector-usai-0001"
    },
    "unset": [
      "ACQ_BACKEND",
      "ACQ_STATE_DIR",
      "USAI_API_KEY",
      "GITHUB_TOKEN",
      "GH_TOKEN",
      "GITLAB_TOKEN",
      "ACQ_SECRET_IMPORT_ASSUME_YES",
      "ACQ_PROVIDER_CREDENTIAL_BINDINGS",
      "ACQ_PROVIDER_CREDENTIAL_SEED"
    ],
    "stdin": "",
    "timeout_ms": 10000
  },
  "expect": {
    "exit": 2,
    "stdout": {
      "mode": "json",
      "value": {
        "schema_version": 1,
        "command": "secret import",
        "error": {
          "code": "usage",
          "message": "secret import: unknown flag '--bogus'"
        }
      },
      "normalize": []
    },
    "stderr": {
      "mode": "exact",
      "value": "",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": [
      "HOME",
      "XDG_CONFIG_HOME",
      "XDG_DATA_HOME",
      "XDG_STATE_HOME",
      "XDG_CACHE_HOME",
      "ACQ_SECRET_STORE_DIR"
    ]
  }
}
