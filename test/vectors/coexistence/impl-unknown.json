{
  "schema": 1,
  "id": "coexistence/impl-unknown",
  "oracle": "ADR-0046m coexistence: an unknown ACQ_IMPL value fails closed with exit 2",
  "tier": 1,
  "backend": null,
  "platform": "linux",
  "invoke": {
    "argv": ["bash", "acq", "version"],
    "env": { "ACQ_IMPL": "bogus" },
    "unset": ["ACQ_RUNTIME"],
    "stdin": "",
    "timeout_ms": 10000
  },
  "expect": {
    "exit": 2,
    "stderr": {
      "mode": "contains",
      "value": "unsupported ACQ_IMPL",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": []
  }
}
