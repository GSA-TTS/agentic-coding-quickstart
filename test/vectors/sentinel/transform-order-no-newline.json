{
  "schema": 1,
  "id": "sentinel/transform-order-no-newline",
  "oracle": "ADR-0043m normalisation transform: order (preserves absent trailing newline)",
  "tier": 1,
  "backend": null,
  "platform": "any",
  "invoke": {
    "argv": ["{python}", "-c", "import sys; sys.stdout.buffer.write(b'z\\na\\nm')"],
    "env": {},
    "unset": [],
    "stdin": "",
    "timeout_ms": 5000
  },
  "expect": {
    "exit": 0,
    "stdout": {
      "mode": "exact",
      "value": "a\nm\nz",
      "normalize": ["order"]
    },
    "stderr": {
      "mode": "exact",
      "value": "",
      "normalize": []
    }
  },
  "isolation": {
    "offline": true,
    "ssh_stubs": false,
    "redirect": []
  }
}
