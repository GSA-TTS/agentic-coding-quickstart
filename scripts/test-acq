#!/usr/bin/env bash
#
# test-acq — offline unit runner for acq
#
# Tests the acq entry point and adapter layer against STUBBED backends —
# no Docker, no real sandbox, no network.
#
# LAYOUT (see scripts/test-acq-lib.sh for the full rationale):
#   scripts/test-acq            — this thin runner (harness setup + part loader)
#   scripts/test-acq-lib.sh     — shared harness (asserts, stubs, load_acq, counters)
#   scripts/test-acq.d/NN-*.sh  — the numbered test parts, sourced in order
#
# The parts are SOURCED (run in-process) so they share the PASS/FAIL counters and
# harness functions exactly as they did when they lived inline in one file. The
# split exists so every file stays small enough to shellcheck in seconds (a
# single 8k-line file OOMs ShellCheck's dataflow analysis) — behavior is
# unchanged, only the file layout differs.
#
# What is tested (across the parts):
#   - Backend resolution order (flag > env > XDG config > auto-detect)
#   - Name derivation (slugify / derive_name)
#   - Dispatch routing (each subcommand calls the right adapter function)
#   - acq secret set builds the correct backend command and never puts a secret
#     in argv; per-verb --help; kit-translate; msb provision; ADR-0021 forwarding
#
# Run: ./scripts/test-acq     (exit 0 = all pass)
#
# Live sbx/msb end-to-end is DEFERRED: this harness runs inside a sandbox and
# cannot create nested sandboxes. See scripts/verify-backends for the live path.

# Load the shared harness (defines set -uo pipefail, REPO_ROOT, ACQ, the
# PASS/FAIL counters, the assertion helpers, the stub scaffolding, load_acq, and
# the offline kit-dir + retry-backoff neutralization).
_TEST_ACQ_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=scripts/test-acq-lib.sh
. "${_TEST_ACQ_DIR}/test-acq-lib.sh"

# Detach stdin from any terminal for the whole run. acq's interactive prompts
# (key-gate rotate, github-scope advisory, stale-bundle refresh, doctor
# default-write) gate on `[ -t 0 ]` and READ stdin when it is a TTY. Individual
# tests redirect stdin where they exercise a prompt on purpose; reopening from
# /dev/null once here makes every other prompt take its non-interactive branch
# regardless of how the suite was launched (CI already pipes stdin). Tests that
# feed input still pipe it explicitly (that overrides this).
exec </dev/null

# Clean up the offline kit-dir the lib created (its mktemp is in the shared lib;
# the trap belongs to the top-level process, so it is installed here).
trap 'rm -rf "${_ACQ_MSB_OFFLINE_KIT_DIR:-}"' EXIT

echo "test-acq"
echo ""

# Source each part in filename order. The NN- prefix pins the run order (the
# original inline section order). A part failing to source is a hard error — a
# missing/broken part must not silently drop its assertions.
_parts_dir="${_TEST_ACQ_DIR}/test-acq.d"
if [ ! -d "$_parts_dir" ]; then
  echo "test-acq: missing parts directory: $_parts_dir" >&2
  exit 2
fi
_ran_any=0
for _part in "$_parts_dir"/*.sh; do
  [ -e "$_part" ] || { echo "test-acq: no parts found in $_parts_dir" >&2; exit 2; }
  _ran_any=1
  # shellcheck source=/dev/null
  . "$_part"
done
[ "$_ran_any" -eq 1 ] || { echo "test-acq: no parts found in $_parts_dir" >&2; exit 2; }

echo ""
echo "  passed: $PASS   failed: $FAIL"
[ "$FAIL" -eq 0 ]
