# 8a. Auto-detect prefers msb when both present.
make_stubs; load_acq
(
  unset ACQ_BACKEND 2>/dev/null || true
  export XDG_CONFIG_HOME="$STUBDIR/noconfig"
  # Pin PATH to ONLY the stub dir so a real sbx/msb on the developer's host
  # PATH cannot leak into auto-detection.
  PATH="$STUBDIR"; export PATH
  # shellcheck source=acq
  ACQ_SOURCE_ONLY=1 . "$ACQ"
  . "${REPO_ROOT}/acq.backends/msb.sh"
  set +e
  detected=$(_auto_detect_backend)
  assert_eq "msb: auto-detect prefers msb over sbx" "msb" "$detected"
) 2>/dev/null; pass "msb: auto-detect order msb>sbx (both stubbed)"
cleanup_stubs

# 8b. Auto-detect falls back to sbx when only sbx is present.
make_stubs; load_acq
(
  unset ACQ_BACKEND 2>/dev/null || true
  export XDG_CONFIG_HOME="$STUBDIR/noconfig"
  rm -f "$STUBDIR/msb"          # remove msb so only sbx remains
  # Constrain PATH to the stub dir ONLY: _auto_detect_backend runs
  # `command -v msb`, which would otherwise find a REAL msb on the developer's
  # base PATH and make this fall back-to-sbx assertion flake to "msb". Provide a
  # coreutils dir so the sourced scripts still find standard tools.
  _coreutils_dir=$(dirname "$(command -v env)")
  PATH="$STUBDIR:$_coreutils_dir"
  export PATH
  # shellcheck disable=SC1090
  ACQ_SOURCE_ONLY=1 . "$ACQ"
  # shellcheck source=acq.backends/sbx.sh
  . "${REPO_ROOT}/acq.backends/sbx.sh"
  set +e
  detected=$(_auto_detect_backend)
  assert_eq "msb: auto-detect falls back to sbx" "sbx" "$detected"
) 2>/dev/null; pass "msb: auto-detect fallback to sbx (msb absent)"
cleanup_stubs

