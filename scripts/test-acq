  printf 'schemaVersion: "hybrid/v1"\nkind: mixin\nname: x\ndisplayName: X\ndescription: x\n' > "${STUBDIR}/nokit/spec.yaml"
  acq_backend_provision balprovbox shell /tmp >/dev/null 2>&1
)
bal_prov_log=$(cat "$CALLS")
