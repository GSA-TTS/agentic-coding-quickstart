assert_contains "msb: proxy env preserved across sudo (env_keep)" "$basereq_log" "env_keep"
assert_contains "msb: proxy env_keep names HTTPS_PROXY" "$basereq_log" "HTTPS_PROXY"
cleanup_stubs

