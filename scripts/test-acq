name: bad-pp-kit
displayName: Bad PP Kit
description: invalid published ports dropped
publishedPorts:
  - guest: 99999
    name: too-big
  - guest: 3000
    protocol: sctp
    name: bad-proto
  - guest: 3001
    name: "bad name!"
  - guest: 3002
    host: notanumber
  - guest: 3003
    protocol: tcp
    name: ok
SPEC
