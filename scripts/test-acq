  command -v acq_backend_rotate_key >/dev/null 2>&1
) && pass "rotate: msb adapter defines acq_backend_rotate_key" \
  || fail "rotate: msb adapter defines acq_backend_rotate_key" "function missing"
cleanup_stubs

