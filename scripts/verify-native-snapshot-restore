#!/usr/bin/env bash
#
# Live host-side verification for acq native msb snapshot/restore.
#
# This intentionally exercises the real msb backend. It creates a sandbox,
# snapshots it, removes/restores it, verifies SSH-agent vsock re-plumbing, and
# optionally tests an explicit-copy restore and one-shot recreate.

set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  scripts/verify-native-snapshot-restore [SANDBOX] [WORKSPACE]

Defaults:
  SANDBOX   snaptest-opencode
  WORKSPACE current directory

Environment:
  AGENT=opencode                         agent to create for the test sandbox
  ACQ_SNAPSHOT_DIR=<dir>                 override snapshot archive directory
  VERIFY_SNAPSHOT_CLEANUP=1              remove the test sandboxes at the end
  VERIFY_SNAPSHOT_SKIP_CREATE=1          skip initial create/attach step
  VERIFY_SNAPSHOT_SKIP_COPY=1            skip explicit archive restore copy test
  VERIFY_SNAPSHOT_SKIP_RECREATE=1        skip acq recreate test

Prerequisites:
  - Run from a quickstart checkout with this branch checked out.
  - msb must be installed and usable.
  - SSH_AUTH_SOCK must point at a live host ssh-agent socket.
  - The initial acq run is interactive; exit the agent session to continue.
USAGE
}

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  usage
  exit 0
fi

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
ACQ="$ROOT/acq"
SANDBOX="${1:-snaptest-opencode}"
WORKSPACE="${2:-$PWD}"
AGENT="${AGENT:-opencode}"
SNAPDIR="${ACQ_SNAPSHOT_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/acq/snapshots}"
COPY_SANDBOX="${SANDBOX}-copy"

say() { printf '\n==> %s\n' "$*" >&2; }
fail() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

[ -x "$ACQ" ] || fail "acq is not executable at $ACQ"
[ -d "$WORKSPACE" ] || fail "workspace is not a directory: $WORKSPACE"
command -v msb >/dev/null 2>&1 || fail "msb is not on PATH"
[ -n "${SSH_AUTH_SOCK:-}" ] || fail "SSH_AUTH_SOCK is not set"
[ -S "$SSH_AUTH_SOCK" ] || fail "SSH_AUTH_SOCK is not a live socket: $SSH_AUTH_SOCK"

say "Using acq: $ACQ"
say "Sandbox: $SANDBOX"
say "Workspace: $WORKSPACE"
say "Snapshot directory: $SNAPDIR"

if [ "${VERIFY_SNAPSHOT_SKIP_CREATE:-0}" != "1" ]; then
  say "Creating and attaching to sandbox. Exit the agent session to continue."
  "$ACQ" --backend msb run "$AGENT" "$WORKSPACE" --name "$SANDBOX"
else
  say "Skipping initial create/attach step because VERIFY_SNAPSHOT_SKIP_CREATE=1"
fi

say "Creating date-stamped snapshot archive"
"$ACQ" --backend msb snapshot "$SANDBOX"

LATEST=$(ls -t "$SNAPDIR"/"$SANDBOX"-*.msb 2>/dev/null | head -n 1 || true)
[ -n "$LATEST" ] || fail "no snapshot archive found for $SANDBOX in $SNAPDIR"
say "Latest snapshot: $LATEST"

say "Removing sandbox to simulate recreate/recovery"
"$ACQ" --backend msb rm "$SANDBOX"

say "Restoring by sandbox name only (should pick newest date-stamped snapshot)"
"$ACQ" --backend msb restore "$SANDBOX"

say "Verifying sandbox is listed"
"$ACQ" --backend msb ls | grep -F "$SANDBOX" >/dev/null || fail "restored sandbox not listed: $SANDBOX"

say "Verifying SSH-agent is reachable through restored vsock route"
"$ACQ" --backend msb exec "$SANDBOX" -- sh -lc 'echo "SSH_AUTH_SOCK=$SSH_AUTH_SOCK"; ssh-add -l >/dev/null && echo "ssh-agent reachable"'

if [ "${VERIFY_SNAPSHOT_SKIP_COPY:-0}" != "1" ]; then
  say "Restoring explicit archive into copy sandbox: $COPY_SANDBOX"
  "$ACQ" --backend msb restore "$COPY_SANDBOX" "$LATEST"
  "$ACQ" --backend msb exec "$COPY_SANDBOX" -- sh -lc 'ssh-add -l >/dev/null && echo "copy ssh-agent reachable"'
else
  say "Skipping explicit archive copy restore because VERIFY_SNAPSHOT_SKIP_COPY=1"
fi

if [ "${VERIFY_SNAPSHOT_SKIP_RECREATE:-0}" != "1" ]; then
  say "Testing one-shot acq recreate on primary sandbox"
  "$ACQ" --backend msb recreate "$SANDBOX"
  "$ACQ" --backend msb exec "$SANDBOX" -- sh -lc 'ssh-add -l >/dev/null && echo "recreated ssh-agent reachable"'
else
  say "Skipping acq recreate because VERIFY_SNAPSHOT_SKIP_RECREATE=1"
fi

say "Re-attaching to primary sandbox so you can inspect restored agent context. Exit to finish."
"$ACQ" --backend msb run "$SANDBOX"

if [ "${VERIFY_SNAPSHOT_CLEANUP:-0}" = "1" ]; then
  say "Cleaning up test sandboxes"
  "$ACQ" --backend msb rm --snapshot "$SANDBOX" || true
  "$ACQ" --backend msb rm --snapshot "$COPY_SANDBOX" || true
else
  say "Leaving sandboxes in place. Set VERIFY_SNAPSHOT_CLEANUP=1 to clean up on a future run."
fi

say "Native snapshot/restore verification completed"
