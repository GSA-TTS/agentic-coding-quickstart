#!/usr/bin/env bash
# validate-git-executable-modes — verify that Git's stage-0 index records the
# executable entry points this repository ships as 100755.
#
# This is intentionally separate from fix-exec-bits. That tool compares the
# worktree with its index and may repair local mount drift. This validator reads
# only the index, which is what a fresh checkout receives; it never chmods files.

set -uo pipefail

usage() {
  cat <<'EOF'
Usage: bash scripts/validate-git-executable-modes [--root DIRECTORY | --print-expected]

Verify that each shipped executable entry point has exactly one stage-0 Git
index entry recorded as mode 100755. This command is read-only.

--print-expected prints the audited entrypoint inventory for regression tests.
EOF
}

ROOT=''
PRINT_EXPECTED=0
case "${1:-}" in
  --root)
    [ "$#" -eq 2 ] || { usage >&2; exit 2; }
    ROOT=$2
    ;;
  -h|--help)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    usage
    exit 0
    ;;
  --print-expected)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    PRINT_EXPECTED=1
    ;;
  '') ;;
  *)
    printf 'validate-git-executable-modes: unknown argument: %s\n' "$1" >&2
    usage >&2
    exit 2
    ;;
esac

if [ "$PRINT_EXPECTED" -ne 1 ] && ! command -v git >/dev/null 2>&1; then
  echo 'validate-git-executable-modes: git not found on PATH' >&2
  exit 2
fi

if [ "$PRINT_EXPECTED" -ne 1 ] && [ -z "$ROOT" ]; then
  ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo 'validate-git-executable-modes: not inside a git repository' >&2
    exit 2
  }
fi

if [ "$PRINT_EXPECTED" -ne 1 ] && ! git -C "$ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  printf 'validate-git-executable-modes: not a git worktree: %s\n' "$ROOT" >&2
  exit 2
fi

# This allowlist is based on supported user commands, distribution/package
# entrypoints, and CI/local verification dispatch. Sourced adapters, Bats files,
# and install.sh (documented as `sh install.sh`) intentionally do not belong here.
EXPECTED='acq
scripts/bats-shard
scripts/diagnose-tls-intercept
scripts/fetch-bash32-oci.py
scripts/fix-exec-bits
scripts/install-provider-input-wheelhouse
scripts/probe-msb-node-startup
scripts/probe-msb-posthoc-ports
scripts/probe-msb-startup
scripts/rotate-apikey
scripts/run-shellcheck
scripts/scan-heredoc-subst.py
scripts/setup-provider-input-validator
scripts/summarize-bats-timing
scripts/test-acq-bash32
scripts/test-acq-bats
scripts/test-probe-msb-node-startup.py
scripts/test-probe-msb-startup.py
scripts/validate-git-executable-modes
scripts/verify-backends
scripts/verify-git-https-secret-msb
scripts/verify-host-authority-live
scripts/verify-image-override
scripts/verify-issue-320
scripts/verify-net-default-egress
scripts/verify-ports-live'

if [ "$PRINT_EXPECTED" -eq 1 ]; then
  printf '%s\n' "$EXPECTED"
  exit 0
fi

FAILURES=0
for path in $EXPECTED; do
  matches=$(git -C "$ROOT" ls-files --stage -- "$path" | awk '{ print $1 " " $3 }') || {
    printf 'validate-git-executable-modes: could not read Git index entry: %s\n' "$path" >&2
    exit 2
  }
  if [ "$matches" != '100755 0' ]; then
    printf 'validate-git-executable-modes: %s must have one stage-0 100755 index entry (got: %s)\n' \
      "$path" "${matches:-missing or untracked}" >&2
    FAILURES=$((FAILURES + 1))
  fi
done

if [ "$FAILURES" -ne 0 ]; then
  printf 'validate-git-executable-modes: %d intended executable(s) have invalid Git index modes\n' \
    "$FAILURES" >&2
  printf 'Stage the file, then run: git update-index --chmod=+x <specific-script>\n' >&2
  exit 1
fi

printf 'validate-git-executable-modes: OK - %s intended executables are stage-0 100755\n' \
  "$(printf '%s\n' "$EXPECTED" | wc -w | tr -d ' ')"
