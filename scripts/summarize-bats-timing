#!/usr/bin/env python3
"""Summarize bats `--timing` TAP output as Markdown plus a JSON record.

Reads the TAP stream scripts/test-acq-bats prints when ACQ_BATS_TIMING=1
(`ok N <name> in Xms`), from a file or stdin, and reports the slowest tests,
the slowest files, and the margin to the CI job timeout, so a slowdown is
visible long before it hits the timeout. Python 3 standard library only.

This tool is advisory. It ALWAYS exits 0 (a bad argument, a missing log, or an
internal error becomes a short note in the summary, never a failed job).

Untrusted text: test names come from repository content and the output is
rendered Markdown in the Actions UI. Every name is sanitized and escaped before
it reaches Markdown or JSON, and the only workflow command this tool can print
(`::warning`) is built from numbers alone, never from the log.

Files are attributed by matching each test name against the `@test` lines in
--tests-dir (default test/bats): the TAP stream carries no file names, and the
runner's parallel and fallback paths number tests differently.

Usage:
  summarize-bats-timing --log bats.log --timeout-minutes 25 \\
      --summary-file "$GITHUB_STEP_SUMMARY" --json timing.json
"""

import argparse
import heapq
import calendar
import json
import math
import os
import re
import sys
import time
import unicodedata

TOP_TESTS = 15
TOP_FILES = 10
MAX_FAILED_SHOWN = 20
JSON_MAX_TESTS = 200
MAX_LINE = 4096
MAX_NAME = 160
UNMAPPED = "(unmapped)"
AMBIGUOUS = "(ambiguous name)"

ANSI_RE = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")
STAMP_RE = re.compile(r"^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(\.\d+)?Z ")
RESULT_RE = re.compile(
    r"^(not )?ok (\d+) (.*?)(?: in (\d{1,9})ms)?(?: # (?:skip|SKIP|todo|TODO)\b.*)?$"
)
SKIP_RE = re.compile(r" # (?:skip|SKIP)\b")
PLAN_RE = re.compile(r"^1\.\.(\d+)$")
WORKERS_RE = re.compile(r"test-acq-bats: workers=(\d+)\b")
TEST_DECL_RE = re.compile(r"^\s*@test\s+(.*[^\s])\s+\{")
SHARD_RE = re.compile(r"[^A-Za-z0-9._-]")


class Note(Exception):
    """A user-facing, fixed-text problem (never carries untrusted text)."""


def parse_stamp(line):
    m = STAMP_RE.match(line)
    if not m:
        return None
    try:
        return calendar.timegm(time.strptime(m.group(1), "%Y-%m-%dT%H:%M:%S")) + (
            float(m.group(2)) if m.group(2) else 0.0
        )
    except (ValueError, OverflowError):
        return None


def clean(text, limit=MAX_NAME):
    out = []
    for ch in text:
        # Control, format (bidi/zero-width), line/paragraph separators, surrogates.
        bad = unicodedata.category(ch) in ("Cc", "Cf", "Cs", "Co", "Cn", "Zl", "Zp")
        out.append(" " if bad else ch)
    s = "".join(out).strip()
    return s if len(s) <= limit else s[: limit - 1] + "\u2026"


_MD_ESC = {"&": "&amp;", "<": "&lt;", ">": "&gt;", "|": "&#124;"}
_MD_BACKSLASH = set("\\`*_[]~")
_ZWSP = "\u200b"  # breaks GFM autolinks/mentions/math; inserted after these
_MD_BREAK_AFTER = set("@#$")


def md(text, limit=MAX_NAME):
    out = []
    for ch in clean(text, limit):
        if ch in _MD_ESC:
            out.append(_MD_ESC[ch])
        elif ch in _MD_BACKSLASH:
            out.append("\\" + ch)
        elif ch in _MD_BREAK_AFTER:
            out.append(ch + _ZWSP)
        else:
            out.append(ch)
    return "".join(out).replace("://", ":" + _ZWSP + "//").replace("www.", "www" + _ZWSP + ".")


def unquote_test_name(expr):
    if len(expr) >= 2 and expr[0] == expr[-1] == '"':
        return re.sub(r'\\(["\\$`])', r"\1", expr[1:-1])
    if len(expr) >= 2 and expr[0] == expr[-1] == "'":
        return expr[1:-1]
    return expr


def load_name_map(tests_dir):
    """Map test name -> sorted list of .bats basenames declaring it."""
    names = {}
    try:
        entries = sorted(os.listdir(tests_dir))
    except OSError:
        return names
    for entry in entries:
        if not entry.endswith(".bats"):
            continue
        try:
            with open(os.path.join(tests_dir, entry), encoding="utf-8", errors="replace") as fh:
                for line in fh:
                    m = TEST_DECL_RE.match(line)
                    if m:
                        files = names.setdefault(unquote_test_name(m.group(1)), [])
                        if entry not in files:
                            files.append(entry)
        except OSError:
            continue
    return names


class Stats:
    def __init__(self, name_map):
        self.name_map = name_map
        self.passed = self.failed = self.skipped = self.untimed = 0
        self.planned = 0
        self.sum_ms = 0
        self.workers = None
        self.slow = []  # min-heap of (ms, -seq, name, file, status)
        self.files = {}  # file -> [tests, ms, max_ms]
        self.failed_names = []
        self.seq = 0
        self.first_stamp = self.last_stamp = self.workers_stamp = None

    def file_for(self, name):
        cands = self.name_map.get(name)
        if not cands:
            return UNMAPPED
        return cands[0] if len(cands) == 1 else AMBIGUOUS

    def add_result(self, failed, name, ms, skipped):
        file = self.file_for(name)
        if skipped:
            self.skipped += 1
        elif failed:
            self.failed += 1
            if len(self.failed_names) < MAX_FAILED_SHOWN:
                self.failed_names.append((name, file))
        else:
            self.passed += 1
        entry = self.files.setdefault(file, [0, 0, 0])
        entry[0] += 1
        if ms is None:
            self.untimed += 1
            return
        if skipped:
            return
        self.sum_ms += ms
        entry[1] += ms
        entry[2] = max(entry[2], ms)
        self.seq += 1
        item = (ms, -self.seq, name, file, "not ok" if failed else "ok")
        if len(self.slow) < JSON_MAX_TESTS:
            heapq.heappush(self.slow, item)
        elif item > self.slow[0]:
            heapq.heapreplace(self.slow, item)

    @property
    def total(self):
        return self.passed + self.failed + self.skipped

    @property
    def timed(self):
        return self.total - self.untimed


def consume(stream, stats):
    while True:
        raw = stream.readline(MAX_LINE)
        if not raw:
            break
        while len(raw) == MAX_LINE and not raw.endswith("\n"):
            chunk = stream.readline(MAX_LINE)  # drop the rest of an over-long line
            if not chunk or chunk.endswith("\n"):
                break
        line = ANSI_RE.sub("", raw).rstrip("\r\n")
        stamp = parse_stamp(line)
        body = STAMP_RE.sub("", line, count=1) if stamp is not None else line
        m = WORKERS_RE.search(body)
        if m and stats.workers is None:
            stats.workers = int(m.group(1))
            stats.workers_stamp = stamp
        m = PLAN_RE.match(body)
        if m:
            stats.planned += int(m.group(1))
            if stamp is not None and stats.first_stamp is None:
                stats.first_stamp = stamp
            continue
        m = RESULT_RE.match(body)
        if not m:
            continue
        ms = int(m.group(4)) if m.group(4) is not None else None
        stats.add_result(bool(m.group(1)), m.group(3), ms, bool(SKIP_RE.search(body)))
        if stamp is not None:
            if stats.first_stamp is None:
                stats.first_stamp = stamp
            stats.last_stamp = stamp


def fmt_ms(ms):
    if ms < 1000:
        return "%dms" % ms
    return fmt_secs(ms / 1000.0, tenths=True)


def fmt_secs(secs, tenths=False):
    if secs < 60:
        return "%.1fs" % secs if tenths or secs < 10 else "%ds" % round(secs)
    secs = int(round(secs))
    return "%dm %02ds" % (secs // 60, secs % 60)


def read_epoch(path):
    try:
        with open(path, encoding="ascii") as fh:
            return float(fh.read(64).strip())
    except (OSError, ValueError):
        return None


def wall_seconds(args, stats):
    if args.wall_seconds is not None:
        return args.wall_seconds
    if args.start_epoch_file and args.log and args.log != "-":
        start = read_epoch(args.start_epoch_file)
        try:
            end = os.stat(args.log).st_mtime
        except OSError:
            end = None
        if stats.planned and stats.total < stats.planned:
            # Incomplete run (cancelled or timed out): the last write understates
            # how long the suite ran before it was killed; elapsed-until-now does not.
            end = time.time()
        if start is not None and end is not None and end >= start:
            return end - start
    if stats.last_stamp is not None:
        begin = stats.workers_stamp if stats.workers_stamp is not None else stats.first_stamp
        if begin is not None and stats.last_stamp >= begin:
            return stats.last_stamp - begin
    return None


def render(args, stats, wall, shard, notes):
    lines = ["## bats timing (shard: %s)" % shard, ""]
    lines.extend(notes)
    if notes:
        lines.append("")
    if stats.total == 0:
        lines.append("No bats test results were found in the log.")
        return lines
    lines.append("| Metric | Value |")
    lines.append("| --- | --- |")
    lines.append(
        "| Tests reported | %d (%d passed, %d failed, %d skipped) |"
        % (stats.total, stats.passed, stats.failed, stats.skipped)
    )
    if stats.planned and stats.total < stats.planned:
        lines.append(
            "| Run incomplete | %d of %d planned tests reported (cancelled, timed out or crashed?) |"
            % (stats.total, stats.planned)
        )
    if stats.timed == 0:
        lines.append("| Timing | none |")
        lines.append("")
        lines.append(
            "No per-test timings were present (`in Nms` suffixes). "
            "Run the suite with `ACQ_BATS_TIMING=1` to get slowest-test and slowest-file tables."
        )
        return lines + failed_section(stats)
    lines.append("| Summed test time | %s (setup and teardown included) |" % fmt_secs(stats.sum_ms / 1000.0, True))
    if wall is not None and wall > 0:
        par = "%s wall" % fmt_secs(wall, True)
        par += ", %.1fx parallel" % (stats.sum_ms / 1000.0 / wall)
        if stats.workers:
            par += " (%d workers)" % stats.workers
        lines.append("| Suite wall time | %s |" % par)
    else:
        lines.append("| Suite wall time | unknown |")
    if args.timeout_minutes:
        limit = args.timeout_minutes * 60.0
        if wall is not None and wall > 0 and limit > 0:
            lines.append(
                "| Margin to %g min job timeout | %s left, suite used %.0f%% (suite only; checkout, setup and bash build also count) |"
                % (args.timeout_minutes, fmt_secs(max(limit - wall, 0)), 100.0 * wall / limit)
            )
        else:
            lines.append("| Margin to %g min job timeout | unknown (no wall time) |" % args.timeout_minutes)
    unmapped = sum(v[0] for k, v in stats.files.items() if k in (UNMAPPED, AMBIGUOUS))
    if unmapped:
        lines.append("| Tests not attributable to a file | %d |" % unmapped)
    ranked = sorted(stats.slow, reverse=True)[:TOP_TESTS]
    lines += ["", "### Slowest %d tests" % len(ranked), "", "| # | Time | File | Test |", "| ---: | ---: | --- | --- |"]
    for i, (ms, _seq, name, file, _st) in enumerate(ranked, 1):
        lines.append("| %d | %s | %s | %s |" % (i, fmt_ms(ms), md(file), md(name)))
    files = sorted(stats.files.items(), key=lambda kv: (-kv[1][1], kv[0]))[:TOP_FILES]
    lines += ["", "### Slowest %d files (summed test time)" % len(files), "",
              "| # | File | Tests | Total | Slowest test |", "| ---: | --- | ---: | ---: | ---: |"]
    for i, (file, (n, ms, mx)) in enumerate(files, 1):
        lines.append("| %d | %s | %d | %s | %s |" % (i, md(file), n, fmt_ms(ms), fmt_ms(mx)))
    return lines + failed_section(stats)


def failed_section(stats):
    if not stats.failed:
        return []
    out = ["", "### Failed tests", ""]
    for name, file in stats.failed_names:
        out.append("- %s: %s" % (md(file), md(name)))
    if stats.failed > len(stats.failed_names):
        out.append("- ... and %d more" % (stats.failed - len(stats.failed_names)))
    return out


def build_json(args, stats, wall, shard):
    limit = args.timeout_minutes * 60.0 if args.timeout_minutes else None
    return {
        "schema": 1,
        "shard": shard,
        "generated_at": int(time.time()),
        "tests": stats.total,
        "passed": stats.passed,
        "failed": stats.failed,
        "skipped": stats.skipped,
        "planned": stats.planned,
        "timed": stats.timed,
        "sum_ms": stats.sum_ms,
        "wall_seconds": None if wall is None else round(wall, 3),
        "workers": stats.workers,
        "timeout_minutes": args.timeout_minutes,
        "wall_fraction": None if (wall is None or not limit) else round(wall / limit, 4),
        "files": [
            {"file": clean(f), "tests": v[0], "ms": v[1], "max_ms": v[2]}
            for f, v in sorted(stats.files.items(), key=lambda kv: (-kv[1][1], kv[0]))
        ],
        "slowest_tests": [
            {"ms": ms, "file": clean(file), "name": clean(name), "status": st}
            for ms, _s, name, file, st in sorted(stats.slow, reverse=True)
        ],
    }


def write_text(path, text, append):
    try:
        with open(path, "a" if append else "w", encoding="utf-8") as fh:
            fh.write(text)
    except (OSError, UnicodeError) as exc:
        safe_stderr("summarize-bats-timing: cannot write %s (%s)\n" % (clean(path, 200), type(exc).__name__))


def open_input(path):
    if path in (None, "-"):
        return sys.stdin
    try:
        return open(path, encoding="utf-8", errors="replace")
    except OSError:
        raise Note("No bats log was found (the test step may not have started).")


def run(args):
    shard = SHARD_RE.sub("_", args.shard or "all")[:40] or "all"
    stats = Stats(load_name_map(args.tests_dir))
    notes = []
    try:
        stream = open_input(args.log)
        try:
            consume(stream, stats)
        finally:
            if stream is not sys.stdin:
                stream.close()
    except Note as note:
        notes.append(str(note))
    wall = wall_seconds(args, stats)
    lines = render(args, stats, wall, shard, notes)
    text = "\n".join(lines) + "\n"
    if args.summary_file:
        write_text(args.summary_file, text + "\n", append=True)
    else:
        sys.stdout.write(text)
    if args.json:
        write_text(args.json, json.dumps(build_json(args, stats, wall, shard), indent=1, allow_nan=False) + "\n", append=False)
    if wall is not None and args.timeout_minutes and args.warn_fraction > 0:
        frac = wall / (args.timeout_minutes * 60.0)
        if frac >= args.warn_fraction:
            sys.stdout.write(
                "::warning title=bats suite slow::suite wall time %s is %.0f%% of the %g minute job timeout\n"
                % (fmt_secs(wall), 100.0 * frac, args.timeout_minutes)
            )


def finite_number(text):
    value = float(text)
    if not math.isfinite(value) or value < 0 or value > 1e9:
        raise ValueError(text)
    return value


class QuietParser(argparse.ArgumentParser):
    def error(self, message):
        raise Note("Invalid arguments to summarize-bats-timing; no summary produced.")


def parse_args(argv):
    default_tests = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "test", "bats")
    p = QuietParser(description="Summarize bats --timing TAP output.", allow_abbrev=False, add_help=False)
    p.add_argument("--log", default="-", help="TAP log file (default: stdin)")
    p.add_argument("--tests-dir", default=default_tests, help="directory of .bats files for file attribution")
    p.add_argument("--timeout-minutes", type=finite_number, default=None, help="job timeout, for the margin")
    p.add_argument("--warn-fraction", type=finite_number, default=0.7, help="emit ::warning at this fraction of the timeout (0 disables)")
    p.add_argument("--wall-seconds", type=finite_number, default=None, help="explicit suite wall time")
    p.add_argument("--start-epoch-file", default=None, help="file with the suite start epoch; the log mtime is the end")
    p.add_argument("--summary-file", default=None, help="append Markdown here (e.g. $GITHUB_STEP_SUMMARY); default stdout")
    p.add_argument("--json", default=None, help="write the machine-readable record here")
    p.add_argument("--shard", default=os.environ.get("ACQ_SHARD_ID") or "all", help="shard label (default $ACQ_SHARD_ID or 'all')")
    return p.parse_args(argv)


def safe_stderr(text):
    try:
        sys.stderr.write(text)
    except Exception:
        pass


def fallback_note(summary_file, text):
    note = "## bats timing\n\n%s\n" % text
    if summary_file:
        write_text(summary_file, note + "\n", append=True)
    else:
        try:
            sys.stdout.write(note)
        except Exception:
            pass


def argv_value(argv, flag):
    for i, item in enumerate(argv[:-1]):
        if item == flag:
            return argv[i + 1]
    return None


def main(argv):
    for stream in (sys.stdout, sys.stdin):
        try:
            stream.reconfigure(encoding="utf-8", errors="replace")
        except Exception:
            pass
    try:
        run(parse_args(argv))
    except Note as note:
        fallback_note(argv_value(argv, "--summary-file"), str(note))
    except BaseException as exc:  # advisory tool: never fail the job
        safe_stderr("summarize-bats-timing: internal error (%s)\n" % type(exc).__name__)
        fallback_note(
            argv_value(argv, "--summary-file"),
            "The timing summary could not be produced (%s)." % type(exc).__name__,
        )
    try:
        sys.stdout.flush()
    except Exception:
        pass
    return 0


if __name__ == "__main__":
    code = main(sys.argv[1:])
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.flush()
        except Exception:
            pass
    os._exit(code)
