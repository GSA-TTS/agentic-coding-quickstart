#!/usr/bin/env bash
# verify-ports-live — live end-to-end check for the ADR-0015 post-hoc port
# publish path on the msb backend (`acq ports <sandbox> --publish H:G` via
# `msb ssh serve` + OpenSSH `-L`). This is the one path scripts/verify-backends
# does NOT exercise. Requires a KVM-capable host with msb + acq (this cannot run
# inside a sandbox).
#
# It is self-contained and idempotent: it stands up a throwaway sandbox, starts a
# guest listener (auto-detecting whatever HTTP-ish server the base image has),
# runs a HAPPY-PATH publish + a NEGATIVE (host-port-in-use) publish that must
# fail closed, verifies teardown, and always cleans up.
#
# Usage:
#   ./scripts/verify-ports-live [SANDBOX_NAME] [GUEST_PORT] [HOST_PORT] [BUSY_HOST_PORT]
# Defaults: s2verify 3000 18080 18081
set -u

SANDBOX="${1:-s2verify}"
GPORT="${2:-3000}"
HPORT="${3:-18080}"
BUSY="${4:-18081}"

SCRIPT_DIR=$(cd "$(dirname "$0")/.." && pwd)
ACQ="$SCRIPT_DIR/acq"
BE=(--backend msb)

PASS=0; FAIL=0
ok()   { PASS=$((PASS+1)); printf '  \033[32mok  \033[0m %s\n' "$1"; }
bad()  { FAIL=$((FAIL+1)); printf '  \033[31mBAD \033[0m %s\n' "$1"; [ -n "${2:-}" ] && printf '        %s\n' "$2"; }
info() { printf '\n== %s ==\n' "$1"; }

OCC_PID=""
cleanup() {
  info "cleanup"
  [ -n "$OCC_PID" ] && kill "$OCC_PID" 2>/dev/null || true
  "$ACQ" "${BE[@]}" rm "$SANDBOX" >/dev/null 2>&1 && echo "  removed sandbox $SANDBOX" || true
}
trap cleanup EXIT INT TERM

# --- 0. Preconditions ------------------------------------------------------
info "preconditions"
command -v msb >/dev/null 2>&1 && ok "msb on PATH ($(msb --version 2>/dev/null | head -1))" || { bad "msb not on PATH"; exit 1; }
# Virtualization backend differs by host: Linux uses /dev/kvm; macOS uses the
# Virtualization.framework (no device node). Only flag a MISSING accelerator on
# Linux — on macOS, `msb` handles virtualization itself, so absence of /dev/kvm
# is expected and not an error.
case "$(uname -s)" in
  Linux)
    [ -e /dev/kvm ] && ok "/dev/kvm present (Linux KVM)" || bad "/dev/kvm absent (msb create will likely fail on Linux)" ;;
  Darwin)
    ok "macOS host — msb uses Virtualization.framework (no /dev/kvm expected)" ;;
  *)
    ok "$(uname -s) host — assuming msb provides its own virtualization" ;;
esac
command -v ssh >/dev/null 2>&1 && ok "ssh on PATH (needed for -L)" || bad "ssh missing"
command -v curl >/dev/null 2>&1 && ok "curl on PATH (host-side probe)" || bad "curl missing"

# Fresh start: remove any stale sandbox of this name.
"$ACQ" "${BE[@]}" rm "$SANDBOX" >/dev/null 2>&1 || true

# --- 1. Create the sandbox -------------------------------------------------
info "create sandbox ($SANDBOX)"
# Non-interactive: decline the github-scope prompt by feeding "N" on stdin.
if printf 'N\n' | "$ACQ" "${BE[@]}" create opencode --name "$SANDBOX" >/tmp/acq-create.log 2>&1; then
  ok "acq create returned 0"
else
  bad "acq create failed" "$(tail -3 /tmp/acq-create.log)"; exit 1
fi
if msb ls 2>/dev/null | grep -q "$SANDBOX"; then ok "sandbox is listed/running"; else bad "sandbox not listed"; exit 1; fi

# --- 2. Start a guest listener on GPORT (auto-detect a server tool) --------
info "start guest listener on 127.0.0.1:$GPORT"
# Try, in order: python3, python2, busybox httpd, nc loop. Detached via nohup so
# it outlives the exec. Report which tool won, and confirm the port is LISTENING.
listen_probe=$("$ACQ" "${BE[@]}" exec "$SANDBOX" -- sh -lc '
  gp='"$GPORT"'
  start_ok=""
  # Bind to 0.0.0.0 (not just 127.0.0.1): `msb ssh serve` + `ssh -L` resolve the
  # forward destination inside the guest, and binding all interfaces is the most
  # portable across the http server tools below (python2 SimpleHTTPServer cannot
  # bind-select at all). Loopback-only exposure is still enforced on the HOST end.
  if command -v python3 >/dev/null 2>&1; then
    nohup python3 -u -m http.server "$gp" --bind 0.0.0.0 >/tmp/srv.log 2>&1 &
    start_ok="python3"
  elif command -v python >/dev/null 2>&1; then
    nohup python -u -m SimpleHTTPServer "$gp" >/tmp/srv.log 2>&1 &
    start_ok="python2"
  elif command -v busybox >/dev/null 2>&1; then
    mkdir -p /tmp/webroot; printf ok > /tmp/webroot/index.html
    nohup busybox httpd -f -p "$gp" -h /tmp/webroot >/tmp/srv.log 2>&1 &
    start_ok="busybox-httpd"
  elif command -v nc >/dev/null 2>&1; then
    nohup sh -c "while :; do printf \"HTTP/1.1 200 OK\r\nContent-Length:2\r\n\r\nok\" | nc -l -p $gp; done" >/tmp/srv.log 2>&1 &
    start_ok="nc-loop"
  else
    echo "TOOL=none"; exit 0
  fi
  srv_pid=$!
  echo "TOOL=$start_ok"
  # Wait up to ~8s for the port to actually accept a connection. Probe by several
  # methods since a minimal guest may lack ss/netstat: (1) ss, (2) netstat,
  # (3) a real HTTP GET via curl or wget, (4) /proc/net/tcp hex-port match.
  hexp=$(printf "%04X" "$gp")
  i=0; up=""
  while [ "$i" -lt 16 ]; do
    if command -v ss >/dev/null 2>&1 && ss -ltn 2>/dev/null | grep -q "[:.]$gp[^0-9]"; then up="ss"; break; fi
    if command -v netstat >/dev/null 2>&1 && netstat -ltn 2>/dev/null | grep -q "[:.]$gp[^0-9]"; then up="netstat"; break; fi
    if command -v curl >/dev/null 2>&1 && curl -sS -m 2 "http://127.0.0.1:$gp/" >/dev/null 2>&1; then up="curl"; break; fi
    if command -v wget >/dev/null 2>&1 && wget -q -T 2 -O /dev/null "http://127.0.0.1:$gp/" 2>/dev/null; then up="wget"; break; fi
    if [ -r /proc/net/tcp ] && awk "{print \$2}" /proc/net/tcp 2>/dev/null | grep -qi ":$hexp\$"; then up="proc"; break; fi
    # If the server process already died, stop waiting and surface why.
    kill -0 "$srv_pid" 2>/dev/null || { up=""; break; }
    i=$((i+1)); sleep 0.5
  done
  if [ -n "$up" ]; then
    echo "LISTENING=yes (via $up)"
  else
    echo "LISTENING=no"
    kill -0 "$srv_pid" 2>/dev/null && echo "server-proc: still alive (probe tools may be absent)" || echo "server-proc: EXITED"
    echo "have: ss=$(command -v ss >/dev/null 2>&1 && echo y || echo n) netstat=$(command -v netstat >/dev/null 2>&1 && echo y || echo n) curl=$(command -v curl >/dev/null 2>&1 && echo y || echo n) wget=$(command -v wget >/dev/null 2>&1 && echo y || echo n) proc=$([ -r /proc/net/tcp ] && echo y || echo n)"
    echo "---srv.log---"; tail -10 /tmp/srv.log 2>/dev/null
  fi
' 2>&1)
printf '%s\n' "$listen_probe" | sed 's/^/    | /'
_tool=$(printf '%s\n' "$listen_probe" | sed -n 's/^TOOL=//p' | tr -d '\r')
case "$_tool" in
  none|"") bad "no HTTP server tool in the base image (python3/python/busybox/nc all absent)" \
             "install one in the image, or pass a base image that has python3, then re-run"; exit 1 ;;
  *)       ok "guest listener started via $_tool" ;;
esac
printf '%s\n' "$listen_probe" | grep -q "LISTENING=yes" \
  && ok "guest port $GPORT is LISTENING" \
  || { bad "guest port $GPORT never came up"; exit 1; }
# --- 3. HAPPY PATH: publish GPORT -> host HPORT ----------------------------
info "HAPPY PATH: acq ports --publish $HPORT:$GPORT"
pub_out=$("$ACQ" "${BE[@]}" ports "$SANDBOX" --publish "$HPORT:$GPORT" 2>&1); pub_rc=$?
printf '%s\n' "$pub_out" | sed 's/^/    | /'
[ "$pub_rc" -eq 0 ] && ok "publish returned 0" || bad "publish returned $pub_rc"
printf '%s\n' "$pub_out" | grep -q "published host" && ok "printed 'published host' success line" || bad "no 'published host' line"
sleep 1
if curl -sS -m 5 "http://127.0.0.1:$HPORT/" >/tmp/curl.out 2>/tmp/curl.err; then
  ok "HOST reached guest :$GPORT through the tunnel (curl 127.0.0.1:$HPORT ok)"
else
  bad "host could not reach the tunnel" "$(cat /tmp/curl.err)"
fi

# --- 4. LIST mode reflects the mapping -------------------------------------
info "LIST: acq ports $SANDBOX"
list_out=$("$ACQ" "${BE[@]}" ports "$SANDBOX" 2>&1); list_rc=$?
printf '%s\n' "$list_out" | sed 's/^/    | /'
[ "$list_rc" -eq 0 ] && ok "list returned 0 (query, not error)" || bad "list returned $list_rc"

# --- 5. NEGATIVE (the S2 fix): host port already in use must FAIL closed ----
info "NEGATIVE: publish to a host port already in use ($BUSY) must fail closed"
# Occupy BUSY on the host so the ssh -L bind fails (ExitOnForwardFailure).
if command -v python3 >/dev/null 2>&1; then
  python3 -m http.server "$BUSY" --bind 127.0.0.1 >/dev/null 2>&1 &
  OCC_PID=$!
else
  # Fallback occupier: nc listener.
  sh -c "while :; do nc -l 127.0.0.1 $BUSY >/dev/null 2>&1; done" &
  OCC_PID=$!
fi
sleep 1
neg_out=$("$ACQ" "${BE[@]}" ports "$SANDBOX" --publish "$BUSY:$GPORT" 2>&1); neg_rc=$?
printf '%s\n' "$neg_out" | sed 's/^/    | /'
[ "$neg_rc" -ne 0 ] && ok "publish to busy host port FAILED closed (rc=$neg_rc)" || bad "publish to busy host port wrongly returned 0 (S2 regression)"
printf '%s\n' "$neg_out" | grep -q "published host" && bad "printed 'published host' for a dead tunnel (S2 regression)" || ok "no false 'published host' for the dead tunnel"
kill "$OCC_PID" 2>/dev/null || true; OCC_PID=""

# --- 6. Teardown removes the serve/ssh pair --------------------------------
info "teardown: acq stop tears the tunnel down"
"$ACQ" "${BE[@]}" stop "$SANDBOX" >/tmp/acq-stop.log 2>&1 || true
sleep 1
if curl -sS -m 3 "http://127.0.0.1:$HPORT/" >/dev/null 2>&1; then
  bad "tunnel still reachable after stop (teardown did not kill the forward)"
else
  ok "tunnel is gone after stop (teardown killed serve+ssh)"
fi

# --- Summary ---------------------------------------------------------------
printf '\n  passed: %d   failed: %d\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
