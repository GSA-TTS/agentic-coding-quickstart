#!/bin/sh
# Build the enumerated offline archive without publishing anything (ADR-0042m).
set -eu
[ "$#" -eq 5 ] || { echo 'usage: assemble-release <platform-key> <runtime-archive> <runtime-sha256> <wheelhouse-dir> <out-dir>' >&2; exit 1; }
repo_root="$(cd "$(dirname "$0")/.." && pwd)"
python3 -I - "$repo_root" "$@" <<'PY'
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tarfile
import tempfile
import zipfile

repo = Path(sys.argv[1])
platform, runtime, digest, wheels, out = sys.argv[2:]
spec = json.loads((repo / 'installer/assets.json').read_text())['platforms'][platform]
wheels, out = Path(wheels).resolve(), Path(out).resolve()
if not wheels.is_dir() or not list(wheels.glob('*.whl')) or not (wheels / 'SHA256SUMS').is_file():
    sys.exit('wheelhouse must contain wheels and SHA256SUMS')
out.mkdir(parents=True, exist_ok=True)
archive = out / spec['archive']
if archive.exists():
    sys.exit(f'{archive} already exists; refusing to overwrite')
version = os.environ.get('ACQ_BUILD_VERSION') or json.loads((repo / 'package.json').read_text())['version']
revision = os.environ.get('ACQ_BUILD_REVISION') or subprocess.check_output(
    ['git', '-C', str(repo), 'rev-parse', 'HEAD'], text=True).strip()
with tempfile.TemporaryDirectory(prefix='.assemble-', dir=out) as tmp:
    tree = Path(tmp) / 'tree'
    tree.mkdir()
    stage = 'stage-windows-runtime' if spec['format'] == 'zip' else 'stage-posix-runtime'
    subprocess.run(['sh', str(repo / 'scripts' / stage), str(Path(runtime).resolve()), digest, str(tree)], check=True)
    for name in [*spec['components']['launchers'], 'LICENSE', 'README.md']:
        shutil.copy2(repo / name, tree / name)
    shutil.copytree(repo / 'acq.backends', tree / 'acq.backends')
    shutil.copytree(wheels, tree / 'wheelhouse')
    (tree / 'py-acq/src/acq_py/_build_info.py').write_text(
        f'# Generated release identity (ADR-0042m).\nACQ_VERSION = {version!r}\nSOURCE_REVISION = {revision!r}\n',
        encoding='utf-8')
    packed = Path(tmp) / spec['archive']
    if spec['format'] == 'zip':
        with zipfile.ZipFile(packed, 'w', zipfile.ZIP_DEFLATED) as zf:
            for path in sorted(tree.rglob('*')):
                zf.write(path, path.relative_to(tree).as_posix())
    elif spec['format'] == 'tar.gz':
        with tarfile.open(packed, 'w:gz') as tf:
            for path in sorted(tree.iterdir()):
                tf.add(path, arcname=path.name)
    else:
        sys.exit('unsupported archive format')
    packed.rename(archive)
print(archive)
PY
