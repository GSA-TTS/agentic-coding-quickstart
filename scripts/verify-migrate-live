#!/usr/bin/env bash
#
# verify-migrate-live — HOST-SIDE end-to-end check for qsbx's IN-PLACE healing of
# a pre-kit sandbox. Unlike scripts/test-migrate-or-halt (which stubs sbx and
# runs anywhere), this exercises the REAL toolchain and therefore must run on a
# machine that can create sandboxes (Docker + KVM, `sbx login` done) with
# sbx >= 0.35.0.
#
# It proves the claim behind ADR-0009: when qsbx meets an existing sandbox that
# predates the kit migration (no USAi provider config), it heals it IN PLACE with
# `sbx kit add` — which on sbx 0.35.0 recreates the sandbox container with the
# added kit while PRESERVING state — ending up with a WORKING USAi provider and
# the sandbox's prior state intact. No export/rm/recreate/import dance.
#
# What it does (all on a throwaway sandbox named qsbx-heal-verify-<pid>):
#   1. Require sbx >= 0.35.0 (the floor qsbx enforces; healing needs it).
#   2. Create a "pre-kit" sandbox WITHOUT the kits (plain `sbx create opencode`),
#      so it has no USAi provider config — the condition ensure_kit_applied
#      targets.
#   3. Drop a state marker file in the sandbox so we can prove state survived the
#      kit-add recreate.
#   4. Confirm the pre-state: USAi kit config absent, marker present.
#   5. Run `qsbx run opencode <dir>`, which heals in place (no prompt).
#   6. Assert post-state: the USAi kit is applied (its config landed at OpenCode's
#      global path), OpenCode resolves a USAi model, and the state marker survived.
#   7. Clean up the throwaway sandbox (always, via trap).
#
# Usage:
#   ./scripts/verify-migrate-live [WORKDIR]
#     WORKDIR  optional path to use as the sandbox workspace (default: a temp
#              git repo created under $TMPDIR). Must be a directory.
#
# Exit 0 = in-place healing verified end-to-end. Non-zero = a step failed
# (details on stderr). READ-mostly on your environment except for the one
# throwaway sandbox it creates and removes.

set -uo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)
QSBX="$REPO_ROOT/qsbx"

SANDBOX="qsbx-heal-verify-$$"
# Absolute path where the usai-provider kit STAGES its OpenCode config (the merge
# SOURCE). qsbx keys its pre-kit detection off this staged file
# (USAI_KIT_CONFIG_PATH), so the pre-state probe here mirrors it.
KIT_CFG="/home/agent/usai-config/opencode.jsonc"
# Absolute path OpenCode actually reads. The kit's startup merge lands its config
# here. This is the authoritative post-healing artifact.
GLOBAL_CFG="/home/agent/.config/opencode/opencode.jsonc"
# A state marker we plant BEFORE healing and check AFTER, to prove `sbx kit add`
# preserved sandbox state across its container recreate.
STATE_MARKER="/home/agent/.qsbx-heal-verify-marker"
WORKDIR="${1:-}"
MADE_WORKDIR=0
PASS=0
FAIL=0

info() { printf '\n\033[1m==> %s\033[0m\n' "$1"; }
ok()   { PASS=$((PASS + 1)); printf '  \033[32mok\033[0m   %s\n' "$1"; }
bad()  { FAIL=$((FAIL + 1)); printf '  \033[31mFAIL\033[0m %s\n' "$1"; [ -n "${2:-}" ] && printf '        %s\n' "$2"; }

# Run a snippet in the sandbox, retrying on the transient "inspect exec: context
# deadline exceeded" that sbx emits right after a sandbox (re)starts. Echoes
# stdout; returns the snippet's exit status on the last attempt.
sbx_exec_retry() {
  local name="$1" snippet="$2" out rc tries=0
  while [ "$tries" -lt 5 ]; do
    tries=$((tries + 1))
    out=$(sbx exec "$name" -- sh -c "$snippet" </dev/null 2>/dev/null)
    rc=$?
    [ "$rc" -eq 0 ] && { printf '%s' "$out"; return 0; }
    sleep 2
  done
  printf '%s' "$out"
  return "$rc"
}

# Wait until `sbx exec` works in the sandbox (up to READY_TIMEOUT seconds).
READY_TIMEOUT="${QSBX_EXEC_READY_TIMEOUT:-60}"
wait_ready() {
  local name="$1" deadline
  deadline=$(( $(date +%s) + READY_TIMEOUT ))
  while :; do
    sbx exec "$name" -- sh -c 'echo ok' </dev/null 2>/dev/null | grep -Fxq ok && return 0
    [ "$(date +%s)" -ge "$deadline" ] && return 1
    sleep 2
  done
}

cleanup() {
  info "Cleanup"
  if [ "${KEEP:-0}" = "1" ]; then
    echo "  KEEP=1 set — leaving sandbox '$SANDBOX' and workspace '$WORKDIR' in place." >&2
    echo "  Inspect with:  sbx exec $SANDBOX -- sh -c 'ls -la /home/agent/.config/opencode /home/agent/usai-config'" >&2
    echo "  Remove later:  sbx rm --force $SANDBOX" >&2
    return
  fi
  if sbx ls -q 2>/dev/null | grep -Fxq -- "$SANDBOX"; then
    echo "  removing throwaway sandbox '$SANDBOX'..."
    sbx rm --force "$SANDBOX" >/dev/null 2>&1 || echo "  (could not remove '$SANDBOX'; remove it manually)" >&2
  fi
  if [ "$MADE_WORKDIR" = "1" ] && [ -n "$WORKDIR" ]; then
    rm -rf "$WORKDIR"
  fi
}
trap cleanup EXIT

# --- Preflight --------------------------------------------------------------
info "Preflight"
command -v sbx >/dev/null   || { echo "sbx not on PATH — run this on the host, not in a sandbox." >&2; exit 2; }
command -v qsbx >/dev/null || [ -x "$QSBX" ] || { echo "qsbx not found at $QSBX" >&2; exit 2; }
[ -x "$QSBX" ] || QSBX="$(command -v qsbx)"

# In-place healing needs sbx >= 0.35.0 (state-preserving `sbx kit add`). Bail
# early with a clear message rather than failing mid-run on an older sbx.
sbx_ver=$(sbx version 2>/dev/null | grep -oE 'v?[0-9]+\.[0-9]+(\.[0-9]+)?' | head -n1 | sed 's/^v//')
case "$sbx_ver" in
  "") echo "  (warning: could not determine sbx version; expecting >= 0.35.0)" >&2 ;;
  *)
    # Reuse a tiny numeric compare: major/minor/patch.
    IFS='.' read -r _a _b _c <<EOF
$sbx_ver
EOF
    if [ "${_a:-0}" -eq 0 ] && [ "${_b:-0}" -lt 35 ]; then
      echo "This check requires sbx >= 0.35.0 (state-preserving 'sbx kit add'); found $sbx_ver." >&2
      echo "Upgrade sbx and retry." >&2
      exit 2
    fi
    echo "  sbx version: $sbx_ver"
    ;;
esac

if sbx ls -q 2>/dev/null | grep -Fxq -- "$SANDBOX"; then
  echo "A sandbox named '$SANDBOX' already exists; refusing to clobber it." >&2
  exit 2
fi

if [ -z "$WORKDIR" ]; then
  WORKDIR=$(mktemp -d "${TMPDIR:-/tmp}/qsbx-heal-verify.XXXXXX") || exit 2
  MADE_WORKDIR=1
  ( cd "$WORKDIR" && git init -q && git commit -q --allow-empty -m "seed" ) 2>/dev/null || true
  echo "  using temp workspace: $WORKDIR"
else
  [ -d "$WORKDIR" ] || { echo "WORKDIR '$WORKDIR' is not a directory" >&2; exit 2; }
  echo "  using provided workspace: $WORKDIR"
fi

# --- 1) Create a pre-kit sandbox (no kits => no USAi provider config) --------
info "1) Creating a pre-kit sandbox WITHOUT kits: $SANDBOX"
if sbx create --name "$SANDBOX" opencode "$WORKDIR" >/dev/null 2>&1; then
  ok "created pre-kit sandbox"
else
  bad "could not create pre-kit sandbox" "check 'sbx login' and Docker/KVM"
  exit 1
fi
wait_ready "$SANDBOX" || { bad "sandbox never became exec-ready" "increase QSBX_EXEC_READY_TIMEOUT"; exit 1; }

# --- 2) Plant a state marker so we can prove state survives the kit-add recreate
info "2) Planting a state marker in the pre-kit sandbox"
if sbx_exec_retry "$SANDBOX" "printf 'heal-verify-%s\n' '$$' > '$STATE_MARKER' && test -f '$STATE_MARKER'" >/dev/null; then
  ok "state marker written at $STATE_MARKER"
else
  bad "could not write state marker" "sbx exec may be failing; cannot prove state preservation"
fi

# --- 3) Confirm the pre-state: USAi kit config absent, marker present --------
info "3) Confirming pre-state (USAi config absent)"
pre_cfg=$(sbx_exec_retry "$SANDBOX" "test -f '$KIT_CFG' && echo yes" || true)
if [ "$pre_cfg" != "yes" ]; then
  ok "USAi kit config absent (this is a genuine pre-kit sandbox)"
else
  bad "USAi kit config already present" "not a pre-kit sandbox; healing path won't trigger"
fi

# --- 4) Run qsbx; it heals in place with `sbx kit add` (no prompt) -----------
info "4) Running qsbx to heal the sandbox in place"
echo "  (qsbx detects the missing kit and runs 'sbx kit add', which recreates the sandbox preserving state)"
# Target the throwaway sandbox by name so qsbx resolves to IT (the AGENT form
# would derive a name from the workspace basename). Feed newline in case any
# advisory prompt appears; healing itself is non-interactive.
if printf '\n' | QSBX_PROMPT_STDIN=1 "$QSBX" run --name "$SANDBOX" opencode "$WORKDIR"; then
  ok "qsbx run completed"
else
  echo "  (qsbx run returned non-zero — likely the interactive attach exiting; continuing to assert post-state)" >&2
fi

# --- 5) Assert post-state ----------------------------------------------------
info "5) Asserting post-state (working USAi + state preserved)"
echo "  (waiting for the healed sandbox to become exec-ready...)"
wait_ready "$SANDBOX" || echo "  (warning: sandbox not exec-ready within ${READY_TIMEOUT}s; probes may be unreliable)" >&2

cfg_present=$(sbx_exec_retry "$SANDBOX" "test -f '$GLOBAL_CFG' && echo yes" || true)
usai_in_cfg=$(sbx_exec_retry "$SANDBOX" "grep -q '\"usai\"' '$GLOBAL_CFG' 2>/dev/null && echo yes" || true)
if [ "$cfg_present" = "yes" ] && [ "$usai_in_cfg" = "yes" ]; then
  ok "usai-provider kit applied in place (USAi provider present in global config at $GLOBAL_CFG)"
elif [ "$cfg_present" = "yes" ]; then
  bad "global config present but USAi provider missing" "kit merge may have failed"
else
  bad "global OpenCode config missing at $GLOBAL_CFG" "the usai-provider kit did not apply"
fi

# The key claim of ADR-0009: `sbx kit add` PRESERVED state across its recreate.
marker_present=$(sbx_exec_retry "$SANDBOX" "test -f '$STATE_MARKER' && echo yes" || true)
if [ "$marker_present" = "yes" ]; then
  ok "sandbox state preserved across 'sbx kit add' (marker survived)"
else
  bad "state marker missing after healing" "'sbx kit add' did not preserve state — expected on sbx >= 0.35.0"
fi

# Corroboration: the kit stages its source config at KIT_CFG. Informational.
staged_present=$(sbx_exec_retry "$SANDBOX" "test -f '$KIT_CFG' && echo yes" || true)
if [ "$staged_present" = "yes" ]; then
  ok "kit staging source present at $KIT_CFG"
else
  echo "  (note: staged source '$KIT_CFG' absent; the global config check above is authoritative)" >&2
fi

# NOTE: we deliberately do NOT probe the USAi HTTP endpoint with USAI_API_KEY as
# a success signal — the secret proxy injects USAI_API_KEY independently of any
# kit, so curl … /models returns 200 even where the kit never applied. The
# authoritative signal is the global config carrying the USAi provider (above).
# As functional corroboration, confirm OpenCode itself resolves the USAi provider.
usai_models=$(sbx_exec_retry "$SANDBOX" 'opencode models 2>/dev/null | grep -i usai | head -1' || true)
if [ -n "$usai_models" ]; then
  ok "OpenCode resolves a USAi model ($usai_models)"
else
  echo "  (note: could not confirm a USAi model via 'opencode models'; the config-file check above is authoritative)" >&2
fi

# Diagnostic dump when the config check failed, or always under KEEP=1.
if [ "$cfg_present" != "yes" ] || [ "${KEEP:-0}" = "1" ]; then
  info "Diagnostics (kit artifact locations)"
  echo "  --- ls -la /home/agent/.config/opencode (global config dir) ---" >&2
  sbx_exec_retry "$SANDBOX" 'ls -la /home/agent/.config/opencode 2>&1 || echo "(missing)"' >&2 || true
  echo "  --- ls -la /home/agent/usai-config (kit staging dir) ---" >&2
  sbx_exec_retry "$SANDBOX" 'ls -la /home/agent/usai-config 2>&1 || echo "(missing)"' >&2 || true
  echo "  --- any opencode.jsonc under /home/agent ---" >&2
  sbx_exec_retry "$SANDBOX" 'find /home/agent -name "opencode.json*" 2>/dev/null || echo "(none)"' >&2 || true
  echo "" >&2
fi

# --- Summary ----------------------------------------------------------------
info "Summary"
printf '  passed: %d   failed: %d\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
