#!/usr/bin/env bash
#
# test-py-acq-sharded — run the complete py-acq pytest suite in CI-equivalent,
# whole-file shards.  Give pytest arguments to run one focused test or file
# instead; focused invocations deliberately do not add sharding.
#
# The CI plugin (scripts.pytest_shard) derives the partition from the collected
# files, so a newly collected test file joins exactly one shard without a table
# update.  Each shard's output is buffered and replayed by shard number after
# every child exits, keeping concurrent diagnostics readable.
#
# Usage:
#   scripts/test-py-acq-sharded
#   ACQ_PYTEST_JOBS=2 scripts/test-py-acq-sharded
#   scripts/test-py-acq-sharded py-acq/tests/test_cli.py -k version
#
# Bash 3.2 compatible: do not use wait -n, mapfile, or associative arrays.
set -uo pipefail

_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_root="$(cd "${_dir}/.." && pwd)"
_python="${ACQ_PYTEST_PYTHON:-python3}"

_require_ci_evidence() {
  "$_python" -c 'import sys; raise SystemExit(sys.version_info[:2] != (3, 12))' || {
    echo 'test-py-acq-sharded: BLOCKED: need Python 3.12 (the Python-vectors CI runtime)' >&2
    return 2
  }
  command -v setsid >/dev/null 2>&1 || {
    echo 'test-py-acq-sharded: BLOCKED: setsid is required for bounded shard cleanup' >&2
    return 2
  }
  _patterns="${ACQ_TEST_PATTERNS_REPO:-}"
  [ -n "$_patterns" ] && [ -d "$_patterns/.git" ] || {
    echo 'test-py-acq-sharded: BLOCKED: set ACQ_TEST_PATTERNS_REPO to the pinned Patterns checkout' >&2
    return 2
  }
  _pin="$(sed -n 's/^PATTERNS_KIT_REF="\([0-9a-f]\{40\}\)"$/\1/p' "$_root/acq.backends/common.sh")"
  [ -n "$_pin" ] && [ "$(git -C "$_patterns" rev-parse HEAD 2>/dev/null)" = "$_pin" ] \
    && test -z "$(git -C "$_patterns" status --porcelain 2>/dev/null)" || {
    echo 'test-py-acq-sharded: BLOCKED: Patterns checkout is not the clean pinned ref' >&2
    return 2
  }
}

# Focused pytest is intentionally direct: it is the fast bug-loop interface.
if [ "$#" -gt 0 ]; then
  exec "$_python" -m pytest "$@"
fi

_require_ci_evidence || exit $?

_shards="${ACQ_PYTEST_SHARDS:-4}"
_jobs="${ACQ_PYTEST_JOBS:-$( (command -v nproc >/dev/null 2>&1 && nproc) || sysctl -n hw.ncpu 2>/dev/null || echo 1 )}"
for _value in "$_shards" "$_jobs"; do
  case "$_value" in
    ''|*[!0-9]*|0*)
      echo 'test-py-acq-sharded: shard and worker counts must be positive integers without leading zeros' >&2
      exit 2
      ;;
  esac
  if ! [ "$_value" -ge 1 ] 2>/dev/null; then
    echo 'test-py-acq-sharded: shard or worker count exceeds the supported integer range' >&2
    exit 2
  fi
done

if [ "$_jobs" -gt "$_shards" ]; then
  _jobs="$_shards"
fi

case "${TMPDIR:-}" in /*) _tmp_base="$TMPDIR" ;; *) _tmp_base=/tmp ;; esac
_tmp="$(mktemp -d "$_tmp_base/acq-pytest-shards.XXXXXX")" || exit 2
_pids=()
_pid_shards=()
_next=1
_active=0
_failed=0
_cleanup() {
  rm -rf "$_tmp"
}
_on_signal() {
  _status="$1"
  # A signal can land after `cmd &` but before `_start_shard` records `$!`.
  # `jobs -p` is already aware of that child, so it closes that registration
  # window. Ignore repeat signals until every known child is reaped.
  trap '' HUP INT TERM
  _signal_pids="$(jobs -p 2>/dev/null || true)"
  for _pid in $_signal_pids; do
    kill -TERM -- "-$_pid" 2>/dev/null || true
  done
  # A child that ignores TERM must not survive the interrupted runner. The
  # shard command runs in its own session, so the group kill covers descendants.
  _wait=0
  while [ "$_wait" -lt 5 ]; do
    _alive=0
    for _pid in $_signal_pids; do kill -0 -- "-$_pid" 2>/dev/null && _alive=1; done
    [ "$_alive" -eq 0 ] && break
    sleep 1
    _wait=$((_wait + 1))
  done
  for _pid in $_signal_pids; do kill -KILL -- "-$_pid" 2>/dev/null || true; done
  for _pid in $_signal_pids; do wait "$_pid" 2>/dev/null || true; done
  trap - EXIT HUP INT TERM
  _cleanup
  exit "$_status"
}
trap _cleanup EXIT
trap '_on_signal 129' HUP
trap '_on_signal 130' INT
trap '_on_signal 143' TERM

echo "test-py-acq-sharded: ${_shards} shard(s), ${_jobs} worker(s)" >&2

_start_shard() {
  _number="$1"
  (
    cd "$_root" || exit 2
    exec setsid "$_python" -m pytest -p scripts.pytest_shard py-acq/tests \
      --acq-shard "${_number}/${_shards}" -v --tb=short -ra --show-capture=no
  ) >"$_tmp/${_number}.log" 2>&1 &
  _pids+=("$!")
  _pid_shards+=("$_number")
  _active=$((_active + 1))
}

_reap_first() {
  _pid="${_pids[0]}"
  _number="${_pid_shards[0]}"
  if ! wait "$_pid"; then
    _failed=1
  fi
  unset '_pids[0]' '_pid_shards[0]'
  _active=$((_active - 1))
  if [ "$_active" -eq 0 ]; then
    _pids=()
    _pid_shards=()
  else
    _pids=("${_pids[@]}")
    _pid_shards=("${_pid_shards[@]}")
  fi
}

while [ "$_next" -le "$_shards" ]; do
  _start_shard "$_next"
  _next=$((_next + 1))
  if [ "$_active" -ge "$_jobs" ]; then
    _reap_first
  fi
done
while [ "$_active" -gt 0 ]; do
  _reap_first
done

# A supplied checkout alone is not evidence: the tests deliberately skip their
# pinned-Patterns comparisons when their dependencies are unavailable. Never
# report a local run as CI-equivalent if any shard reports that skip reason.
if grep -q 'pinned Patterns checkout is provided' "$_tmp"/*.log; then
  echo 'test-py-acq-sharded: pinned Patterns checks were skipped; failing closed' >&2
  _failed=1
fi

_number=1
while [ "$_number" -le "$_shards" ]; do
  printf '\n===== pytest shard %s/%s =====\n' "$_number" "$_shards"
  cat "$_tmp/${_number}.log"
  _number=$((_number + 1))
done

exit "$_failed"
