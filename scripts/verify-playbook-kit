#!/usr/bin/env bash
#
# verify-playbook-kit — host-side validation for the agentic-coding-playbook kit
#
# Run this from your quickstart clone on a host where `sbx` (>= 0.34.0) is
# installed and logged in. It exercises the playbook mixin kit end to end:
# validates the spec, creates a sandbox with BOTH kits, and confirms the
# playbook cloned and its AGENTS.md + skills were linked into the agent paths.
# It also smoke-tests the offline/graceful-degradation path and qsbx parity.
#
# It is READ-MOSTLY: it creates temporary sandboxes named "pbkit-verify-*" and
# removes them at the end (and on interrupt). It does not touch your other
# sandboxes. Nothing here prints secret values.
#
# Usage:
#   ./scripts/verify-playbook-kit            # full run
#   KEEP=1 ./scripts/verify-playbook-kit     # keep the sandbox for poking around
#
# Prerequisite: while the playbook repo is private, set the GitHub secret once:
#   sbx secret set -g github

set -uo pipefail

CLONE="$(cd "$(dirname "$0")/.." && pwd)"
USAI_KIT="$CLONE/usai-opencode-provider"
PLAYBOOK_KIT="$CLONE/playbook-kit"
SBX_NAME="pbkit-verify-$$"
# Use a RELATIVE tmp/ dir under the clone (gitignored) so the workspace and the
# captured create log are available in the repo for review. Not /tmp.
WORK_ROOT="$CLONE/tmp/pbkit-verify"
WORK="$WORK_ROOT/$$"
CREATE_LOG="$WORK_ROOT/sbx-create.$$.log"
mkdir -p "$WORK"
KEEP="${KEEP:-0}"

pass=0
fail=0
ok()   { printf '  \033[32mPASS\033[0m %s\n' "$1"; pass=$((pass+1)); }
bad()  { printf '  \033[31mFAIL\033[0m %s\n' "$1"; fail=$((fail+1)); }
info() { printf '\n\033[1m%s\033[0m\n' "$1"; }

cleanup() {
  if [ "$KEEP" = "1" ]; then
    printf '\nKEEP=1 set; leaving sandbox %s and %s in place.\n' "$SBX_NAME" "$WORK" >&2
    return
  fi
  sbx rm -f "$SBX_NAME" >/dev/null 2>&1 || true
  rm -rf "$WORK" >/dev/null 2>&1 || true
  # Intentionally keep $CREATE_LOG under tmp/ so the create output is available
  # for review in the workspace even on a clean run.
}
trap cleanup EXIT INT TERM

# in_sbx CMD — run a shell snippet inside the sandbox, return its stdout.
in_sbx() { sbx exec "$SBX_NAME" -- sh -c "$1" </dev/null 2>/dev/null || true; }

info "0. Preconditions"
if ! command -v sbx >/dev/null 2>&1; then
  echo "  sbx not on PATH. Install sbx >= 0.34.0 and retry." >&2
  exit 1
fi
ver="$(sbx version 2>/dev/null | grep -oE 'v?[0-9]+\.[0-9]+(\.[0-9]+)?' | head -n1)"
echo "  sbx version: ${ver:-unknown}"
[ -f "$PLAYBOOK_KIT/spec.yaml" ] && ok "playbook-kit/spec.yaml present" || { bad "playbook-kit/spec.yaml missing (run from the clone)"; exit 1; }
if sbx secret ls 2>/dev/null | grep -q '\bgithub\b'; then
  ok "github secret is set (private-repo clone will authenticate)"
else
  echo "  NOTE: no 'github' secret found. If the playbook repo is still private," >&2
  echo "        the clone will fail (and the kit will degrade gracefully)." >&2
  echo "        Set it with: sbx secret set -g github" >&2
fi

info "1. sbx kit validate (both kits)"
if sbx kit validate "$USAI_KIT" >/dev/null 2>&1; then ok "usai-opencode-provider validates"; else bad "usai-opencode-provider failed validation"; fi
if sbx kit validate "$PLAYBOOK_KIT" >/dev/null 2>&1; then ok "agentic-coding-playbook validates"; else bad "agentic-coding-playbook failed validation"; fi

info "2. Create a sandbox with both kits"
echo "  creating $SBX_NAME (workspace $WORK)..."
echo "  capturing sbx create output to $CREATE_LOG"
if sbx create --name "$SBX_NAME" --kit "$USAI_KIT" --kit "$PLAYBOOK_KIT" opencode "$WORK" >"$CREATE_LOG" 2>&1; then
  ok "sandbox created with --kit usai-opencode-provider --kit playbook-kit"
else
  bad "sbx create with both kits failed (exit $?)"
  echo "  --- sbx create output ($CREATE_LOG) ---" >&2
  sed 's/^/  | /' "$CREATE_LOG" >&2
  echo "  ---------------------------------------" >&2
  echo "  The log above is also saved at: $CREATE_LOG" >&2
  exit 1
fi
# Startup commands run on create; give the clone a moment if needed.
sleep 2

info "3. Playbook cloned at the pinned ref?"
# Read the PLAYBOOK_REF value from the YAML (skip comment lines starting with #;
# match the indented "PLAYBOOK_REF:" key under environment.variables).
ref_expected="$(grep -E '^[[:space:]]+PLAYBOOK_REF:[[:space:]]*"' "$PLAYBOOK_KIT/spec.yaml" | head -n1 | sed -E 's/.*"([^"]+)".*/\1/')"
echo "  expected PLAYBOOK_REF: ${ref_expected:-<unknown>}"
if [ "$(in_sbx 'test -e "$HOME/.agentic-coding-playbook/.git" && echo yes')" = "yes" ]; then
  ok "playbook cloned to ~/.agentic-coding-playbook"
  ref_actual="$(in_sbx 'cd "$HOME/.agentic-coding-playbook" && git describe --tags --always 2>/dev/null')"
  echo "  checked-out ref: ${ref_actual:-<unknown>}"
  [ -n "$ref_expected" ] && [ "$ref_actual" = "$ref_expected" ] && ok "checked-out ref matches PLAYBOOK_REF" || \
    echo "  NOTE: ref mismatch or undetected — verify manually if unexpected." >&2
else
  bad "playbook NOT cloned — likely offline or missing github secret"
  echo "  Inspect: sbx exec $SBX_NAME -- sh -c 'ls -la ~/.agentic-coding-playbook' " >&2
  echo "  And:     sbx policy log $SBX_NAME   (look for blocked github.com)" >&2
fi

info "4. AGENTS.md linked into agent rules paths?"
for p in \
  ".config/opencode/AGENTS.md" \
  ".codex/AGENTS.md" \
  ".factory/AGENTS.md" \
  ".claude/CLAUDE.md" \
  ".copilot/copilot-instructions.md"; do
  if [ "$(in_sbx "test -L \"\$HOME/$p\" && test -e \"\$HOME/$p\" && echo yes")" = "yes" ]; then
    ok "~/$p -> playbook AGENTS.md"
  else
    bad "~/$p not linked (or dangling)"
  fi
done

info "5. Skills linked into skills roots?"
for r in \
  ".agents/skills" \
  ".claude/skills" \
  ".factory/skills" \
  ".cursor/skills" \
  ".copilot/skills"; do
  count="$(in_sbx "ls \"\$HOME/$r\" 2>/dev/null | wc -l | tr -d ' '")"
  resolves="$(in_sbx "for d in \"\$HOME/$r\"/*/; do [ -e \"\$d/SKILL.md\" ] && { echo yes; break; }; done")"
  if [ "${count:-0}" -gt 0 ] 2>/dev/null && [ "$resolves" = "yes" ]; then
    ok "~/$r ($count skills, a SKILL.md resolves)"
  else
    bad "~/$r empty or skills don't resolve"
  fi
done

info "6. Minimal egress (informational)"
echo "  Review the policy log; add any blocked host to caps.network.allow:"
echo "    sbx policy log $SBX_NAME"

info "7. qsbx parity (optional, manual)"
echo "  This script used raw 'sbx' to isolate the kit. To confirm the qsbx path:"
echo "    ./qsbx run opencode $WORK     # applies both kits; should match the above"

info "Summary"
printf '  %d passed, %d failed\n' "$pass" "$fail"
if [ "$fail" -eq 0 ]; then
  printf '  \033[32mAll checks passed.\033[0m\n'
else
  printf '  \033[31mSome checks failed — see notes above.\033[0m\n'
fi

info "Offline / graceful-degradation check (manual)"
cat <<'NOTE'
  To confirm the kit degrades gracefully when the clone can't run, create a
  sandbox with a deliberately bad ref and verify it still STARTS (no playbook):

    mkdir -p /tmp/pbkit-offline
    sbx create --name pbkit-offline --kit ./usai-opencode-provider --kit ./playbook-kit \
      --env PLAYBOOK_REF=does-not-exist opencode /tmp/pbkit-offline
    # expect: sandbox created; sbx exec shows NO ~/.agentic-coding-playbook/.git;
    #         a warning was printed by the startup command.
    sbx rm -f pbkit-offline; rm -rf /tmp/pbkit-offline

  (Note: --env may or may not reach startup depending on your sbx version; the
  authoritative offline test is to run with network denied, e.g. under a
  deny-all policy, and confirm the sandbox still starts.)
NOTE

[ "$fail" -eq 0 ]
