#!/usr/bin/env bash
# run-vectors — Bash runner for the language-neutral test-vector corpus
# (ADR-0043m). It consumes the same `test/vectors/**/*.json` corpus as the
# pytest runner and must agree with it on the sentinel golden set.
#
# The runner carries the "how": it drives the CLI-under-test as a subprocess,
# applies the declared normalisation transforms (exact-by-default), and compares
# against the expected result per assertion mode. It does not rewrite vectors.
#
# Usage:
#   scripts/run-vectors [--acq "python3 -m acq_py"] [--python python3] \
#                       [--vectors test/vectors] [--section NAME]
#
# Dependencies: bash (3.2+), jq (pinned in CI), GNU `timeout` (macOS: Homebrew
# coreutils, on PATH as `timeout`), sort/head/tail/od/tr (BSD or GNU), and
# python3 (for {python} and the default {acq}). Fails closed if jq or python3
# is absent.
#
# Per-vector exit codes: 0 ok, 1 skip (platform scope), 2 refused (fail closed),
# 3 fail (assertion/validation). The `negative/` section expects refusal (2).

set -euo pipefail

usage() {
  sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'
}

ACQ_CMD="python3 -m acq_py"
PYTHON_CMD="python3"
VECTORS_DIR=""
SECTION=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --acq) [ "$#" -ge 2 ] || { echo "run-vectors: --acq needs a value" >&2; exit 2; }
           ACQ_CMD="$2"; shift 2 ;;
    --python) [ "$#" -ge 2 ] || { echo "run-vectors: --python needs a value" >&2; exit 2; }
           PYTHON_CMD="$2"; shift 2 ;;
    --vectors) [ "$#" -ge 2 ] || { echo "run-vectors: --vectors needs a value" >&2; exit 2; }
           VECTORS_DIR="$2"; shift 2 ;;
    --section) [ "$#" -ge 2 ] || { echo "run-vectors: --section needs a value" >&2; exit 2; }
           SECTION="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "run-vectors: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

if [ -z "$VECTORS_DIR" ]; then
  VECTORS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/test/vectors"
fi

for tool in jq timeout; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "run-vectors: required tool '$tool' not found on PATH" >&2
    exit 2
  fi
done

# --- normalisation transforms (must mirror py-acq/tests/vector_engine.py) ----
# In-place sed without `-i`: GNU `sed -i` and BSD/macOS `sed -i ''` disagree on
# the flag's argument, so write to a temp file and move it over the original.
# Scripts passed here must also avoid GNU-only escapes such as \r.
_sed_inplace() {
  local file="$1"
  shift
  sed "$@" "$file" > "$file.tmp" && mv "$file.tmp" "$file"
}

# _replace_literal FILE NEEDLE REPLACEMENT — replace every NEEDLE in FILE with
# REPLACEMENT, as plain text. sed would read NEEDLE as a regex (a '.' in a
# temp-dir name matches any character, and a '#' ends the expression), and the
# Python runner's str.replace is literal. The file is read whole; the trailing
# 'x' keeps command substitution from dropping its final newlines.
_replace_literal() {
  local file="$1" needle="$2" repl="$3" content
  content="$(cat "$file"; printf x)"
  content="${content%x}"
  content="${content//"$needle"/$repl}"
  printf '%s' "$content" > "$file.tmp" && mv "$file.tmp" "$file"
}

# _tmpdir_root — the absolute TMPDIR without its trailing slashes (macOS's ends
# in one), or nothing when TMPDIR is unset, relative or "/". Like acq itself, a
# relative TMPDIR is ignored, and the Python runner applies the same rule.
_tmpdir_root() {
  local root="${TMPDIR:-}"
  case "$root" in /*) ;; *) return 0 ;; esac
  while [ "${root%/}" != "$root" ]; do root="${root%/}"; done
  printf '%s' "$root"
}

_apply_transform() {
  # $1 = transform name, $2 = file to transform in place
  local name="$1" file="$2" tmpdir _had_nl _size
  case "$name" in
    # The excluded characters match the Python runner's: ASCII whitespace and
    # both quotes, spelled as literal bytes ($'...') because BSD sed has no \t.
    abspath) LC_ALL=C _sed_inplace "$file" -E $'s#/[^ \t\r\v\f"\']+#<abspath>#g' ;;
    tmpdir)
      # Longest root first, as the Python runner does, so /tmp never splits a
      # TMPDIR that starts with it.
      tmpdir="$(_tmpdir_root)"
      if [ "${#tmpdir}" -gt 4 ]; then
        _replace_literal "$file" "$tmpdir" '<tmpdir>'
        _replace_literal "$file" /tmp '<tmpdir>'
      else
        _replace_literal "$file" /tmp '<tmpdir>'
        [ -z "$tmpdir" ] || _replace_literal "$file" "$tmpdir" '<tmpdir>'
      fi
      ;;
    # Only CR LF pairs: a lone CR, even one ending the output, is kept.
    crlf)    _replace_literal "$file" $'\r\n' $'\n' ;;
    timing)  LC_ALL=C _sed_inplace "$file" -E 's#[0-9]+(\.[0-9]+)?(ms|us|µs|s)#<timing>#g' ;;
    order)
      # Preserve the trailing-newline flag the Python runner tracks, and sort by
      # byte (== codepoint for UTF-8) so both runners order non-ASCII alike.
      _had_nl=0
      if [ -s "$file" ] && [ "$(tail -c 1 "$file" | od -An -v -tu1 | tr -d ' \n')" = "10" ]; then
        _had_nl=1
      fi
      LC_ALL=C sort -o "$file" "$file"
      if [ "$_had_nl" -eq 0 ] && [ -s "$file" ]; then
        # Drop the newline sort appended. `head -c -1` is GNU-only; a positive
        # byte count works with BSD/macOS head too.
        _size="$(wc -c < "$file" | tr -d ' ')"
        head -c "$((_size - 1))" "$file" > "$file.tmp" && mv "$file.tmp" "$file"
      fi
      ;;
    json)
      # Only a single JSON document is re-serialised, as Python's json.loads
      # accepts; `false` and `null` count (a bare `jq -e .` would call them
      # failures). The canonical form is compact, key-sorted and ASCII-only
      # (-a), without jq's trailing newline, so it is byte-identical to the
      # Python runner's json.dumps(sort_keys=True, separators=(',', ':')).
      if jq -e -s 'length == 1' "$file" >/dev/null 2>&1; then
        printf '%s' "$(jq -a -c -S . "$file")" > "$file.tmp" && mv "$file.tmp" "$file"
      fi
      ;;
    *) echo "run-vectors: unknown transform '$name'" >&2; exit 2 ;;
  esac
}

# Structural-subset check for the `json` assertion mode: expected must be a
# recursive subset of actual (extra fields allowed; ADR-0038m "unknown fields
# are additive"). Scalars compare by equality, not substring. The output must be
# exactly one JSON document, as for the Python runner's json.loads: without
# --slurp, jq would test each document and pass on the last.
_jq_subset() {
  local actual="$1" expected="$2"
  jq -e -s --slurpfile exp "$expected" '
    def subset($e):
      . as $a
      | if ($e | type) == "object" then
          (($a | type) == "object") and
          ([ $e | keys[] as $k | (($a | has($k)) and (($a[$k]) | subset($e[$k]))) ] | all)
        elif ($e | type) == "array" then
          (($a | type) == "array") and
          (($a | length) == ($e | length)) and
          ([ range(0; $e | length) as $i | (($a[$i]) | subset($e[$i])) ] | all)
        else
          ($a == $e)
        end;
    length == 1 and (.[0] | subset($exp[0]))
  ' "$actual" >/dev/null 2>&1
}

# _validate_vector FILE — print the first schema problem in FILE (nothing when it
# is well formed), with the same rules as the Python runner's _validate: the
# required fields, no field the schema does not define (a typo such as
# `expect.stdot` would otherwise make no assertion at all), and each stream's
# assertion, or non-empty list of assertions, with a known mode and transforms
# and a value (an absent assertion takes no transforms, and neither a contains
# nor an absent value may hold a NUL byte). invoke.fixtures and isolation.no_live_refeed are defined by
# ADR-0043m, so they pass here and are refused later.
_validate_vector() {
  jq -r '
    def unknown($allowed; $prefix):
      keys_unsorted[] | select(. as $k | $allowed | index([$k]) | not) | "unknown vector field: \($prefix)\(.)";
    def spec_problems($s):
      if type != "object" then "expect.\($s): an assertion must be an object"
      else
        unknown(["mode", "value", "normalize"]; "expect.\($s).")
        , ((.mode // "exact") as $m
           | if (["exact", "contains", "json", "absent"] | index([$m]) | not) then "expect.\($s): unknown mode \($m)"
             elif has("value") | not then "expect.\($s): value is required"
             elif $m != "json" and (.value | type) != "string" then "expect.\($s): a \($m) value must be a string"
             elif $m == "absent" and .value == "" then "expect.\($s): an absent value must not be empty"
             elif ($m == "contains" or $m == "absent") and (.value | explode | any(. == 0)) then
               "expect.\($s): a \($m) value must not contain a NUL byte"
             elif $m == "absent" and ((.normalize // []) | length) > 0 then
               "expect.\($s): an absent assertion takes no normalize transforms"
             else empty end)
        , ((.normalize // []) as $n
           | if ($n | type) != "array" then "expect.\($s): normalize must be a list"
             else $n[] | select(. as $t | ["abspath", "tmpdir", "crlf", "timing", "order", "json"] | index([$t]) | not)
                  | "expect.\($s): unknown transform \(.)" end)
      end;
    def stream_problems($s):
      .expect[$s] as $d
      | if $d == null then empty
        elif ($d | type) == "array" then
          if ($d | length) == 0 then "expect.\($s): an assertion list must not be empty"
          else $d[] | spec_problems($s) end
        else $d | spec_problems($s) end;
    if type != "object" then "a vector must be a JSON object"
    else
      [ (["schema", "id", "oracle", "tier", "invoke", "expect", "isolation", "backend", "platform"] - keys)[]
          | "missing required field: \(.)" ][0]
      // ([ (.invoke, .expect, .isolation) | select(type != "object") ] | if length > 0 then "invoke, expect and isolation must be objects" else null end)
      // [ unknown(["schema", "id", "oracle", "tier", "invoke", "expect", "isolation", "backend", "platform"]; "")
         , (.invoke | unknown(["argv", "env", "unset", "stdin", "timeout_ms", "fixtures"]; "invoke."))
         , (.expect | unknown(["exit", "stdout", "stderr"]; "expect."))
         , (.isolation | unknown(["offline", "ssh_stubs", "redirect", "no_live_refeed"]; "isolation."))
         ][0]
      // (if (.invoke | has("argv")) | not then "missing required field: invoke.argv"
          elif (.expect | has("exit")) | not then "missing required field: expect.exit"
          else null end)
      // ([ ("stdout", "stderr") as $s | stream_problems($s) ][0])
      // empty
    end
  ' "$1" 2>/dev/null || printf 'not readable as JSON\n'
}

# --- run one vector ---------------------------------------------------------
_run_vector() {
  local vecfile="$1" outdir="$2"
  local vid platform backend problem
  local -a cmd=() unset_list=() env_list=() redirect_list=()

  vid="$(jq -r '.id' "$vecfile" 2>/dev/null)" || vid="$vecfile"

  # Structural validation (fail closed): an invalid vector is reported as such,
  # never run with part of its assertions ignored.
  problem="$(_validate_vector "$vecfile")"
  if [ -n "$problem" ]; then
    printf 'FAIL %s (invalid vector: %s)\n' "$vid" "$problem"
    return 3
  fi

  platform="$(jq -r '.platform' "$vecfile")"
  backend="$(jq -r '.backend' "$vecfile")"

  # Enumerated-but-unimplemented fields: fail closed, never silently ignored.
  if jq -e '.invoke | has("fixtures")' "$vecfile" >/dev/null 2>&1; then
    printf 'refused %s (unsupported_vector_field: invoke.fixtures)\n' "$vid"
    return 2
  fi
  if jq -e '.isolation | has("no_live_refeed")' "$vecfile" >/dev/null 2>&1; then
    printf 'refused %s (unsupported_vector_field: isolation.no_live_refeed)\n' "$vid"
    return 2
  fi

  # Platform scope (ADR-0043m): skip, never fail, on a mismatched platform.
  case "$platform" in
    any|all) : ;;
    *)
      local host
      host="$(uname -s | tr '[:upper:]' '[:lower:]')"
      [ "$host" = "darwin" ] && host="macos"
      if [ "$platform" != "$host" ]; then
        printf 'skip %s (platform %s)\n' "$vid" "$platform"
        return 1
      fi
      ;;
  esac

  # Isolation / backend requirements: fail closed (ADR-0043m, ADR-0040m).
  if [ -n "$backend" ] && [ "$backend" != "null" ]; then
    printf 'refused %s (unsupported_backend: %s)\n' "$vid" "$backend"
    return 2
  fi
  if [ "$(jq -r '.isolation.offline' "$vecfile")" = "false" ]; then
    printf 'refused %s (unsupported_isolation: offline=false)\n' "$vid"
    return 2
  fi
  if [ "$(jq -r '.isolation.ssh_stubs' "$vecfile")" = "true" ]; then
    printf 'refused %s (unsupported_isolation: ssh_stubs=true)\n' "$vid"
    return 2
  fi

  # Build argv, splicing {acq} and {python}.
  while IFS= read -r token; do
    case "$token" in
      "{acq}") read -r -a words <<<"$ACQ_CMD"; cmd+=(${words[@]+"${words[@]}"}) ;;
      "{python}") cmd+=("$PYTHON_CMD") ;;
      *) cmd+=("$token") ;;
    esac
  done < <(jq -r '.invoke.argv[]' "$vecfile")

  # Environment: unset, then set, then redirect to throwaway dirs.
  while IFS= read -r name; do [ -n "$name" ] && unset_list+=("$name"); done \
    < <(jq -r '.invoke.unset[]?' "$vecfile")
  while IFS= read -r kv; do [ -n "$kv" ] && env_list+=("$kv"); done \
    < <(jq -r '.invoke.env | to_entries[]? | "\(.key)=\(.value)"' "$vecfile")
  redirect_list=(HOME XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME XDG_CACHE_HOME)
  while IFS= read -r name; do [ -n "$name" ] && redirect_list+=("$name"); done \
    < <(jq -r '.isolation.redirect[]?' "$vecfile")

  local out="$outdir/out" err="$outdir/err" in="$outdir/in" exp="$outdir/expected"
  # -j, not -r: stdin is fed byte-exact, as the pytest runner does (-r would
  # append a newline the vector never declared).
  jq -j '.invoke.stdin // ""' "$vecfile" > "$in"
  local timeout_ms timeout_s
  timeout_ms="$(jq -r '.invoke.timeout_ms // 5000' "$vecfile")"
  timeout_s="$(awk -v ms="$timeout_ms" 'BEGIN { printf "%.3f", ms / 1000 }')"

  # Run the command with the constructed environment in a subshell.
  # `${arr[@]+"${arr[@]}"}` expands to nothing for an empty array: bash < 4.4
  # (macOS ships 3.2) treats a bare "${arr[@]}" on an empty array as unbound
  # under `set -u` and aborts the subshell before the CLI runs.
  # SSH_AUTH_SOCK goes first, for every vector: a developer's real ssh-agent must
  # never be forwarded into a stub sandbox or change what an oracle sees (it is
  # the forward's opt-in, ADR-0021). A vector that needs it sets it in env.
  (
    unset SSH_AUTH_SOCK
    for u in ${unset_list[@]+"${unset_list[@]}"}; do unset "$u"; done
    [ "${#env_list[@]}" -gt 0 ] && export "${env_list[@]}"
    for r in "${redirect_list[@]}"; do export "$r"="$outdir/redirect/$r"; done
    exec timeout "$timeout_s" "${cmd[@]}"
  ) < "$in" > "$out" 2> "$err"
  local rc=$?

  local want_exit
  want_exit="$(jq -r '.expect.exit' "$vecfile")"
  if [ "$rc" -ne "$want_exit" ]; then
    local reason="expected exit $want_exit, got $rc"
    [ "$rc" -eq 124 ] && reason="timed out after ${timeout_s}s"
    printf 'FAIL %s (%s; stderr: %s)\n' "$vid" "$reason" "$(tr '\n' ' ' < "$err")"
    return 3
  fi

  # Each stream has one assertion or a list of them. Every assertion starts from
  # a fresh copy of the raw stream, so one assertion's transforms never change
  # what the next one sees.
  local stream count i raw spec="$outdir/spec" actual="$outdir/actual" mode haystack needle
  for stream in stdout stderr; do
    raw="$out"; [ "$stream" = "stderr" ] && raw="$err"
    count="$(jq -r --arg s "$stream" \
      '.expect[$s] | if . == null then 0 elif type == "array" then length else 1 end' "$vecfile")"
    i=0
    while [ "$i" -lt "$count" ]; do
      jq -c --arg s "$stream" --argjson i "$i" \
        '.expect[$s] | if type == "array" then .[$i] else . end' "$vecfile" > "$spec"
      i=$((i + 1))
      cp "$raw" "$actual"
      while IFS= read -r t; do [ -n "$t" ] && _apply_transform "$t" "$actual"; done \
        < <(jq -r '.normalize[]?' "$spec")
      mode="$(jq -r '.mode // "exact"' "$spec")"
      # Byte-faithful extraction: jq @base64 + base64 -d avoids jq -r's added
      # trailing newline so the expected value is decoded verbatim.
      case "$mode" in
        exact|contains|absent) jq -r '.value | @base64' "$spec" | base64 -d > "$exp" ;;
        json) jq -c '.value' "$spec" > "$exp" ;;
      esac
      case "$mode" in
        exact)
          cmp -s "$actual" "$exp" || { printf 'FAIL %s (%s exact mismatch)\n' "$vid" "$stream"; return 3; }
          ;;
        contains|absent)
          # `read -d ''` stops at a NUL byte, so a value after one would never
          # be searched and an absent check would pass. Fail such output, as
          # the Python runner does.
          if ! LC_ALL=C tr -d '\000' < "$actual" | cmp -s - "$actual"; then
            printf 'FAIL %s (%s contains a NUL byte, which %s cannot search)\n' "$vid" "$stream" "$mode"
            return 3
          fi
          haystack="" needle=""
          IFS= read -r -d '' haystack < "$actual" || true
          IFS= read -r -d '' needle < "$exp" || true
          if [[ "$haystack" == *"$needle"* ]]; then
            [ "$mode" = contains ] || { printf 'FAIL %s (%s contains what must be absent)\n' "$vid" "$stream"; return 3; }
          else
            [ "$mode" = absent ] || { printf 'FAIL %s (%s does not contain expected)\n' "$vid" "$stream"; return 3; }
          fi
          ;;
        json)
          _jq_subset "$actual" "$exp" || { printf 'FAIL %s (%s JSON mismatch)\n' "$vid" "$stream"; return 3; }
          ;;
        *) printf 'FAIL %s (unknown mode %s)\n' "$vid" "$mode"; return 3 ;;
      esac
    done
  done

  printf 'ok %s\n' "$vid"
  return 0
}

# --- main loop --------------------------------------------------------------
shopt -s nullglob
vector_files=()
if [ -n "$SECTION" ]; then
  vector_files=("$VECTORS_DIR/$SECTION"/*.json)
else
  while IFS= read -r -d '' f; do vector_files+=("$f"); done \
    < <(find "$VECTORS_DIR" -mindepth 2 -maxdepth 2 -name '*.json' -print0 | sort -z)
fi

if [ "${#vector_files[@]}" -eq 0 ]; then
  echo "run-vectors: no vectors found under $VECTORS_DIR" >&2
  exit 2
fi

# Scratch goes under TMPDIR only when it is absolute, else /tmp, as acq_tmp_dir
# in acq.backends/userdirs.sh does: a bare `mktemp -d` would follow a relative
# TMPDIR into the current directory.
tmp_base="$(_tmpdir_root)"
tmp_root="$(mktemp -d "${tmp_base:-/tmp}/run-vectors.XXXXXX")"
trap 'rm -rf "$tmp_root"' EXIT

pass=0 fail=0 skip=0
for vecfile in "${vector_files[@]}"; do
  outdir="$tmp_root/$(basename "$vecfile" .json)-$$"
  mkdir -p "$outdir/redirect"
  result="$(_run_vector "$vecfile" "$outdir")" && rc=0 || rc=$?

  case "$(basename "$(dirname "$vecfile")")" in
    negative) neg=1 ;;
    *) neg=0 ;;
  esac

  if [ "$neg" -eq 1 ]; then
    # A negative oracle passes only when the runner refused it (fail closed).
    if [ "$rc" -eq 2 ]; then pass=$((pass + 1)); else fail=$((fail + 1)); fi
  else
    case "$rc" in
      0) pass=$((pass + 1)) ;;
      1) skip=$((skip + 1)) ;;
      *) fail=$((fail + 1)) ;;
    esac
  fi
  printf '%s\n' "$result"
done

printf '\nrun-vectors: %d passed, %d failed, %d skipped\n' "$pass" "$fail" "$skip"
[ "$fail" -eq 0 ]
