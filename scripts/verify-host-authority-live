#!/usr/bin/env bash
# verify-host-authority-live — HOST-RUN live validation of the host-authoritative
# sandbox configuration work (ADR-0035 msb, ADR-0037 sbx). It walks the checklist of
# items that offline tests cannot prove ("Still unverified on a real host") and prints
# PASS / FAIL / BLOCKED per step, with the tested acq revision and backend version.
#
# It does NOT repeat what is already validated live: the msb 0.7.7 read-only mount
# canary (scripts/qualify-msb-ro-mount), the msb inspect mount shape on a default
# sandbox, or the provider-adoption gate (scripts/verify-backends).
#
# Steps that cannot be automated safely (interactive attach, a live ssh-agent forward,
# the ADR-0037 mount experiments, other hosts) are printed as numbered MANUAL
# instructions with the exact commands and what to observe. They are never scored.
#
# Usage:  scripts/verify-host-authority-live [options]
#   --backend msb|sbx|both  backends to exercise (default both; a missing CLI makes
#                           that backend's steps BLOCKED)
#   --only ID[,ID...]       run only these step ids (see --dry-run for the list); steps
#                           that reuse an earlier step's sandbox report BLOCKED alone
#   --out DIR               transcript directory (default <repo>/tmp/verify-host-authority-live-<stamp>)
#   --step-timeout SECS     per command timeout (default 120)
#   --create-timeout SECS   timeout for sandbox creation (default 1200)
#   --step-budget SECS      wall-clock budget for one whole step (default 2*create-timeout
#                           + 10*step-timeout); an exhausted budget is BLOCKED(timeout)
#   --no-hang-diagnostics   do not capture ps / msb ls / sbx ls when a command times out
#                           (the capture is ON by default and goes into the transcript)
#   --keep                  keep throwaway sandboxes when a step fails
#   --dry-run               print the plan and the MANUAL instructions; touch no backend
#   -h, --help              show this help
#   EXPECT_SHA=<prefix>     abort unless this checkout's HEAD starts with it
#
# Exit: 0 all automated steps PASS, 1 any FAIL, 2 no FAIL but some BLOCKED, 130 interrupted.
# Every command writes to a file, never to a pipe a descendant could hold open; a command
# that outlives its timeout (plus HAL_KILL_GRACE, default 10s) is KILLed with its children,
# and the summary always prints, also after an interrupt.
# Uses your normal acq state and credentials (nothing is seeded or printed). msb steps
# create shell sandboxes with --no-provider-kits; sbx steps create an opencode sandbox and use your existing USAi setup (a
# create that fails for lack of it makes the sbx steps BLOCKED). Only throwaway
# lowercase-named sandboxes are created, and they are removed on exit or interrupt.
# Run it OUTSIDE any sandbox, on a host that can create sandboxes. Bash 3.2 compatible.
set -uo pipefail

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
REPO=$(cd "$HERE/.." && pwd -P)
ACQ_LIB="$REPO/acq"
ACQ="${HAL_ACQ_BIN:-$ACQ_LIB}"   # HAL_ACQ_BIN: offline test seam only

BACKENDS=both
ONLY=""
OUT=""
STEP_TIMEOUT=120
CREATE_TIMEOUT=1200
STEP_BUDGET=""
HANG_DIAG=1
KILL_GRACE="${HAL_KILL_GRACE:-10}"   # HAL_KILL_GRACE: also an offline test seam
KEEP=0
DRY=0
STAMP=$(date -u +%Y%m%dt%H%M%Sz)
RUN_ID="${HAL_RUN_ID:-$(date -u +%d%H%M%S)-$$-$RANDOM}"   # HAL_RUN_ID: offline test seam

usage() { sed -n '2,/^set -uo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; }
die_usage() { echo "verify-host-authority-live: $1" >&2; echo "try --help" >&2; exit 2; }

is_uint() { case "${1:-}" in ''|*[!0-9]*) return 1 ;; *) [ "$1" -gt 0 ] ;; esac; }

while [ "$#" -gt 0 ]; do
  case "$1" in
    --backend) [ "$#" -ge 2 ] || die_usage "--backend needs a value"; BACKENDS="$2"; shift ;;
    --backend=*) BACKENDS="${1#--backend=}" ;;
    --only) [ "$#" -ge 2 ] || die_usage "--only needs a value"; ONLY="$2"; shift ;;
    --only=*) ONLY="${1#--only=}" ;;
    --out) [ "$#" -ge 2 ] || die_usage "--out needs a value"; OUT="$2"; shift ;;
    --out=*) OUT="${1#--out=}" ;;
    --step-timeout) [ "$#" -ge 2 ] || die_usage "--step-timeout needs a value"; STEP_TIMEOUT="$2"; shift ;;
    --step-timeout=*) STEP_TIMEOUT="${1#--step-timeout=}" ;;
    --create-timeout) [ "$#" -ge 2 ] || die_usage "--create-timeout needs a value"; CREATE_TIMEOUT="$2"; shift ;;
    --create-timeout=*) CREATE_TIMEOUT="${1#--create-timeout=}" ;;
    --step-budget) [ "$#" -ge 2 ] || die_usage "--step-budget needs a value"; STEP_BUDGET="$2"; shift ;;
    --step-budget=*) STEP_BUDGET="${1#--step-budget=}" ;;
    --hang-diagnostics) HANG_DIAG=1 ;;
    --no-hang-diagnostics) HANG_DIAG=0 ;;
    --keep) KEEP=1 ;;
    --dry-run) DRY=1 ;;
    -h|--help) usage; exit 0 ;;
    *) die_usage "unknown argument: $1" ;;
  esac
  shift
done

case "$BACKENDS" in msb|sbx|both) ;; *) die_usage "--backend must be msb, sbx or both (got '$BACKENDS')" ;; esac
is_uint "$STEP_TIMEOUT" || die_usage "--step-timeout must be a positive integer"
is_uint "$CREATE_TIMEOUT" || die_usage "--create-timeout must be a positive integer"
is_uint "$KILL_GRACE" || die_usage "HAL_KILL_GRACE must be a positive integer"
[ -n "$STEP_BUDGET" ] || STEP_BUDGET=$((2 * CREATE_TIMEOUT + 10 * STEP_TIMEOUT))
is_uint "$STEP_BUDGET" || die_usage "--step-budget must be a positive integer"

# --- step table -------------------------------------------------------------
# id|backend|title (order = execution order; dependents of a failed setup step are BLOCKED)
STEP_TABLE='msb-ro-kit-create|msb|readonly kit file used end to end on create (fixture kit)
msb-inspect-shape|msb|msb inspect output shape: .active_config.mounts and .config.mounts
msb-exit-code|msb|msb exec passes a guest exit code of 2 through unchanged
msb-ro-kit-heal|msb|readonly kit file on heal after acq restart (stop + msb start)
msb-forged-markers|msb|forged legacy guest markers change no session behavior
msb-install-gate|msb|deleting host install keys makes the heal re-run the install command
msb-ro-oci|msb|readonly files of the shipped oci-engine kit (Patterns v1.19.0) on create
sbx-baseline|sbx|create a throwaway sandbox and read the host builtin-kits record
sbx-forged-heal|sbx|forged-probe heal: removed guest files are not re-applied
sbx-record-change|sbx|altering the host builtin-kits record triggers kit add
sbx-stale-refresh|sbx|stale-bundle refresh re-applies all built-in kits
sbx-legacy-reseed|sbx|legacy sandbox (no builtin-kits) notice, then rm + fresh create re-seeds'

step_ids() { printf '%s\n' "$STEP_TABLE" | cut -d'|' -f1; }
step_backend() { printf '%s\n' "$STEP_TABLE" | awk -F'|' -v id="$1" '$1 == id { print $2 }'; }
step_title() { printf '%s\n' "$STEP_TABLE" | awk -F'|' -v id="$1" '$1 == id { print $3 }'; }

validate_only() {
  local want id found
  [ -n "$ONLY" ] || return 0
  for want in $(printf '%s' "$ONLY" | tr ',' ' '); do
    found=0
    for id in $(step_ids); do [ "$id" = "$want" ] && found=1; done
    [ "$found" -eq 1 ] || die_usage "--only: unknown step id '$want' (see --dry-run for the list)"
  done
}
validate_only

step_selected() { # ID -> 0 if it should run
  local id="$1" b want
  b=$(step_backend "$id")
  case "$BACKENDS" in both) ;; *) [ "$BACKENDS" = "$b" ] || return 1 ;; esac
  [ -n "$ONLY" ] || return 0
  for want in $(printf '%s' "$ONLY" | tr ',' ' '); do
    [ "$want" = "$id" ] && return 0
  done
  return 1
}

TRANSCRIPT=""
say() { printf '%s\n' "$*"; if [ -n "$TRANSCRIPT" ]; then printf '%s\n' "$*" >>"$TRANSCRIPT"; fi; }

print_plan() {
  local id n=0
  say "automated steps (backend: $BACKENDS)"
  for id in $(step_ids); do
    if step_selected "$id"; then
      n=$((n + 1))
      say "  $(printf '%2d' "$n")  $id [$(step_backend "$id")]  $(step_title "$id")"
    fi
  done
  [ "$n" -gt 0 ] || say "  (none selected)"
}

# --- MANUAL instructions (never scored; printed after the automated steps) ----
# The text lives in scripts/verify-host-authority-live-manual.txt (placeholders @RUN@, @REPO@).
MANUAL_FILE="$HERE/verify-host-authority-live-manual.txt"
print_manual() {
  if [ ! -r "$MANUAL_FILE" ]; then echo "MANUAL instructions unavailable: cannot read $MANUAL_FILE"; return 0; fi
  sed -e "s/@RUN@/$RUN_ID/g" -e "s|@REPO@|$REPO|g" "$MANUAL_FILE"
}

if [ "$DRY" -eq 1 ]; then
  echo "verify-host-authority-live: DRY RUN (no backend is touched, nothing is created)"
  echo "revision : $(git -C "$REPO" rev-parse HEAD 2>/dev/null || echo unknown)"
  echo "backends : $BACKENDS    step timeout: ${STEP_TIMEOUT}s    create timeout: ${CREATE_TIMEOUT}s"
  echo "out dir  : ${OUT:-$REPO/tmp/verify-host-authority-live-<stamp>}"
  echo
  print_plan
  echo
  print_manual
  exit 0
fi

# --- runtime (live mode only) ------------------------------------------------
REVISION=$(git -C "$REPO" rev-parse HEAD 2>/dev/null || echo unknown)
DIRTY=""
if [ -n "$(git -C "$REPO" status --porcelain 2>/dev/null)" ]; then DIRTY=" (dirty tree)"; fi
RUN_DATE=$(date -u +%Y-%m-%dT%H:%M:%SZ)
TO=()
if command -v timeout >/dev/null 2>&1; then TO=(timeout --foreground)
elif command -v gtimeout >/dev/null 2>&1; then TO=(gtimeout --foreground); fi

if [ -n "${EXPECT_SHA:-}" ]; then
  case "$REVISION" in
    "$EXPECT_SHA"*) ;;
    *) echo "verify-host-authority-live: BLOCKED: HEAD $REVISION does not match EXPECT_SHA=$EXPECT_SHA" >&2; exit 2 ;;
  esac
fi
[ "${#TO[@]}" -gt 0 ] || { echo "verify-host-authority-live: BLOCKED: neither timeout nor gtimeout is on PATH (macOS: brew install coreutils)" >&2; exit 2; }

[ -n "$OUT" ] || OUT="$REPO/tmp/verify-host-authority-live-$STAMP"
mkdir -p "$OUT" || { echo "verify-host-authority-live: cannot create $OUT" >&2; exit 2; }
OUT=$(cd "$OUT" && pwd -P)
TRANSCRIPT="$OUT/transcript.log"
RESULTS="$OUT/results.tsv"
CAP="$OUT/.last-output"
: >"$TRANSCRIPT"; : >"$CAP"
printf 'id\tbackend\tbackend_version\trevision\tdate\tresult\tdetail\ttranscript\n' >"$RESULTS"

export ACQ_NO_PROMPT=1 ACQ_UPDATE_CHECK=0 GIT_TERMINAL_PROMPT=0
CREATED=""
LAST_RC=0
# Scratch workspaces: a fresh mktemp -d directory inside the output directory, verified
# before use. Cleanup removes only this directory, and only if it is inside $OUT.
WS_ROOT=$(mktemp -d "$OUT/ws.XXXXXX") || { echo "verify-host-authority-live: cannot create a scratch directory under $OUT" >&2; exit 2; }
WS_ROOT=$(cd "$WS_ROOT" && pwd -P)
case "$WS_ROOT" in "$OUT"/ws.?*) ;; *) echo "verify-host-authority-live: unexpected scratch directory $WS_ROOT" >&2; exit 2 ;; esac

sandbox_name() { printf 'hal-%s-%s' "$RUN_ID" "$1"; }

# --- bounded execution core ---------------------------------------------------
# Nothing here ever reads a pipe that a descendant of the command could hold open. The
# command's output goes to a FILE, it runs in the background, and this shell waits for
# that one PID only, polling against a wall-clock deadline. At the deadline it records
# hang diagnostics, TERMs the command and every descendant (found with pgrep -P), then
# KILLs whatever ignored it. timeout(1) (-k) stays as an outer backstop only.
POLL=1
if sleep 0.1 2>/dev/null; then POLL=0.1; fi
STEP_DEADLINE=0; STEP_TIMED_OUT=0; CUR_PID=""; STUCK_PID=""; B_LIVE=0; B_SHOWN=0; IN_DIAG=0
PROBE_F="$OUT/.probe-out"

descendants() { # PID -> PID and every descendant, one per line
  local c
  echo "$1"
  if command -v pgrep >/dev/null 2>&1; then
    for c in $(pgrep -P "$1" 2>/dev/null); do descendants "$c"; done
  else
    for c in $(ps -axo pid=,ppid= 2>/dev/null | awk -v p="$1" '$2 == p { print $1 }'); do descendants "$c"; done
  fi
}
any_alive() { local p; for p in "$@"; do kill -0 "$p" 2>/dev/null && return 0; done; return 1; }
reap_tree() { # PID : TERM the tree, wait KILL_GRACE, KILL survivors (and fresh children)
  local list p t
  list=$(descendants "$1")
  for p in $list; do kill -TERM "$p" 2>/dev/null; done
  t=$((SECONDS + KILL_GRACE))
  # shellcheck disable=SC2086
  while [ "$SECONDS" -le "$t" ] && any_alive $list; do sleep "$POLL"; done
  if kill -0 "$1" 2>/dev/null; then list="$list
$(descendants "$1")"; fi
  for p in $list; do kill -KILL "$p" 2>/dev/null; done
  sleep "$POLL"
  return 0
}

b_show() { # OUTFILE : echo the bytes not yet shown to the terminal and the transcript
  local f="$1" size n
  [ "$B_LIVE" -eq 1 ] || return 0
  size=$(wc -c <"$f" 2>/dev/null | tr -d ' ')
  [ -n "$size" ] || return 0
  n=$((size - B_SHOWN))
  [ "$n" -gt 0 ] || return 0
  tail -c +$((B_SHOWN + 1)) "$f" 2>/dev/null | head -c "$n" >"$OUT/.chunk"
  cat "$OUT/.chunk"
  cat "$OUT/.chunk" >>"$TRANSCRIPT"
  B_SHOWN=$size
}

hang_diag() { # called with the stuck command still alive
  local f="$OUT/.diag" s_pid="$CUR_PID" s_shown="$B_SHOWN" s_live="$B_LIVE" s_rc="$LAST_RC" s_to="$STEP_TIMED_OUT" s_dl="$STEP_DEADLINE" l
  [ "$HANG_DIAG" -eq 1 ] && [ "$IN_DIAG" -eq 0 ] || return 0
  IN_DIAG=1; STEP_DEADLINE=0; B_LIVE=0; STUCK_PID="$s_pid"
  say "--- hang diagnostics $(date -u +%Y-%m-%dT%H:%M:%SZ): ps (acq|msb|sbx|socat|sleep), msb ls, sbx ls ---"
  run_bounded 15 "$f" "" ps -axo pid,ppid,etime,stat,command
  grep -E 'acq|msb|sbx|socat|sleep' "$f" 2>/dev/null | grep -v 'grep -E' >"$f.sel"
  while IFS= read -r l; do say "  $(printf '%s' "$l" | cut -c1-200)"; done <"$f.sel"
  if command -v msb >/dev/null 2>&1; then
    run_bounded 15 "$f" "" msb ls; say "  msb ls (rc $LAST_RC):"
    while IFS= read -r l; do say "    $l"; done <"$f"
  fi
  if command -v sbx >/dev/null 2>&1; then
    run_bounded 15 "$f" "" sbx ls; say "  sbx ls (rc $LAST_RC):"
    while IFS= read -r l; do say "    $l"; done <"$f"
  fi
  say "--- end hang diagnostics ---"
  CUR_PID="$s_pid"; B_SHOWN="$s_shown"; B_LIVE="$s_live"; LAST_RC="$s_rc"; STEP_TIMED_OUT="$s_to"; STEP_DEADLINE="$s_dl"; IN_DIAG=0; STUCK_PID=""
}

# run_bounded SECS OUTFILE ERRFILE CMD... : stdin closed, stdout (and stderr, unless
# ERRFILE is given) go to OUTFILE. LAST_RC is the exit status; 124 means timed out, or
# the step's wall-clock budget was exhausted (the command is then not started).
run_bounded() {
  local secs="$1" outf="$2" errf="$3" pid dl left rc=0 timedout=0
  shift 3
  if [ "$STEP_DEADLINE" -gt 0 ]; then
    left=$((STEP_DEADLINE - SECONDS))
    if [ "$left" -le 0 ]; then
      say "[step wall-clock budget (${STEP_BUDGET}s) exhausted; not running: $*]"
      : >"$outf"; STEP_TIMED_OUT=1; LAST_RC=124; return 0
    fi
    [ "$secs" -le "$left" ] || secs=$left
  fi
  : >"$outf"; B_SHOWN=0
  if [ -n "$errf" ]; then
    : >"$errf"
    "${TO[@]}" -k "$KILL_GRACE" "$((secs + KILL_GRACE + 5))" "$@" </dev/null >"$outf" 2>"$errf" &
  else
    "${TO[@]}" -k "$KILL_GRACE" "$((secs + KILL_GRACE + 5))" "$@" </dev/null >"$outf" 2>&1 &
  fi
  pid=$!; CUR_PID=$pid; dl=$((SECONDS + secs))
  while kill -0 "$pid" 2>/dev/null; do
    b_show "$outf"
    if [ "$SECONDS" -gt "$dl" ]; then
      timedout=1
      say "[timed out after ${secs}s: $*]"
      hang_diag
      reap_tree "$pid"
      break
    fi
    sleep "$POLL"
  done
  if kill -0 "$pid" 2>/dev/null; then
    say "[could not kill pid $pid; abandoning it]"; rc=137
  else
    wait "$pid" 2>/dev/null; rc=$?
  fi
  b_show "$outf"
  CUR_PID=""
  if [ "$timedout" -eq 1 ]; then rc=124; fi
  if [ "$rc" -eq 124 ]; then STEP_TIMED_OUT=1; fi
  LAST_RC=$rc
  return 0
}

# run_cmd SECS CMD... : run bounded, stdin closed, output shown live and appended to the
# transcript; the output is also kept in $CAP and the exit status lands in LAST_RC.
run_cmd() {
  local secs="$1"; shift
  say "\$ $*"
  B_LIVE=1
  run_bounded "$secs" "$CAP" "" "$@"
  B_LIVE=0
  return 0
}
last_out() { tr -d '\r' <"$CAP"; }
last_has() { last_out | grep -Fq -- "$1"; }
last_count() { last_out | grep -Fc -- "$1"; }

hc_dir() { # BACKEND NAME
  # shellcheck disable=SC1090
  ( ACQ_SOURCE_ONLY=1 ACQ_SCRIPT_DIR="$REPO" . "$ACQ_LIB" >/dev/null 2>&1; acq_host_config_dir "$1" "$2" ) 2>/dev/null
}
prov_file() { # BACKEND NAME
  # shellcheck disable=SC1090
  ( ACQ_SOURCE_ONLY=1 ACQ_SCRIPT_DIR="$REPO" . "$ACQ_LIB" >/dev/null 2>&1; _acq_provenance_file "$1" "$2" ) 2>/dev/null
}

track_sandbox() {
  case "
$CREATED" in *"
$1:$2
"*) return 0 ;; esac
  CREATED="${CREATED}$1:$2
"
}

remove_sandbox() { # BACKEND NAME
  local f="$OUT/.rm-out"
  STEP_DEADLINE=0
  run_bounded 120 "$f" "" "$ACQ" --backend "$1" rm "$2"
  say "cleanup: acq rm $2 rc=$LAST_RC"
  case "$1" in
    msb) run_bounded 60 "$f" "" msb remove --force "$2" ;;
    sbx) run_bounded 60 "$f" "" sbx rm --force "$2" ;;
  esac
  say "cleanup: $1 remove $2 rc=$LAST_RC"
}

ANY_FAIL=0
CLEANED=0
cleanup() {
  local line b n
  [ "$CLEANED" -eq 0 ] || return 0
  CLEANED=1
  if [ "$KEEP" -eq 1 ] && [ "$ANY_FAIL" -eq 1 ]; then
    say "keeping sandboxes (--keep and a step failed):"
    printf '%s' "$CREATED" | while IFS= read -r line; do [ -n "$line" ] && say "  $line"; done
    return 0
  fi
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    b=${line%%:*}; n=${line#*:}
    say "cleanup: removing $b sandbox $n"
    remove_sandbox "$b" "$n"
  done <<CLEAN
$CREATED
CLEAN
  case "$WS_ROOT" in
    "$OUT"/ws.?*) [ -d "$WS_ROOT" ] && rm -rf -- "$WS_ROOT" ;;
  esac
}
SUMMARY_DONE=0
INTERRUPTED=0
MSB_VER=""; SBX_VER=""
n_pass=0; n_fail=0; n_blocked=0
# finish runs on every exit path (normal, usage error after setup, interrupt): cleanup is
# bounded, then the summary is printed exactly once.
finish() {
  local rc=$?
  trap '' INT TERM
  [ "$SUMMARY_DONE" -eq 0 ] || return 0
  SUMMARY_DONE=1
  B_LIVE=0
  if [ "$INTERRUPTED" -eq 1 ]; then rc=130; fi
  cleanup
  say ""
  if [ "$INTERRUPTED" -eq 0 ]; then print_manual | while IFS= read -r l; do printf '%s\n' "$l" >>"$TRANSCRIPT"; printf '%s\n' "$l"; done; say ""; fi
  say "SUMMARY: PASS=$n_pass FAIL=$n_fail BLOCKED=$n_blocked   revision=$REVISION$DIRTY msb=${MSB_VER:-none} sbx=${SBX_VER:-none}$( [ "$INTERRUPTED" -eq 1 ] && printf '   INTERRUPTED' )"
  say "results : $RESULTS"
  say "transcript: $TRANSCRIPT"
  if [ "$INTERRUPTED" -eq 1 ]; then exit 130; fi
  say "Paste the results rows into the Host Authority Live Validation Record in docs/VERIFY_PROVIDER_ADOPTION.md."
  if [ $((n_pass + n_fail + n_blocked)) -eq 0 ]; then say "no steps ran (empty selection): nothing was verified"; exit 2; fi
  if [ "$n_fail" -gt 0 ]; then exit 1; fi
  if [ "$n_blocked" -gt 0 ]; then exit 2; fi
  exit "$rc"
}

trap 'finish' EXIT
trap 'on_signal' INT TERM
on_signal() {
  trap '' INT TERM
  INTERRUPTED=1
  B_LIVE=0
  echo; say "interrupted: stopping the running command, removing throwaway sandboxes"
  if [ -n "$CUR_PID" ]; then reap_tree "$CUR_PID"; fi
  if [ -n "$STUCK_PID" ]; then reap_tree "$STUCK_PID"; fi
  exit 130
}

# --- recording ---------------------------------------------------------------

record() { # ID RESULT DETAIL
  local id="$1" res="$2" detail="$3" b ver
  b=$(step_backend "$id")
  case "$b" in msb) ver="$MSB_VER" ;; sbx) ver="$SBX_VER" ;; *) ver="" ;; esac
  if [ "$STEP_TIMED_OUT" -eq 1 ] && [ "$res" != BLOCKED ]; then
    detail="BLOCKED(timeout): a command in this step timed out, so the $res verdict is withheld. Was: $detail"; res=BLOCKED
  fi
  detail=$(printf '%s' "$detail" | tr '\t\r\n' '   ')
  case "$res" in
    PASS) n_pass=$((n_pass + 1)) ;;
    FAIL) n_fail=$((n_fail + 1)); ANY_FAIL=1 ;;
    *) n_blocked=$((n_blocked + 1)); : ;;
  esac
  say ""
  say "==> $res  $id: $detail"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$b" "${ver:-unknown}" "$REVISION$DIRTY" "$RUN_DATE" "$res" "$detail" "$TRANSCRIPT" >>"$RESULTS"
}


# ver_ge A B : dotted numeric A >= B
ver_ge() {
  awk -v a="$1" -v b="$2" 'BEGIN {
    na = split(a, x, "."); nb = split(b, y, ".");
    for (i = 1; i <= 3; i++) { xv = (i <= na) ? x[i] + 0 : 0; yv = (i <= nb) ? y[i] + 0 : 0;
      if (xv > yv) exit 0; if (xv < yv) exit 1 }
    exit 0 }'
}

mk_workspace() { # TAG -> path of a fresh git workspace (canonical, under $HOME)
  local d="$WS_ROOT/$1"
  mkdir -p "$d" || return 1
  ( cd "$d" && git init -q && git config user.email hal@example.invalid \
      && git config user.name "acq verify" && echo hi > README.md ) >/dev/null 2>&1 || true
  ( cd "$d" && pwd -P )
}

# --- msb fixture kit: one readonly startup file + one install-phase file -------
FIXTURE="$OUT/fixture-ro-kit"
write_fixture() {
  mkdir -p "$FIXTURE/files" || return 1
  printf '#!/bin/sh\nprintf "%%s\\n" "$0" >> /home/agent/.hal-ro-proof\n' >"$FIXTURE/files/ro-proof.sh"
  printf '#!/bin/sh\nprintf "run\\n" >> /home/agent/.hal-install-proof\n' >"$FIXTURE/files/install-proof.sh"
  {
    printf 'schemaVersion: "hybrid/v1"\nkind: mixin\nname: hal-ro-fixture\n'
    printf 'displayName: HAL RO Fixture\ndescription: readonly startup file plus install file\n'
    printf 'files:\n  - path: /home/agent/hal/ro-proof.sh\n    mode: "0755"\n    source: files/ro-proof.sh\n    readonly: true\n'
    printf '  - path: /home/agent/hal/install-proof.sh\n    mode: "0755"\n    source: files/install-proof.sh\n'
    printf 'commands:\n  - phase: install\n    user: "0"\n    command:\n      - sh\n      - /home/agent/hal/install-proof.sh\n'
    printf '  - phase: startup\n    user: "0"\n    command:\n      - sh\n      - /home/agent/hal/ro-proof.sh\n'
  } >"$FIXTURE/spec.yaml"
}

# --- shared helpers -----------------------------------------------------------
# name_in_use BACKEND NAME : 0 = listed, 1 = not listed, 2 = could not tell.
name_in_use() {
  case "$1" in
    msb) probe "$STEP_TIMEOUT" msb ls ;;
    sbx) probe "$STEP_TIMEOUT" sbx ls -q ;;
  esac
  [ "$PROBE_RC" -eq 0 ] || return 2
  printf '%s\n' "$PROBE_OUT" | grep -Fqw -- "$2"
}

# create_sandbox BACKEND NAME WS [extra create args...] : refuses (LAST_RC=125, nothing
# tracked or removed later) when the name is already in use or the listing fails, so the
# cleanup can only ever remove sandboxes this run created.
create_sandbox() {
  local b="$1" n="$2" ws="$3" nrc; shift 3
  name_in_use "$b" "$n"; nrc=$?
  if [ "$nrc" -ne 1 ]; then
    say "[refusing to create '$n': name already in use or the $b listing failed (rc $nrc)]"
    LAST_RC=125; : >"$CAP"; return 0
  fi
  track_sandbox "$b" "$n"
  if [ "$b" = msb ]; then
    run_cmd "$CREATE_TIMEOUT" "$ACQ" --backend msb create shell "$ws" --name "$n" --no-provider-kits "$@"
  else
    run_cmd "$CREATE_TIMEOUT" "$ACQ" --backend sbx create opencode "$ws" --name "$n" "$@"
  fi
}

# msb_inspect_check NAME : 0 = msb reports the read-only host-config Bind; 1 = it does
# not (a finding); 2 = the probe itself failed, timed out or returned unusable output
# (the caller must report BLOCKED, never FAIL).
msb_inspect_check() {
  local n="$1" hc js
  hc=$(hc_dir msb "$n"); js="$OUT/inspect-$n.json"
  [ -n "$hc" ] || return 2
  run_bounded "$STEP_TIMEOUT" "$js" "$OUT/.inspect-err" msb inspect "$n" --format json
  cat "$OUT/.inspect-err" >>"$TRANSCRIPT" 2>/dev/null
  [ "$LAST_RC" -eq 0 ] || return 2
  [ -s "$js" ] || return 2
  python3 - "$js" "$hc" <<'PY'
import json, os, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(2)
if not isinstance(d, dict):
    sys.exit(2)
if d.get("active_config") is None:
    sys.exit(2)
mounts = (d.get("active_config") or {}).get("mounts") or []
hit = [m for m in mounts if isinstance(m, dict) and m.get("guest") == "/var/lib/acq/host"]
ok = (len(hit) == 1 and hit[0].get("type") == "Bind"
      and (hit[0].get("options") or {}).get("readonly") is True
      and os.path.realpath(hit[0].get("host", "")) == os.path.realpath(sys.argv[2]))
sys.exit(0 if ok else 1)
PY
}

guest_root() { # NAME CMD... (msb): run as root in the guest, output live
  local n="$1"; shift
  run_cmd "$STEP_TIMEOUT" msb exec "$n" -u 0 -- "$@"
}

MSB_READY=0; MSB_A=""; MSB_A_OK=0
# probe SECS CMD... : quiet bounded probe (stdin closed). Sets PROBE_OUT and PROBE_RC;
# a timeout is rc 124. Never prints the output; callers decide what to say.
PROBE_OUT=""; PROBE_RC=0
probe() {
  local secs="$1"; shift
  run_bounded "$secs" "$PROBE_F" "" "$@"
  PROBE_RC=$LAST_RC
  PROBE_OUT=$(tr -d '\r' <"$PROBE_F")
  return 0
}

msb_preflight() {
  if ! command -v msb >/dev/null 2>&1; then say "msb: not on PATH"; return 0; fi
  probe "$STEP_TIMEOUT" msb --version
  if [ "$PROBE_RC" -ne 0 ]; then say "msb: 'msb --version' failed or timed out (rc $PROBE_RC)"; return 0; fi
  MSB_VER=$(printf '%s\n' "$PROBE_OUT" | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?([+-][^[:space:]]*)?' | head -n1)
  [ -n "$MSB_VER" ] || MSB_VER="unparsed"
  if ! command -v python3 >/dev/null 2>&1; then say "msb: python3 missing (acq's read-only gate needs it)"; return 0; fi
  probe "$STEP_TIMEOUT" msb doctor
  if [ "$PROBE_RC" -ne 0 ]; then say "msb: 'msb doctor' failed, timed out, or reports the host is not ready (rc $PROBE_RC)"; return 0; fi
  MSB_READY=1
}

block_if_not_ready() { # ID BACKEND_READY_VAR REASON
  [ "$2" -eq 1 ] || { record "$1" BLOCKED "$3"; return 1; }
  return 0
}

# --- MSB steps ------------------------------------------------------------------
# proof_lines NAME FILE : set PROOF_N to the line count of FILE in the guest (0 if the
# file is absent). Returns non-zero when the probe itself failed or timed out, so the
# caller can report BLOCKED instead of comparing garbage.
PROOF_N=""
proof_lines() {
  PROOF_N=""
  probe "$STEP_TIMEOUT" msb exec "$1" -u 0 -- sh -c "if [ -e $2 ]; then wc -l < $2; else echo 0; fi"
  [ "$PROBE_RC" -eq 0 ] || return 1
  PROOF_N=$(printf '%s\n' "$PROBE_OUT" | tail -n 1 | tr -dc '0-9')
  [ -n "$PROOF_N" ]
}

step_msb_ro_kit_create() {
  local id=msb-ro-kit-create n ws why="" irc
  block_if_not_ready "$id" "$MSB_READY" "msb unavailable (missing msb, python3, or msb doctor not ready)" || return 0
  write_fixture || { record "$id" BLOCKED "cannot write the fixture kit under $OUT"; return 0; }
  n=$(sandbox_name a); MSB_A="$n"
  ws=$(mk_workspace a) || { record "$id" BLOCKED "cannot create a workspace under $WS_ROOT"; return 0; }
  create_sandbox msb "$n" "$ws" --kit "$FIXTURE"
  if last_has "cannot place read-only kit file"; then record "$id" FAIL "acq refused the readonly fixture file on create"; return 0; fi
  need_rc0 "$id" "acq create" || return 0
  MSB_A_OK=1
  run_cmd "$STEP_TIMEOUT" msb exec "$n" -u 0 -- cat /home/agent/.hal-ro-proof
  need_rc0 "$id" "reading the readonly proof file" || return 0
  last_has "/var/lib/acq/host/kit-files/" || why="startup did not run from the read-only mount path; "
  run_cmd "$STEP_TIMEOUT" msb exec "$n" -u 0 -- sh -c 'test ! -e /home/agent/hal/ro-proof.sh && echo NO-GUEST-COPY'
  last_has NO-GUEST-COPY || why="${why}the readonly file was also copied into the guest; "
  run_cmd "$STEP_TIMEOUT" msb exec "$n" -u 0 -- sh -c 'test -x /home/agent/hal/install-proof.sh && echo PLAIN-COPY-OK'
  last_has PLAIN-COPY-OK || why="${why}the plain (non-readonly) file was not copied; "
  msb_inspect_check "$n"; irc=$?
  [ "$irc" -ne 2 ] || { record "$id" BLOCKED "msb inspect failed, timed out, or returned unusable output"; return 0; }
  [ "$irc" -eq 0 ] || why="${why}msb inspect does not show the read-only host-config Bind; "
  if [ -z "$why" ]; then record "$id" PASS "readonly fixture file ran from the :ro mount on create, no guest copy, plain file copied, inspect shows the read-only Bind"
  else record "$id" FAIL "$why"; fi
}

step_msb_inspect_shape() {
  local id=msb-inspect-shape js
  [ "$MSB_A_OK" -eq 1 ] || { record "$id" BLOCKED "needs the sandbox from msb-ro-kit-create"; return 0; }
  js="$OUT/inspect-$MSB_A.json"
  run_bounded "$STEP_TIMEOUT" "$js" "$OUT/.inspect-err" msb inspect "$MSB_A" --format json
  cat "$OUT/.inspect-err" >>"$TRANSCRIPT" 2>/dev/null
  [ "$LAST_RC" -eq 0 ] \
    || { record "$id" BLOCKED "msb inspect failed or timed out"; return 0; }
  python3 -c '
import json, sys
d = json.load(sys.stdin)
ac = d.get("active_config"); cf = d.get("config")
def host_ro(x):
    ms = (x or {}).get("mounts") if isinstance(x, dict) else None
    if not isinstance(ms, list): return "absent"
    h = [m for m in ms if isinstance(m, dict) and m.get("guest") == "/var/lib/acq/host"]
    if len(h) != 1: return "no-single-host-mount"
    return "readonly-bind" if (h[0].get("type") == "Bind" and (h[0].get("options") or {}).get("readonly") is True) else "not-readonly-bind"
print("TOPLEVEL-KEYS " + " ".join(sorted(d.keys())))
print("ACTIVE_CONFIG.MOUNTS " + ("null" if ac is None else host_ro(ac)))
print("CONFIG.MOUNTS " + host_ro(cf))
' <"$js" >"$js.keys" 2>>"$TRANSCRIPT" \
    || { record "$id" BLOCKED "msb inspect output was not parseable JSON"; return 0; }
  while IFS= read -r line; do say "  $line"; done <"$js.keys"
  if grep -q '^ACTIVE_CONFIG.MOUNTS null$' "$js.keys"; then
    record "$id" BLOCKED "msb reports a null active_config (sandbox not settled); retry later"
  elif grep -q '^ACTIVE_CONFIG.MOUNTS readonly-bind$' "$js.keys"; then
    record "$id" PASS "active_config.mounts shape matches the gate on msb $MSB_VER; $(grep '^CONFIG.MOUNTS' "$js.keys"); $(grep '^TOPLEVEL-KEYS' "$js.keys")"
  else
    record "$id" FAIL "active_config.mounts is not the expected read-only Bind on msb $MSB_VER; $(grep '^ACTIVE_CONFIG' "$js.keys")"
  fi
}

step_msb_exit_code() {
  local id=msb-exit-code r2 r7
  [ "$MSB_A_OK" -eq 1 ] || { record "$id" BLOCKED "needs the sandbox from msb-ro-kit-create"; return 0; }
  run_cmd "$STEP_TIMEOUT" msb exec "$MSB_A" -- sh -c 'exit 2'; r2=$LAST_RC
  run_cmd "$STEP_TIMEOUT" msb exec "$MSB_A" -- sh -c 'exit 7'; r7=$LAST_RC
  if [ "$r2" -eq 124 ] || [ "$r7" -eq 124 ]; then record "$id" BLOCKED "msb exec timed out; exit-code passthrough was not exercised"; return 0; fi
  if [ "$r2" -eq 2 ] && [ "$r7" -eq 7 ]; then record "$id" PASS "guest exit codes 2 and 7 passed through msb exec unchanged on msb $MSB_VER"
  else record "$id" FAIL "guest exit 2 became $r2 and exit 7 became $r7 on msb $MSB_VER (affects only the wording of a refusal)"; fi
}

INSTALL_RERAN_ON_HEAL=0
# need_rc0 ID WHAT : after run_cmd, record BLOCKED (never FAIL) and return 1 unless the
# command exited 0; a timeout (124) is named as such.
need_rc0() {
  [ "$LAST_RC" -eq 0 ] && return 0
  if [ "$LAST_RC" -eq 125 ]; then record "$1" BLOCKED "$2 was refused (sandbox name in use, or the backend listing failed)"
  elif [ "$LAST_RC" -eq 124 ]; then record "$1" BLOCKED "BLOCKED(timeout): $2 timed out or the step's wall-clock budget ran out; the step was not exercised to a conclusion"
  else record "$1" BLOCKED "$2 exited $LAST_RC; the step was not exercised to a conclusion (see transcript)"; fi
  return 1
}

step_msb_ro_kit_heal() {
  local id=msb-ro-kit-heal r0 r1 i0 i1 why="" irc
  [ "$MSB_A_OK" -eq 1 ] || { record "$id" BLOCKED "needs the sandbox from msb-ro-kit-create"; return 0; }
  proof_lines "$MSB_A" /home/agent/.hal-ro-proof || { record "$id" BLOCKED "could not read the readonly proof file before restart"; return 0; }
  r0=$PROOF_N
  proof_lines "$MSB_A" /home/agent/.hal-install-proof || { record "$id" BLOCKED "could not read the install proof file before restart"; return 0; }
  i0=$PROOF_N
  run_cmd "$CREATE_TIMEOUT" "$ACQ" --backend msb restart "$MSB_A"
  if last_has "cannot place read-only kit file"; then record "$id" FAIL "acq refused the readonly fixture file on heal after restart"; return 0; fi
  need_rc0 "$id" "acq restart" || return 0
  proof_lines "$MSB_A" /home/agent/.hal-ro-proof || { record "$id" BLOCKED "could not read the readonly proof file after restart"; return 0; }
  r1=$PROOF_N
  proof_lines "$MSB_A" /home/agent/.hal-install-proof || { record "$id" BLOCKED "could not read the install proof file after restart"; return 0; }
  i1=$PROOF_N
  say "  readonly startup proof lines: $r0 -> $r1; install proof lines: $i0 -> $i1"
  [ "$r1" -gt "$r0" ] || why="the readonly startup command did not re-run on heal; "
  run_cmd "$STEP_TIMEOUT" msb exec "$MSB_A" -u 0 -- tail -n 1 /home/agent/.hal-ro-proof
  need_rc0 "$id" "reading the last readonly proof line" || return 0
  last_has "/var/lib/acq/host/kit-files/" || why="${why}the heal ran the file from somewhere other than the read-only mount; "
  msb_inspect_check "$MSB_A"; irc=$?
  [ "$irc" -ne 2 ] || { record "$id" BLOCKED "msb inspect failed, timed out, or returned unusable output after restart"; return 0; }
  [ "$irc" -eq 0 ] || why="${why}msb inspect no longer shows the read-only Bind after restart; "
  [ "$i1" -gt "$i0" ] && INSTALL_RERAN_ON_HEAL=1
  if [ -z "$why" ]; then record "$id" PASS "after stop/start the readonly startup file re-ran from the :ro mount and the mount record held (msb $MSB_VER)"
  else record "$id" FAIL "$why"; fi
}

step_msb_forged_markers() {
  local id=msb-forged-markers ws why="" cwd
  [ "$MSB_A_OK" -eq 1 ] || { record "$id" BLOCKED "needs the sandbox from msb-ro-kit-create"; return 0; }
  ws="$WS_ROOT/a"
  ws=$(cd "$ws" && pwd -P)
  guest_root "$MSB_A" sh -c 'mkdir -p /var/lib/acq; printf claude > /var/lib/acq/agent; printf /tmp/forged-ws > /var/lib/acq/workspace; printf /tmp/forged.sock > /var/lib/acq/ssh-auth-sock; printf "FORGED_KIT_VAR=pwned\n" > /var/lib/acq/kit-env && touch /var/lib/acq/agent-user-ready /var/lib/acq/agent-installed-claude /var/lib/acq/install-1 && cat /var/lib/acq/workspace'
  if [ "$LAST_RC" -ne 0 ] || ! last_has /tmp/forged-ws; then record "$id" BLOCKED "could not plant (and read back) the forged markers"; return 0; fi
  run_cmd "$STEP_TIMEOUT" "$ACQ" --backend msb exec "$MSB_A" -- pwd
  cwd=$(last_out | tail -n 1 | tr -d '[:space:]')
  if [ "$LAST_RC" -ne 0 ] || [ -z "$cwd" ]; then record "$id" BLOCKED "acq exec pwd failed or printed nothing (rc $LAST_RC)"; return 0; fi
  [ "$cwd" != "/tmp/forged-ws" ] || why="session started in the forged workspace; "
  [ "$cwd" = "$ws" ] || say "  note: session cwd '$cwd' differs from the host workspace '$ws' (recorded as evidence, not scored when not forged)"
  run_cmd "$STEP_TIMEOUT" "$ACQ" --backend msb exec "$MSB_A" -- sh -c 'echo "FKV=[$FORGED_KIT_VAR] SOCK=[$SSH_AUTH_SOCK]"'
  if [ "$LAST_RC" -ne 0 ] || ! last_has 'FKV=['; then record "$id" BLOCKED "acq exec env probe failed (rc $LAST_RC)"; return 0; fi
  last_has "FKV=[pwned]" && why="${why}the forged kit-env variable reached the session; "
  last_has "SOCK=[/tmp/forged.sock]" && why="${why}the forged ssh socket reached the session; "
  run_cmd "$STEP_TIMEOUT" "$ACQ" --backend msb exec "$MSB_A" -- sh -c 'command -v claude >/dev/null 2>&1 && echo CLAUDE-PRESENT || echo no-claude'
  run_cmd "$STEP_TIMEOUT" "$ACQ" --backend msb exec "$MSB_A" -- id -un
  need_rc0 "$id" "id -un via acq exec" || return 0
  last_out | grep -qx agent || why="${why}exec no longer runs as the agent user; "
  if [ -z "$why" ]; then record "$id" PASS "forged agent/workspace/ssh-socket/kit-env/ready markers changed no exec-session behavior (attach and agent-key cases: MANUAL 1)"
  else record "$id" FAIL "$why"; fi
}

step_msb_install_gate() {
  local id=msb-install-gate hc i0 i1 n
  [ "$MSB_A_OK" -eq 1 ] || { record "$id" BLOCKED "needs the sandbox from msb-ro-kit-create"; return 0; }
  if [ "$INSTALL_RERAN_ON_HEAL" -eq 1 ]; then
    record "$id" BLOCKED "the install command re-ran on a plain heal, so key deletion cannot be told apart (see msb-ro-kit-heal output)"; return 0
  fi
  hc=$(hc_dir msb "$MSB_A")
  [ -n "$hc" ] && [ -d "$hc" ] || { record "$id" BLOCKED "host config dir for $MSB_A not found"; return 0; }
  n=$(find "$hc" -maxdepth 1 -type f -name 'install-*' 2>/dev/null | wc -l | tr -d ' ')
  [ "${n:-0}" -gt 0 ] || { record "$id" BLOCKED "no install-* key exists in the host config dir $hc (nothing to delete)"; return 0; }
  proof_lines "$MSB_A" /home/agent/.hal-install-proof || { record "$id" BLOCKED "could not read the install proof file before restart"; return 0; }
  i0=$PROOF_N
  say "  deleting $n host install key(s) under $hc"
  find "$hc" -maxdepth 1 -type f -name 'install-*' -exec rm -f {} + 2>>"$TRANSCRIPT"
  run_cmd "$CREATE_TIMEOUT" "$ACQ" --backend msb restart "$MSB_A"
  need_rc0 "$id" "acq restart" || return 0
  proof_lines "$MSB_A" /home/agent/.hal-install-proof || { record "$id" BLOCKED "could not read the install proof file after restart"; return 0; }
  i1=$PROOF_N
  say "  install proof lines: $i0 -> $i1"
  if [ "$i1" -gt "$i0" ]; then record "$id" PASS "install command re-ran after the host install key was deleted (restart exited 0)"
  else record "$id" FAIL "install command did not re-run after the host install key was deleted"; fi
}

step_msb_ro_oci() {
  local id=msb-ro-oci n ws ref irc
  block_if_not_ready "$id" "$MSB_READY" "msb unavailable" || return 0
  ref=$(
    # shellcheck disable=SC1090
    ACQ_SOURCE_ONLY=1 ACQ_SCRIPT_DIR="$REPO" . "$ACQ_LIB" >/dev/null 2>&1
    _acq_optin_kit_ref oci-engine 2>/dev/null
  )
  [ -n "$ref" ] || { record "$id" BLOCKED "could not resolve the oci-engine kit ref"; return 0; }
  n=$(sandbox_name oci)
  ws=$(mk_workspace oci) || { record "$id" BLOCKED "cannot create a workspace under $WS_ROOT"; return 0; }
  say "  oci-engine ref: $ref"
  create_sandbox msb "$n" "$ws" --kit "$ref"
  if last_has "cannot place read-only kit file"; then record "$id" FAIL "acq refused a readonly oci-engine file on create"; return 0; fi
  if [ "$LAST_RC" -ne 0 ]; then record "$id" BLOCKED "acq create with oci-engine exited $LAST_RC (see transcript)"; return 0; fi
  run_cmd "$STEP_TIMEOUT" msb exec "$n" -u 0 -- sh -c 'ls /var/lib/acq/host/kit-files 2>&1; test ! -e /home/agent/oci-engine-grant-devs.sh && echo NO-GUEST-COPY-OF-GRANT-SCRIPT'
  need_rc0 "$id" "listing the staged oci-engine files" || return 0
  if last_has 'home-agent-oci-engine-grant-devs-sh.' && last_has 'home-agent-oci-engine-config-oci-engine-storage-driver-sh.' \
      && last_has NO-GUEST-COPY-OF-GRANT-SCRIPT; then
    msb_inspect_check "$n"; irc=$?
    if [ "$irc" -eq 2 ]; then record "$id" BLOCKED "msb inspect failed, timed out, or returned unusable output"; return 0; fi
    if [ "$irc" -ne 0 ]; then record "$id" FAIL "inspect does not show the read-only Bind"; return 0; fi
    record "$id" PASS "oci-engine readonly files were staged on the read-only mount, not copied to the guest, and inspect shows the read-only Bind"
  else
    record "$id" FAIL "oci-engine readonly files were not staged as expected, or inspect lacks the read-only Bind"
  fi
}

# --- SBX steps ------------------------------------------------------------------
SBX_READY=0; SBX_A=""; SBX_A_OK=0
sbx_preflight() {
  if ! command -v sbx >/dev/null 2>&1; then say "sbx: not on PATH"; return 0; fi
  probe "$STEP_TIMEOUT" sbx version
  if [ "$PROBE_RC" -ne 0 ]; then say "sbx: 'sbx version' failed or timed out (rc $PROBE_RC)"; return 0; fi
  SBX_VER=$(printf '%s\n' "$PROBE_OUT" | grep -oE 'v?[0-9]+\.[0-9]+\.[0-9]+' | head -n1)
  [ -n "$SBX_VER" ] || SBX_VER="unparsed"
  SBX_READY=1
}

sbx_record_path() { printf '%s/builtin-kits\n' "$(hc_dir sbx "$1")"; }

step_sbx_baseline() {
  local id=sbx-baseline n ws rec
  block_if_not_ready "$id" "$SBX_READY" "sbx not on PATH" || return 0
  n=$(sandbox_name s); SBX_A="$n"
  ws=$(mk_workspace s) || { record "$id" BLOCKED "cannot create a workspace under $WS_ROOT"; return 0; }
  create_sandbox sbx "$n" "$ws"
  need_rc0 "$id" "acq create on sbx (login, Docker, or provider setup?)" || return 0
  rec=$(sbx_record_path "$n")
  if [ -s "$rec" ]; then
    SBX_A_OK=1
    say "  builtin-kits record has $(grep -c . "$rec") line(s): $(cut -d' ' -f1 "$rec" | tr '\n' ' ')"
    record "$id" PASS "fresh create seeded a host builtin-kits record ($rec)"
  else
    record "$id" FAIL "fresh create left no host builtin-kits record at $rec"
  fi
}

step_sbx_forged_heal() {
  local id=sbx-forged-heal before after
  [ "$SBX_A_OK" -eq 1 ] || { record "$id" BLOCKED "needs the sandbox from sbx-baseline"; return 0; }
  run_cmd "$STEP_TIMEOUT" sbx exec "$SBX_A" -- sh -c 'test -e /home/agent/usai-config/opencode.jsonc && echo PRESENT'
  need_rc0 "$id" "probing that the provider config exists" || return 0
  last_has PRESENT || { record "$id" BLOCKED "the provider config did not exist before removal, so its absence afterwards proves nothing"; return 0; }
  run_cmd "$STEP_TIMEOUT" sbx exec "$SBX_A" -- sudo sh -c 'rm -f /usr/local/share/ca-certificates/zscaler-ca.crt /home/agent/usai-config/opencode.jsonc; rm -f /home/agent/.agentic-coding-playbook/AGENTS.md; echo REMOVED'
  need_rc0 "$id" "removing the guest files as root" || return 0
  last_has REMOVED || { record "$id" BLOCKED "could not remove the guest files as root (sudo unavailable?)"; return 0; }
  [ -s "$(sbx_record_path "$SBX_A")" ] || { record "$id" BLOCKED "host builtin-kits record is missing before the re-attach"; return 0; }
  before=$(cksum <"$(sbx_record_path "$SBX_A")")
  run_cmd "$CREATE_TIMEOUT" "$ACQ" --backend sbx run "$SBX_A" -- --version
  after=$(cksum <"$(sbx_record_path "$SBX_A")")
  need_rc0 "$id" "re-attach" || return 0
  [ -s "$(sbx_record_path "$SBX_A")" ] || { record "$id" FAIL "the host builtin-kits record disappeared after re-attach"; return 0; }
  if last_has "injecting with 'sbx kit add'" || last_has "injected into"; then
    record "$id" FAIL "re-attach re-applied a kit although the host record was current"; return 0
  fi
  run_cmd "$STEP_TIMEOUT" sbx exec "$SBX_A" -- sh -c 'test ! -e /home/agent/usai-config/opencode.jsonc && echo STILL-ABSENT'
  need_rc0 "$id" "post-heal absence probe" || return 0
  if [ "$before" = "$after" ] && last_has STILL-ABSENT; then record "$id" PASS "re-attach did not re-apply removed guest files while the host builtin-kits record was current"
  else record "$id" FAIL "host record changed or the removed guest file reappeared after re-attach"; fi
}

step_sbx_record_change() {
  local id=sbx-record-change rec missing="" k
  [ "$SBX_A_OK" -eq 1 ] || { record "$id" BLOCKED "needs the sandbox from sbx-baseline"; return 0; }
  rec=$(sbx_record_path "$SBX_A")
  [ -s "$rec" ] || { record "$id" BLOCKED "host builtin-kits record is missing before the change"; return 0; }
  cp "$rec" "$OUT/builtin-kits.saved" || { record "$id" BLOCKED "cannot save the original record"; return 0; }
  sed 's/#ref=[0-9a-f]\{40\}/#ref=0000000000000000000000000000000000000000/' "$OUT/builtin-kits.saved" >"$rec.new" && mv -f "$rec.new" "$rec" \
    || { record "$id" BLOCKED "cannot alter the host record"; return 0; }
  cmp -s "$rec" "$OUT/builtin-kits.saved" && { record "$id" BLOCKED "the record had no 40-hex refs to alter (format changed?)"; return 0; }
  say "  altered the host builtin-kits record (refs replaced with zeros); original saved in $OUT"
  run_cmd "$CREATE_TIMEOUT" "$ACQ" --backend sbx run "$SBX_A" -- --version
  need_rc0 "$id" "acq run (re-attach)" || return 0
  for k in "Zscaler CA kit" "provider kit" "playbook kit"; do
    last_has "is missing the $k; injecting with 'sbx kit add'" || missing="${missing}${k}, "
  done
  if [ -z "$missing" ]; then
    record "$id" PASS "altering the host record made the heal attempt kit add for all three record-tracked kits (Zscaler CA, provider, playbook)"
  else
    record "$id" FAIL "no kit add attempt for: ${missing%, }"
  fi
}

step_sbx_stale_refresh() {
  local id=sbx-stale-refresh pf missing="" k
  [ "$SBX_A_OK" -eq 1 ] || { record "$id" BLOCKED "needs the sandbox from sbx-baseline"; return 0; }
  pf=$(prov_file sbx "$SBX_A")
  [ -n "$pf" ] && [ -s "$pf" ] || { record "$id" BLOCKED "no provenance record for $SBX_A, so staleness cannot be forced"; return 0; }
  cp "$pf" "$OUT/provenance.saved" || { record "$id" BLOCKED "cannot save the provenance record"; return 0; }
  awk '/^applied_ref=/ { print "applied_ref=0000000000000000000000000000000000000000"; next } { print }' "$OUT/provenance.saved" >"$pf.new" \
    && mv -f "$pf.new" "$pf" || { record "$id" BLOCKED "cannot make the provenance record stale"; return 0; }
  say "  made ONLY the provenance record of $SBX_A stale ($pf); no other sandbox is touched"
  run_cmd "$STEP_TIMEOUT" "$ACQ" --backend sbx kit check "$SBX_A"
  need_rc0 "$id" "acq kit check" || return 0
  last_has "stale" || { record "$id" BLOCKED "acq kit check did not report stale after the edit; refresh would be a no-op"; return 0; }
  run_cmd "$CREATE_TIMEOUT" "$ACQ" --backend sbx kit update "$SBX_A" --yes
  if last_has "sbx >= 0.38"; then
    record "$id" BLOCKED "sbx $SBX_VER cannot extend a live sandbox with startup-bearing kits: refresh prints the recreate notice instead of re-applying (documented limit, not a refresh result)"; return 0
  fi
  need_rc0 "$id" "acq kit update" || return 0
  for k in "Zscaler CA kit injected" "provider kit injected" "playbook kit injected" "git-ssh-sign kit refreshed"; do
    last_has "$k" || missing="${missing}${k}, "
  done
  if last_has "warning:"; then record "$id" FAIL "kit update reported a warning although it exited 0 (see transcript)"; return 0; fi
  if [ -n "$missing" ]; then record "$id" FAIL "kit update exited 0 but did not report: ${missing%, }"; return 0; fi
  run_cmd "$STEP_TIMEOUT" "$ACQ" --backend sbx kit check "$SBX_A"
  need_rc0 "$id" "acq kit check after refresh" || return 0
  if last_has "current"; then record "$id" PASS "forced stale refresh exited 0, reported all four named kits applied, and provenance is current again"
  else record "$id" FAIL "kit update reported success but provenance is not current afterwards"; fi
}

step_sbx_legacy_reseed() {
  local id=sbx-legacy-reseed rec ws
  [ "$SBX_A_OK" -eq 1 ] || { record "$id" BLOCKED "needs the sandbox from sbx-baseline"; return 0; }
  rec=$(sbx_record_path "$SBX_A")
  rm -f "$rec"
  run_cmd "$CREATE_TIMEOUT" "$ACQ" --backend sbx run "$SBX_A" -- --version
  need_rc0 "$id" "acq run (re-attach of the legacy sandbox)" || return 0
  [ "$SBX_VER" != unparsed ] || { record "$id" BLOCKED "sbx version could not be parsed, so the 0.38+ notice expectation cannot be applied"; return 0; }
  if ver_ge "${SBX_VER#v}" 0.38.0; then
    if [ "$(last_count 'sbx >= 0.38')" -ne 1 ]; then record "$id" FAIL "expected exactly one consolidated recreate notice on sbx $SBX_VER, saw $(last_count 'sbx >= 0.38')"; return 0; fi
  fi
  run_cmd "$CREATE_TIMEOUT" "$ACQ" --backend sbx rm "$SBX_A"
  need_rc0 "$id" "acq rm" || return 0
  SBX_A_OK=0
  ws=$(mk_workspace s2) || { record "$id" BLOCKED "cannot create a workspace"; return 0; }
  create_sandbox sbx "$SBX_A" "$ws"
  need_rc0 "$id" "acq create after rm" || return 0
  if [ -s "$rec" ]; then record "$id" PASS "legacy notice shown once; acq rm plus a fresh create re-seeded the builtin-kits record"
  else record "$id" FAIL "fresh create after rm did not re-seed the host builtin-kits record"; fi
}

# --- driver -------------------------------------------------------------------
say "verify-host-authority-live"
say "revision : $REVISION$DIRTY"
say "date     : $RUN_DATE"
say "host     : $(uname -srm 2>/dev/null || echo unknown)"
say "out dir  : $OUT"
say "run from OUTSIDE any sandbox; transcript: $TRANSCRIPT"
msb_preflight
sbx_preflight
say "msb      : ${MSB_VER:-not available} (ready: $MSB_READY)"
say "sbx      : ${SBX_VER:-not available} (ready: $SBX_READY)"
say ""
print_plan

run_step() { # ID FUNCTION
  step_selected "$1" || return 0
  say ""
  say "--- $1: $(step_title "$1") ---"
  STEP_TIMED_OUT=0; STEP_DEADLINE=$((SECONDS + STEP_BUDGET))
  "$2"
  STEP_DEADLINE=0
  if [ "$STEP_TIMED_OUT" -eq 1 ]; then say "!! BLOCKED(timeout): $1 had a command time out (budget ${STEP_BUDGET}s per step); see the transcript above"; fi
}
run_step msb-ro-kit-create step_msb_ro_kit_create
run_step msb-inspect-shape step_msb_inspect_shape
run_step msb-exit-code step_msb_exit_code
run_step msb-ro-kit-heal step_msb_ro_kit_heal
run_step msb-forged-markers step_msb_forged_markers
run_step msb-install-gate step_msb_install_gate
run_step msb-ro-oci step_msb_ro_oci
run_step sbx-baseline step_sbx_baseline
run_step sbx-forged-heal step_sbx_forged_heal
run_step sbx-record-change step_sbx_record_change
run_step sbx-stale-refresh step_sbx_stale_refresh
run_step sbx-legacy-reseed step_sbx_legacy_reseed

exit 0
