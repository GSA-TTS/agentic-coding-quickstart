#!/bin/sh
# Fill the provenance contract without claiming a signed dry-run attestation.
set -eu
[ "$#" -eq 1 ] || { echo 'usage: gen-provenance <dist-dir>' >&2; exit 1; }
repo_root="$(cd "$(dirname "$0")/.." && pwd)"
python3 -I - "$repo_root" "$1" <<'PY'
import json
import os
from pathlib import Path
import subprocess
import sys

repo, dist = map(Path, sys.argv[1:])
if not dist.is_dir():
    sys.exit('dist directory must exist')
data = json.loads((repo / 'installer/provenance.json').read_text())
data['acq']['acq_version'] = os.environ.get('ACQ_BUILD_VERSION') or json.loads((repo / 'package.json').read_text())['version']
data['acq']['source_revision'] = os.environ.get('ACQ_BUILD_REVISION') or subprocess.check_output(
    ['git', '-C', str(repo), 'rev-parse', 'HEAD'], text=True).strip()
# The workflow sets ACQ_BUILD_RUNTIME_VERSION beside its runtime pins; the
# default matches them for local runs.
runtime_version = os.environ.get('ACQ_BUILD_RUNTIME_VERSION') or '3.14.10'
assets = json.loads((repo / 'installer/assets.json').read_text())
for platform, spec in assets['platforms'].items():
    data['runtimes'][platform] = {
        'supplier': spec['components']['runtime']['supplier'],
        'version': runtime_version,
    }
data['runtime']['supplier'] = 'see runtimes for each platform'
data['runtime']['version'] = runtime_version
data['verification']['attestation'] = 'not generated by the dry-run build; workflow artifacts only'
(dist / 'provenance.json').write_text(json.dumps(data, indent=2) + '\n', encoding='utf-8')
PY
