#!/usr/bin/env bash
# Run bounded ShellCheck batches concurrently without interleaving file discovery.
set -uo pipefail

if [ "$#" -eq 0 ]; then
  exit 0
fi

_jobs="${SHELLCHECK_JOBS:-$( (command -v nproc >/dev/null 2>&1 && nproc) || sysctl -n hw.ncpu 2>/dev/null || echo 1 )}"
case "$_jobs" in
  ''|*[!0-9]*|0*) echo 'run-shellcheck: SHELLCHECK_JOBS must be a positive integer without leading zeros' >&2; exit 2 ;;
esac
if ! [ "$_jobs" -ge 1 ] 2>/dev/null; then
  echo 'run-shellcheck: SHELLCHECK_JOBS exceeds the supported integer range' >&2
  exit 2
fi
# Four concurrent batches stay below the former dataflow-analysis memory ceiling.
[ "$_jobs" -le 4 ] || _jobs=4

# Give xargs and its ShellCheck children their own process group so cancellation
# reaches every concurrent batch rather than leaving linters behind.
set -m
xargs -0 -n8 -P "$_jobs" shellcheck --severity=warning < <(printf '%s\0' "$@") &
_xargs_pid=$!
_cleanup() {
  trap - TERM INT HUP
  kill -TERM -- "-$_xargs_pid" 2>/dev/null || true
  wait "$_xargs_pid" 2>/dev/null || true
  exit "$1"
}
trap '_cleanup 143' TERM
trap '_cleanup 130' INT
trap '_cleanup 129' HUP
wait "$_xargs_pid"
_status=$?
trap - TERM INT HUP
exit "$_status"
