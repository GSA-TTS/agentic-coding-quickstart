#!/bin/sh
# acq-python — launcher for the Python acq v1 implementation (coexistence seam,
# ADR-0046m).
#
# The Python implementation has a distinct, resolvable identity so it never
# collides with the Bash `acq` name on a user's PATH. The Bash `acq` dispatcher
# execs this launcher when ACQ_IMPL=python (see the resolver in `acq`), and the
# installer links it as `acq-python` beside `acq`. It can also be invoked
# directly (`acq-python version`) to run the Python implementation explicitly.
#
# Interpreter resolution order (mirrors acq_py/runtime.py):
#   1. ACQ_RUNTIME                       explicit interpreter path (tests, fleet)
#   2. <dir>/py-acq/runtime/bin/python3   managed runtime (POSIX), or
#      <dir>/py-acq/runtime/python.exe    managed runtime (Windows)
#   3. python3 / python on PATH           IT-approved base fallback
#
# The source is run from <dir>/py-acq/src via `python -m acq_py`; argv and the
# exit status are forwarded verbatim.

set -eu

# Resolve the absolute directory containing this script, following symlinks.
_self_dir() {
  src="$1" dir=""
  while [ -h "$src" ]; do
    dir=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd) || exit 1
    src=$(readlink "$src") || exit 1
    case "$src" in
      /*) ;;
      *) src="$dir/$src" ;;
    esac
  done
  cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd
}

SELF_DIR=$(_self_dir "$0") || { echo "acq-python: could not resolve script directory" >&2; exit 1; }

py=""
if [ -n "${ACQ_RUNTIME:-}" ] && [ -x "${ACQ_RUNTIME}" ]; then
  py="$ACQ_RUNTIME"
elif [ -x "$SELF_DIR/py-acq/runtime/bin/python3" ]; then
  py="$SELF_DIR/py-acq/runtime/bin/python3"
elif [ -x "$SELF_DIR/py-acq/runtime/python.exe" ]; then
  py="$SELF_DIR/py-acq/runtime/python.exe"
elif command -v python3 >/dev/null 2>&1; then
  py="$(command -v python3)"
elif command -v python >/dev/null 2>&1; then
  py="$(command -v python)"
else
  echo "acq-python: no Python interpreter found (set ACQ_RUNTIME, install the runtime, or put python3 on PATH)" >&2
  exit 1
fi

if [ -d "$SELF_DIR/py-acq/src" ]; then
  PYTHONPATH="$SELF_DIR/py-acq/src${PYTHONPATH:+:$PYTHONPATH}" exec "$py" -m acq_py "$@"
fi
exec "$py" -m acq_py "$@"
