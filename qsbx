#!/bin/bash
#
# qsbx — sbx wrapper that mounts a shared "quickstart" config clone into sandboxes
#
# Problem: each new sbx sandbox is fresh, with no access to your persistent
# global config (agent settings, AGENTS.md, skills, etc.). Without this, you end
# up copying those files into every sandbox and manually keeping them in sync.
#
# Solution: when qsbx creates a sandbox it applies THREE sbx mixin kits from the
# community agentic-coding-patterns repo, by remote reference pinned to a commit
# (see PATTERNS_KIT_REF below), so every sandbox is configured declaratively:
#   1. usai-provider     — configures the USAi OpenCode provider (drops
#      ~/usai-config/opencode.jsonc and sets OPENCODE_CONFIG; allow-lists USAi
#      egress).
#   2. agentic-coding-playbook — at container startup, clones the playbook at a
#      pinned ref and symlinks its AGENTS.md + skills into each agent's search
#      paths.
#   3. zscaler-ca-certificate  — installs the public Zscaler Root CA into the
#      sandbox trust store, so HTTPS works on Zscaler-inspecting hosts (harmless
#      no-op elsewhere).
# The kits live in GSA-TTS/agentic-coding-patterns under
# integrations/isolation/sbx-kits/. qsbx no longer carries copies of them; this
# repo just wires them together into one comprehensible path to a working
# sandbox. Set QSBX_EXTRA_KITS to apply additional kits on every invocation
# without repeating --kit flags. Before attaching with `qsbx run`, it also
# checks that the sandbox's USAi key works and, if not, offers to rotate it. All
# other subcommands pass straight through to sbx.
#
# Remote kits require the source prefix to be on sbx's kit.allowedSources
# allowlist (a v0.34 safety gate). qsbx adds it automatically at the start of any
# create/run — no manual `sbx settings` step. See ensure_kit_sources_allowed().
#
# qsbx is also the single entry point for this repo's sbx extensions:
#   qsbx usai-rotate-api-key   # rotate the USAi key secret (scripts/rotate-apikey)

set -euo pipefail

# Resolve the absolute directory containing this script, following symlinks so
# qsbx works when invoked via a symlink on PATH. Portable across macOS (whose
# BSD `readlink` lacks `-f`) and Linux: walk the symlink chain manually.
script_dir() {
  local src="${BASH_SOURCE[0]}" dir
  while [ -h "$src" ]; do
    dir=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)
    src=$(readlink "$src")
    # Resolve relative symlink targets against the link's directory.
    case "$src" in
      /*) ;;
      *) src="$dir/$src" ;;
    esac
  done
  cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd
}

# Absolute directory of this script, used both as the default clone location and
# to locate sibling scripts (scripts/rotate-apikey).
SCRIPT_DIR=$(script_dir) || { echo "qsbx: could not resolve script directory" >&2; exit 1; }

# The quickstart clone defaults to this script's directory; QUICKSTART_CLONE
# overrides it if exported. Used only to locate sibling helper scripts and to
# support editing this repo as a project — the kits themselves are remote (below).
QUICKSTART_CLONE="${QUICKSTART_CLONE:-$SCRIPT_DIR}"

# ============================================================================
# KITS — the three sbx mixin kits applied to every sandbox, sourced from the
# community agentic-coding-patterns repo. To adopt newer kits, bump the pinned
# commit below (sbx requires remote kit refs to be a full 40-char commit SHA).
# ============================================================================
PATTERNS_KIT_REPO="git+https://github.com/GSA-TTS/agentic-coding-patterns.git"
PATTERNS_KIT_REF="598a57cb9f5fd2e279046a5e740a7e9ea8173c71"  # -patterns main @ PR #191 merge
PATTERNS_KIT_DIR="integrations/isolation/sbx-kits"

# Remote kit references (repo#ref=<sha>&dir=<subpath>). Applied in order via
# repeated --kit; mixins compose. Order: provider, then playbook, then CA.
USAI_KIT="${PATTERNS_KIT_REPO}#ref=${PATTERNS_KIT_REF}&dir=${PATTERNS_KIT_DIR}/usai-provider-kit"
PLAYBOOK_KIT="${PATTERNS_KIT_REPO}#ref=${PATTERNS_KIT_REF}&dir=${PATTERNS_KIT_DIR}/playbook-kit"
ZSCALER_KIT="${PATTERNS_KIT_REPO}#ref=${PATTERNS_KIT_REF}&dir=${PATTERNS_KIT_DIR}/zscaler-ca-certificate"

# Additional user-supplied kits. Set QSBX_EXTRA_KITS to a whitespace-separated
# list of kit references (local paths or remote refs) to apply on every sandbox,
# so you don't have to pass a long series of --kit flags each invocation. E.g.:
#   export QSBX_EXTRA_KITS="./my-kit git+https://github.com/acme/kits.git#ref=<sha>&dir=foo"
# These are appended AFTER the three built-in kits (later kits win on conflicting
# env vars / overlay files, per sbx composition). Remote extras from a new host
# still need their prefix on kit.allowedSources — see QSBX_EXTRA_KIT_SOURCES.
QSBX_EXTRA_KITS="${QSBX_EXTRA_KITS:-}"

# Word-split a whitespace-separated env value into the named array WITHOUT
# filename globbing (a literal `*` in a kit ref must not expand against the cwd).
# Usage: split_noglob ARRAYNAME "$VALUE"
split_noglob() {
  local _name="$1" _val="$2" _oldopts
  _oldopts=$(set +o); set -f
  # shellcheck disable=SC2086
  set -- $_val
  eval "$_oldopts"
  eval "$_name=(\"\$@\")"
}

# Assemble the full ordered kit list once: the three built-ins, then extras.
KITS=("$USAI_KIT" "$PLAYBOOK_KIT" "$ZSCALER_KIT")
if [ -n "$QSBX_EXTRA_KITS" ]; then
  split_noglob _extra_kits "$QSBX_EXTRA_KITS"
  # shellcheck disable=SC2154  # assigned indirectly by split_noglob via eval
  KITS+=("${_extra_kits[@]}")
fi

# Emit the --kit flags for the full kit list on stdout (one token per line) so
# callers can collect them into an array. Keeps the three create sites in sync.
kit_flags() {
  local k
  for k in "${KITS[@]}"; do
    printf '%s\n%s\n' "--kit" "$k"
  done
}

# The kit.allowedSources prefixes qsbx must ensure are allowlisted so the remote
# refs above resolve. Entries match as PATH-SEGMENT prefixes WITHOUT the scheme
# (per sbx docs), so this covers github.com/GSA-TTS/agentic-coding-patterns.
# Users applying remote extras from other hosts can add prefixes here via
# QSBX_EXTRA_KIT_SOURCES (whitespace-separated), e.g. "github.com/acme/".
KIT_SOURCE_PREFIX="github.com/GSA-TTS/"
QSBX_EXTRA_KIT_SOURCES="${QSBX_EXTRA_KIT_SOURCES:-}"
KIT_SOURCE_PREFIXES=("$KIT_SOURCE_PREFIX")
if [ -n "$QSBX_EXTRA_KIT_SOURCES" ]; then
  split_noglob _extra_sources "$QSBX_EXTRA_KIT_SOURCES"
  # shellcheck disable=SC2154  # assigned indirectly by split_noglob via eval
  KIT_SOURCE_PREFIXES+=("${_extra_sources[@]}")
fi

# In-place auto-heal of sandboxes created before the kit migration is currently
# DISABLED, gated behind this flag, because of an upstream sbx bug: `sbx kit add`
# fails ("failed to read tar header: unexpected EOF") on any kit that ships a
# static files/ payload (docker/sbx-releases#133). The usai-provider kit ships
# files/opencode.jsonc, so it cannot be injected into a running sandbox — and a
# sandbox without the USAi provider config is unusable (no OPENCODE_CONFIG, no
# endpoint, no models), so healing only the other two kits is pointless. Instead
# of a doomed `sbx kit add`, qsbx offers an assisted session migration (see
# migrate_or_halt) or halts with documented options. Re-enable this (export
# QSBX_AUTOHEAL_KITS=1) once #133 is fixed and `sbx kit add` on usai-provider is
# verified. The healing code is preserved in ensure_kit_applied for that day.
# Tracking: GSA-TTS/agentic-coding-quickstart#188.
QSBX_AUTOHEAL_KITS="${QSBX_AUTOHEAL_KITS:-0}"

USAI_MODELS_URL="https://api.gsa.usai.gov/api/v1/models"
KEY_MGMT_URL="https://console.gsa.usai.gov/key-management"

# Minimum sbx version qsbx requires. Remote SHA-pinned kit refs + the v2 kit
# schema + `sbx policy init` all landed in sbx 0.34.0.
MIN_SBX_VERSION="0.34.0"

# Standalone helper scripts that qsbx fronts as subcommands. They remain runnable
# on their own; qsbx is just the single entry point for this repo's sbx extras.
ROTATE_SCRIPT="$SCRIPT_DIR/scripts/rotate-apikey"

# Agents understood by `sbx run AGENT [PATH...]`. Used to tell whether the first
# positional after `run` is an agent (create-if-missing form) or the name of an
# existing sandbox. qsbx always identifies sandboxes with `--name` (sbx's
# preferred form); a bare sandbox positional is still accepted and rewritten to
# `--name <sandbox>` since the positional-sandbox form is deprecated in sbx.
# Note: a sandbox literally named after an agent (e.g. `shell`) is treated as the
# agent form; attach such sandboxes with `sbx run --name <sandbox>` directly.
KNOWN_AGENTS=" claude codex copilot cursor docker-agent droid gemini kiro opencode shell "

# Ensure the kit source prefixes qsbx needs are on sbx's kit.allowedSources
# allowlist, so the remote --kit refs resolve. sbx v0.34 restricts kit installs
# to an allowlist of source prefixes (default: ["docker.io/"]); a Git URL fails
# until its host/path prefix is added. Rather than make this a documented manual
# setup step, qsbx ensures the prefixes are present at the top of any create/run.
#
# Important semantics (per sbx docs):
#   - The value is a JSON array; `settings set` REPLACES the whole list, so we
#     read the current list and add only missing prefixes, preserving existing
#     entries (notably the default "docker.io/").
#   - Entries are scheme-less, matched as prefixes on a path-segment boundary
#     (e.g. "github.com/GSA-TTS/"), NOT "git+https://..." URLs.
#
# FAIL SAFE: this rewrites a GLOBAL sbx policy list, so we never write a guess.
# We only add prefixes when we can read the current value AND parse it as a JSON
# array (via jq). If jq is missing, the read fails, or the value isn't an array
# (e.g. a transient/flaky read), we warn and print the manual command but DO NOT
# write — so a blip can't silently narrow or corrupt an operator's allowlist.
# Prefixes are added with `jq --arg` (never string-concatenated), so a stray
# quote in QSBX_EXTRA_KIT_SOURCES can't inject an array element.
ensure_kit_sources_allowed() {
  local current desired

  if ! command -v jq >/dev/null 2>&1; then
    _kit_sources_manual_hint "jq not found; cannot safely update the allowlist"
    return 0
  fi

  current=$(sbx settings get kit.allowedSources 2>/dev/null || true)

  # Validate: must be a JSON array. Anything else (empty, error text, object) is
  # treated as unreadable — warn, don't write.
  if ! printf '%s' "$current" | jq -e 'type == "array"' >/dev/null 2>&1; then
    _kit_sources_manual_hint "could not read kit.allowedSources as a JSON array"
    return 0
  fi

  # Compute the new array = current followed by any required prefixes not already
  # present (order preserved, deduped). Prefixes come in as jq args, so a stray
  # quote can't inject an element.
  desired=$(printf '%s' "$current" | jq -c --args \
    'reduce $ARGS.positional[] as $p (.; if index($p) then . else . + [$p] end)' \
    "${KIT_SOURCE_PREFIXES[@]}" 2>/dev/null)
  if [ -z "$desired" ]; then
    _kit_sources_manual_hint "failed to compute updated allowlist"
    return 0
  fi

  # No change needed? (current already contained every required prefix)
  if [ "$(printf '%s' "$current" | jq -cS .)" = "$(printf '%s' "$desired" | jq -cS .)" ]; then
    return 0
  fi

  if sbx settings set kit.allowedSources "$desired" </dev/null >/dev/null 2>&1; then
    echo "qsbx: updated sbx kit.allowedSources to: $(printf '%s' "$desired" | jq -r '.[]' | tr '\n' ' ')" >&2
  else
    _kit_sources_manual_hint "could not write kit.allowedSources"
  fi
}

# Print a warning + the exact manual command to allow the required prefixes,
# using jq to build a well-formed array from whatever is currently set (falling
# back to the documented default). Never writes anything.
_kit_sources_manual_hint() {
  local reason="$1" cmd cur
  echo "qsbx: warning: $reason." >&2
  if command -v jq >/dev/null 2>&1; then
    cur=$(sbx settings get kit.allowedSources 2>/dev/null || true)
    printf '%s' "$cur" | jq -e 'type == "array"' >/dev/null 2>&1 || cur='["docker.io/"]'
    cmd=$(printf '%s' "$cur" | jq -c --args \
      'reduce $ARGS.positional[] as $p (.; if index($p) then . else . + [$p] end)' \
      "${KIT_SOURCE_PREFIXES[@]}" 2>/dev/null)
  fi
  [ -z "${cmd:-}" ] && cmd='["docker.io/","github.com/GSA-TTS/"]'
  echo "      If kit resolution fails, review the current value and run (the" >&2
  echo "      setting REPLACES the whole list — keep the entries you want):" >&2
  echo "        sbx settings set kit.allowedSources '${cmd}'" >&2
}

# Print a warning + the exact manual command to allow the required prefixes,
# using jq to build a well-formed array from whatever is currently set (falling
# back to the documented default). Never writes anything.
_kit_sources_manual_hint() {
  local reason="$1" cmd cur
  echo "qsbx: warning: $reason." >&2
  if command -v jq >/dev/null 2>&1; then
    cur=$(sbx settings get kit.allowedSources 2>/dev/null || true)
    printf '%s' "$cur" | jq -e 'type == "array"' >/dev/null 2>&1 || cur='["docker.io/"]'
    cmd=$(printf '%s' "$cur" | jq -c --args '. + ($ARGS.positional) | reduce .[] as $x ([]; if any(.[]; . == $x) then . else . + [$x] end)' "${KIT_SOURCE_PREFIXES[@]}" 2>/dev/null)
  fi
  [ -z "${cmd:-}" ] && cmd='["docker.io/","github.com/GSA-TTS/"]'
  echo "      If kit resolution fails, review the current value and run (the" >&2
  echo "      setting REPLACES the whole list — keep the entries you want):" >&2
  echo "        sbx settings set kit.allowedSources '${cmd}'" >&2
}

# Compare two dotted version strings. Echoes 0 if A >= B, 1 otherwise. Pads
# missing components with 0 and compares numerically per component, so e.g.
# 0.34 >= 0.34.0 and 0.34.1 >= 0.34.0. Non-numeric suffixes on a component
# (e.g. a "-rc1") are stripped to their leading digits before comparison.
version_ge() {
  local a="$1" b="$2" i a_part b_part
  local -a a_arr b_arr
  IFS='.' read -r -a a_arr <<EOF
$a
EOF
  IFS='.' read -r -a b_arr <<EOF
$b
EOF
  for i in 0 1 2; do
    a_part=${a_arr[i]:-0}; b_part=${b_arr[i]:-0}
    a_part=${a_part%%[!0-9]*}; b_part=${b_part%%[!0-9]*}
    a_part=${a_part:-0}; b_part=${b_part:-0}
    if [ "$a_part" -gt "$b_part" ]; then echo 0; return; fi
    if [ "$a_part" -lt "$b_part" ]; then echo 1; return; fi
  done
  echo 0
}

# Require sbx >= MIN_SBX_VERSION. The kit workflow depends on v2-schema kit
# support and `sbx policy init`, both introduced in 0.34.0. If sbx is missing or
# its version can't be parsed, warn but don't block (don't fail closed on a
# version we simply couldn't read).
require_sbx_version() {
  if ! command -v sbx >/dev/null 2>&1; then
    echo "error: sbx CLI not found on PATH. Install sbx >= $MIN_SBX_VERSION." >&2
    echo "       See README.md (Step 2: Install sbx CLI)." >&2
    exit 1
  fi

  local raw current
  # `sbx version` prints e.g. "sbx version: v0.34.0 <sha>". Extract the first
  # dotted-numeric token, tolerating a leading "v".
  raw=$(sbx version 2>/dev/null || true)
  current=$(printf '%s\n' "$raw" | grep -oE 'v?[0-9]+\.[0-9]+(\.[0-9]+)?' | head -n1 | sed 's/^v//')

  if [ -z "$current" ]; then
    echo "qsbx: warning: could not determine sbx version (need >= $MIN_SBX_VERSION); continuing." >&2
    return 0
  fi

  if [ "$(version_ge "$current" "$MIN_SBX_VERSION")" -ne 0 ]; then
    echo "error: qsbx requires sbx >= $MIN_SBX_VERSION, but found $current." >&2
    echo "       qsbx applies this repo as an sbx kit (--kit), which needs v0.34.0+." >&2
    echo "       Upgrade sbx (see README.md, Step 2) and retry." >&2
    exit 1
  fi
}

# Canonicalize a directory path to an absolute, symlink-resolved form so we can
# compare a user-supplied workspace path against the clone dir. Echoes nothing
# if the path does not exist / is not a directory.
canonical_dir() {
  [ -d "$1" ] || return 0
  ( cd -P "$1" >/dev/null 2>&1 && pwd )
}

# True if PATH (a create/run positional) refers to the quickstart clone itself.
is_clone_path() {
  local resolved
  resolved=$(canonical_dir "$1")
  [ -n "$resolved" ] && [ "$resolved" = "$QUICKSTART_CLONE" ]
}

is_known_agent() {
  case "$KNOWN_AGENTS" in
    *" $1 "*) return 0 ;;
    *) return 1 ;;
  esac
}

# True if PREV is a flag that consumes the next argument as its value.
takes_value() {
  case "$1" in
    --name|--template|-t|--profile|--cpus|--memory|-m|--kit) return 0 ;;
    *) return 1 ;;
  esac
}

# Find the first non-flag positional in a create/run arg list, skipping flags
# and their values (e.g. `--name custom`). Echoes the token, or nothing.
first_positional() {
  local prev=""
  for arg in "$@"; do
    if takes_value "$prev"; then
      prev="$arg"
      continue
    fi
    case "$arg" in
      -*) prev="$arg"; continue ;;
    esac
    printf '%s\n' "$arg"
    return 0
  done
}

# Normalize a string into sbx's sandbox-name slug rules: lowercase, every run
# of non-alphanumerics collapsed to a single hyphen, leading/trailing hyphens
# trimmed. (Verified against sbx 0.32.0: My_App -> my-app, "with space" ->
# with-space, under_score_x -> under-score-x.)
slugify() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -e 's/[^a-z0-9]\{1,\}/-/g' -e 's/^-*//' -e 's/-*$//'
}

# Derive the sandbox name qsbx will own and pass to BOTH `sbx create --name` and
# the existence check, so the two always agree (rather than reconstructing and
# guessing at sbx's auto-generated slug). Honors an explicit `--name NAME`;
# otherwise builds "<agent>-<slug-of-basename>" using sbx's normalization rules.
derive_name() {
  local agent="" first_path="" prev=""
  for arg in "$@"; do
    if [ "$prev" = "--name" ]; then
      printf '%s\n' "$arg"
      return 0
    fi
    case "$arg" in
      --name=*)
        printf '%s\n' "${arg#--name=}"
        return 0
        ;;
    esac
    prev="$arg"
  done

  # No explicit --name: agent is the first non-flag token, path the next one.
  prev=""
  for arg in "$@"; do
    if takes_value "$prev"; then prev="$arg"; continue; fi
    case "$arg" in
      -*) prev="$arg"; continue ;;
    esac
    if [ -z "$agent" ]; then
      agent="$arg"
    elif [ -z "$first_path" ]; then
      first_path="${arg%%:*}"   # strip any :ro suffix
      break
    fi
    prev="$arg"
  done

  if [ -z "$agent" ]; then
    echo "error: could not determine agent for sandbox name" >&2
    return 1
  fi

  local base="."
  [ -n "$first_path" ] && base=$(basename "$first_path")
  [ "$base" = "." ] && base=$(basename "$PWD")
  printf '%s\n' "$(slugify "$agent")-$(slugify "$base")"
}

# Echo an explicit `--name NAME` / `--name=NAME` from an arg list, or nothing.
name_flag() {
  local prev=""
  for arg in "$@"; do
    if [ "$prev" = "--name" ]; then
      printf '%s\n' "$arg"
      return 0
    fi
    case "$arg" in
      --name=*) printf '%s\n' "${arg#--name=}"; return 0 ;;
    esac
    prev="$arg"
  done
}

# Drop any user-supplied `--name NAME` / `--name=NAME` from an arg list. qsbx
# always passes an explicit, derived name to `sbx create`, so the original must
# be removed to avoid a duplicate flag. Result is placed in the STRIPPED_ARGS
# global array (bash can't return arrays directly).
strip_name() {
  STRIPPED_ARGS=()
  local skip=0
  for arg in "$@"; do
    if [ "$skip" -eq 1 ]; then
      skip=0
      continue
    fi
    case "$arg" in
      --name) skip=1; continue ;;
      --name=*) continue ;;
    esac
    STRIPPED_ARGS+=("$arg")
  done
}

# Create a detached sandbox with both kits applied via --kit: the clone itself
# (usai-provider-kit: USAi provider config + egress) and the playbook kit
# (agentic-coding-playbook: clones the playbook at startup and links its
# AGENTS.md + skills into each agent's search paths). No read-only mount and no
# home-dir symlinking are needed any more — the kits do everything declaratively.
# Usage: create_with_config NAME CREATE_ARGS...
create_with_config() {
  ensure_kit_sources_allowed
  local name="$1"
  shift

  strip_name "$@"
  # Collect the --kit flags for all configured kits (built-ins + QSBX_EXTRA_KITS).
  local kf=(); while IFS= read -r line; do kf+=("$line"); done < <(kit_flags)
  # Guard the array expansion for bash 3.2 (macOS default): under `set -u` an
  # empty array expansion is an "unbound variable" error there.
  if [ "${#STRIPPED_ARGS[@]}" -gt 0 ]; then
    sbx create --name "$name" "${kf[@]}" "${STRIPPED_ARGS[@]}"
  else
    sbx create --name "$name" "${kf[@]}"
  fi
}

# Heal a sandbox created before qsbx applied these kits. Such sandboxes may lack
# the USAi provider config (no OPENCODE_CONFIG), the playbook clone, and/or the
# Zscaler CA. We detect each and inject the missing kit into the running sandbox
# with `sbx kit add` — no recreation needed. Best-effort: if the (experimental)
# command fails, warn with the manual recovery step and continue to attach.
#
# Probe discipline: we distinguish "the probe ran and the feature is absent"
# (heal) from "the probe itself failed to run" (skip — a transient exec blip
# must not trigger a redundant kit add). kit_feature_absent runs a test snippet
# that MUST print "present" when the feature exists; it returns:
#   0 = ran, feature absent   1 = ran, feature present   2 = probe failed to run
kit_feature_absent() {
  local name="$1" snippet="$2" out
  out=$(sbx exec "$name" -- sh -c "$snippet" </dev/null 2>/dev/null)
  case "$?" in
    0) [ "$out" = "present" ] && return 1 || return 0 ;;  # ran cleanly
    *) return 2 ;;                                          # exec failed
  esac
}

# In-place kit healing for pre-kit sandboxes. DISABLED by default behind
# QSBX_AUTOHEAL_KITS (see the flag definition above) because upstream #133 breaks
# `sbx kit add` on the file-shipping usai-provider kit. The body is preserved
# intact so it can be re-enabled once #133 is fixed. Callers must not rely on
# this to fix a USAi-less sandbox while the flag is off — use migrate_or_halt.
ensure_kit_applied() {
  local name="$1"

  # Auto-heal is gated off pending upstream sbx#133. When disabled, this is a
  # no-op; sandboxes missing the USAi kit are handled by migrate_or_halt instead.
  [ "$QSBX_AUTOHEAL_KITS" = "1" ] || return 0

  ensure_kit_sources_allowed

  # 1) USAi provider kit: present iff OPENCODE_CONFIG is set.
  if kit_feature_absent "$name" '[ -n "${OPENCODE_CONFIG:-}" ] && echo present'; then
    echo "qsbx: '$name' is missing the USAi kit (no OPENCODE_CONFIG); injecting it" >&2
    echo "      with 'sbx kit add'..." >&2
    if sbx kit add "$name" "$USAI_KIT" </dev/null >/dev/null 2>&1; then
      # A stale ~/.config/opencode/opencode.jsonc symlink (to the removed
      # opencode/ path) is now harmless — OPENCODE_CONFIG takes precedence — but
      # remove it if it dangles so it can't confuse OpenCode or the user.
      sbx exec "$name" -- sh -c \
        'f="$HOME/.config/opencode/opencode.jsonc"; if [ -L "$f" ] && [ ! -e "$f" ]; then rm -f "$f"; fi' \
        </dev/null >/dev/null 2>&1 || true
      echo "qsbx: USAi kit injected into '$name'." >&2
    else
      echo "qsbx: warning: 'sbx kit add' (USAi kit) failed for '$name' (it is EXPERIMENTAL)." >&2
      echo "      Recover with: sbx kit add '$name' '$USAI_KIT'" >&2
    fi
  fi

  # 2) Playbook kit: present iff the startup clone exists. The startup command
  #    runs on the next start after kit add, so it self-heals.
  if kit_feature_absent "$name" 'test -e "$HOME/.agentic-coding-playbook/.git" && echo present'; then
    echo "qsbx: '$name' is missing the playbook kit; injecting it with 'sbx kit add'..." >&2
    if sbx kit add "$name" "$PLAYBOOK_KIT" </dev/null >/dev/null 2>&1; then
      echo "qsbx: playbook kit injected into '$name'. Restart the agent to pick it up." >&2
    else
      echo "qsbx: warning: 'sbx kit add' (playbook kit) failed for '$name' (it is EXPERIMENTAL)." >&2
      echo "      Recover with: sbx kit add '$name' '$PLAYBOOK_KIT'" >&2
    fi
  fi

  # 3) Zscaler CA kit: present iff the installed cert exists.
  if kit_feature_absent "$name" 'test -e /usr/local/share/ca-certificates/zscaler-ca.crt && echo present'; then
    echo "qsbx: '$name' is missing the Zscaler CA kit; injecting it with 'sbx kit add'..." >&2
    if sbx kit add "$name" "$ZSCALER_KIT" </dev/null >/dev/null 2>&1; then
      echo "qsbx: Zscaler CA kit injected into '$name'. Restart the agent to pick it up." >&2
    else
      echo "qsbx: warning: 'sbx kit add' (Zscaler CA kit) failed for '$name' (it is EXPERIMENTAL)." >&2
      echo "      Recover with: sbx kit add '$name' '$ZSCALER_KIT'" >&2
    fi
  fi

  # 4) User-supplied QSBX_EXTRA_KITS. These have no content signature qsbx can
  #    probe, so we track which extras were already applied to this sandbox in a
  #    marker file (~/.qsbx-extra-kits) and only `kit add` the ones not recorded.
  #    Idempotent across re-invocations; adding a new entry to QSBX_EXTRA_KITS
  #    injects just that one on the next `qsbx run <existing-sandbox>`.
  local applied k
  applied=$(sbx exec "$name" -- sh -c 'cat "$HOME/.qsbx-extra-kits" 2>/dev/null' </dev/null 2>/dev/null || true)
  local _extras=()
  [ -n "$QSBX_EXTRA_KITS" ] && split_noglob _extras "$QSBX_EXTRA_KITS"
  for k in ${_extras[@]+"${_extras[@]}"}; do
    case "$applied" in
      *"$k"*) continue ;;   # already applied to this sandbox
    esac
    echo "qsbx: applying extra kit to '$name': $k" >&2
    if sbx kit add "$name" "$k" </dev/null >/dev/null 2>&1; then
      # Record it so we don't re-add on the next invocation. Append via the
      # agent user's home; the marker is advisory, failures are non-fatal.
      sbx exec "$name" -- sh -c 'printf "%s\n" "$0" >> "$HOME/.qsbx-extra-kits"' "$k" </dev/null >/dev/null 2>&1 || true
    else
      echo "qsbx: warning: 'sbx kit add' (extra kit) failed for '$name' (it is EXPERIMENTAL)." >&2
      echo "      Recover with: sbx kit add '$name' '$k'" >&2
    fi
  done
}

sandbox_exists() {
  # `sbx ls -q` prints bare sandbox names, one per line (no header). Match the
  # whole line as a fixed string so names containing regex metacharacters (e.g.
  # a dotted path slug) can't accidentally match a different sandbox.
  sbx ls -q 2>/dev/null | grep -Fxq -- "$1"
}

# True (0) iff an existing sandbox lacks the USAi provider config — i.e. it was
# created before the kit migration (no OPENCODE_CONFIG). Reuses kit_feature_absent
# so a transient exec blip (return 2) is treated as "not confirmed missing" (we
# do NOT tear down a sandbox on an unreliable probe).
sandbox_missing_usai() {
  local rc
  kit_feature_absent "$1" '[ -n "${OPENCODE_CONFIG:-}" ] && echo present'
  rc=$?
  [ "$rc" -eq 0 ]
}

# Print the manual recovery options for a USAi-less pre-kit sandbox, then exit
# non-zero (fail closed). Used both when the user declines migration and when any
# migration step fails. $1 = sandbox name.
halt_with_options() {
  local name="$1"
  cat >&2 <<EOF
qsbx: sandbox '$name' predates the kit migration and cannot be auto-healed.
      Upstream sbx bug docker/sbx-releases#133 makes 'sbx kit add' fail on the
      USAi provider kit (it ships a static file), and a sandbox without the USAi
      config is unusable. In-place healing is disabled until #133 is fixed.

      Your options:
        1. Re-create it (loses this sandbox's session/context):
             sbx rm --force '$name' && ./qsbx run opencode <project-path>
        2. Let qsbx migrate your sessions into a fresh, working sandbox with the
           same name — re-run and answer 'y' at the prompt. (Sessions are
           exported with --sanitize; the old sandbox is removed to reuse its
           name. Both are irreversible.)
        3. Downgrade to the last release before the kit migration (v0.11.0),
           which can still reattach to pre-kit sandboxes:
             git checkout v0.11.0

      See docs/KNOWN_FAILURE_MODES.md (section 19) for details.
EOF
  exit 1
}

# Assisted migration for a USAi-less pre-kit sandbox. sbx has no rename, so to
# give the working sandbox the ORIGINAL name we must remove the old one — which
# is destructive. We therefore export first, verify we captured something, and
# only then remove + recreate + import. If the user declines or any step fails,
# we halt with options and never remove a sandbox without a verified export.
#
# Flow: prompt -> export --sanitize each session to a host temp dir -> verify
# non-empty -> sbx rm --force old -> wait for name release -> create_with_config
# under the original name -> sbx cp + opencode import each -> return so the
# caller attaches. $1 = sandbox name; remaining args = the create args to reuse.
migrate_or_halt() {
  local name="$1"; shift
  local create_args=("$@")

  echo "qsbx: sandbox '$name' predates the kit migration (no USAi config) and" >&2
  echo "      cannot be auto-healed (upstream sbx#133). qsbx can migrate its" >&2
  echo "      sessions into a fresh, working sandbox of the same name." >&2
  echo "" >&2
  echo "      This EXPORTS your sessions with --sanitize (sensitive transcript and" >&2
  echo "      file data are redacted), then PERMANENTLY REMOVES the old sandbox to" >&2
  echo "      reuse its name, then recreates it with the kits and imports the" >&2
  echo "      sessions. Both the removal and the redaction are irreversible." >&2
  echo "" >&2
  printf "qsbx: migrate sessions and recreate '%s'? [y/N] " "$name" >&2
  local reply=""
  # Read the confirmation from the terminal by default so a prompt still works
  # when stdin is a pipe. Tests set QSBX_PROMPT_STDIN=1 to read from stdin
  # instead (no tty available in CI / a harness).
  if [ -n "${QSBX_PROMPT_STDIN:-}" ]; then
    read -r reply || true
  else
    read -r reply </dev/tty || true
  fi
  case "$reply" in
    y|Y|yes|YES) ;;
    *) echo "qsbx: migration declined." >&2; halt_with_options "$name" ;;
  esac

  # Export sessions to a private host temp dir. Session JSON is the user's data;
  # keep it under a 0700 dir in TMPDIR and always clean it up (trap), never log
  # its contents, never write it into the repo.
  local workdir
  workdir=$(mktemp -d "${TMPDIR:-/tmp}/qsbx-migrate.XXXXXX") || {
    echo "qsbx: could not create a temp dir for migration." >&2; halt_with_options "$name"; }
  chmod 700 "$workdir"
  # shellcheck disable=SC2064  # expand workdir now so the trap removes this exact dir
  trap "rm -rf '$workdir'" RETURN

  echo "qsbx: exporting sessions from '$name' (sanitized)..." >&2
  local ids id count=0
  ids=$(sbx exec "$name" -- sh -c 'opencode session list 2>/dev/null' </dev/null 2>/dev/null | extract_session_ids) || true
  for id in $ids; do
    if sbx exec "$name" -- sh -c "opencode export '$id' --sanitize" </dev/null >"$workdir/$id.json" 2>/dev/null \
        && [ -s "$workdir/$id.json" ]; then
      count=$((count + 1))
    else
      rm -f "$workdir/$id.json"
    fi
  done

  if [ "$count" -eq 0 ]; then
    echo "qsbx: no sessions could be exported from '$name'; not removing it." >&2
    halt_with_options "$name"
  fi
  echo "qsbx: exported $count session(s)." >&2

  # Destructive: remove the old sandbox so the name frees up, then wait until
  # sbx no longer lists it (create fails if the name is still taken).
  echo "qsbx: removing old sandbox '$name' to reuse its name..." >&2
  sbx rm --force "$name" </dev/null >/dev/null 2>&1 || {
    echo "qsbx: 'sbx rm' failed for '$name'; aborting migration." >&2; halt_with_options "$name"; }
  local tries=0
  while sandbox_exists "$name"; do
    tries=$((tries + 1))
    [ "$tries" -gt 30 ] && { echo "qsbx: '$name' still present after removal; aborting." >&2; exit 1; }
    sleep 1
  done

  echo "qsbx: creating fresh sandbox '$name' with the kits..." >&2
  create_with_config "$name" "${create_args[@]+"${create_args[@]}"}"

  echo "qsbx: importing $count session(s) into '$name'..." >&2
  local f base
  for f in "$workdir"/*.json; do
    [ -e "$f" ] || continue
    base=$(basename "$f")
    if sbx cp "$f" "$name:/tmp/$base" </dev/null >/dev/null 2>&1 \
        && sbx exec "$name" -- sh -c "opencode import '/tmp/$base'; rm -f '/tmp/$base'" </dev/null >/dev/null 2>&1; then
      :
    else
      echo "qsbx: warning: failed to import session '$base' into '$name'." >&2
    fi
  done
  echo "qsbx: migration complete. Attaching to '$name'." >&2
}

# Extract session IDs from `opencode session list` output on stdin. The command
# is human-oriented, so pull the first whitespace-delimited token that looks like
# a session id (ses_… or a hex/alnum id) off each non-empty line.
extract_session_ids() {
  awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^ses_[A-Za-z0-9]+$/) { print $i; break } }'
}

# Probe the USAi API from inside the sandbox using its injected USAI_API_KEY.
# Echoes the HTTP status code (e.g. 200, 401). A non-200 means the key is
# missing, invalid, or expired. Mirrors the validation in scripts/rotate-apikey,
# but targets the sandbox we are about to attach to.
check_key() {
  local name="$1"
  sbx exec "$name" -- sh -c \
    "curl -sS -o /dev/null -w '%{http_code}' \
     -H \"Authorization: Bearer \$USAI_API_KEY\" \
     $USAI_MODELS_URL" </dev/null 2>/dev/null || true
}

check_fresh_sandbox_key() {
  local validation_sbx="qsbx-keycheck-$$"
  local status=""

  if ! sbx create --name "$validation_sbx" shell . </dev/null >/dev/null 2>&1; then
    return 0
  fi

  # Guarantee cleanup even if the exec/curl below fails or the user interrupts
  # (Ctrl-C) before the explicit rm — otherwise the validation sandbox leaks
  # (qsbx-keycheck-PID accumulates). Mirrors scripts/rotate-apikey. The trap is
  # disarmed once the explicit rm has run.
  # shellcheck disable=SC2064
  trap "sbx rm --force '$validation_sbx' </dev/null >/dev/null 2>&1 || true" EXIT

  status=$(sbx exec "$validation_sbx" -- sh -c \
    "curl -sS -o /dev/null -w '%{http_code}' \
     -H \"Authorization: Bearer \$USAI_API_KEY\" \
     $USAI_MODELS_URL" </dev/null 2>/dev/null || true)
  sbx rm --force "$validation_sbx" </dev/null >/dev/null 2>&1 || true
  trap - EXIT
  printf '%s\n' "$status"
}

global_usai_placeholder() {
  sbx secret ls -g 2>/dev/null \
    | awk '$0 ~ /api[.]gsa[.]usai[.]gov/ { for (i = 1; i <= NF; i++) if ($i == "USAI_API_KEY") { print $(i+1); exit } }'
}

sandbox_usai_placeholder() {
  local name="$1"
  sbx exec "$name" -- sh -c 'printf "%s" "${USAI_API_KEY:-}"' </dev/null 2>/dev/null || true
}

offer_update_stale_placeholder() {
  local name="$1"
  local status="$2"
  local sandbox_placeholder=""
  local global_placeholder=""
  sandbox_placeholder=$(sandbox_usai_placeholder "$name")
  global_placeholder=$(global_usai_placeholder)

  echo >&2
  echo "The global USAi key works in a fresh sandbox, but '$name' still" >&2
  echo "fails with HTTP ${status:-unknown}. This usually means the existing" >&2
  echo "sandbox has a stale USAI_API_KEY placeholder from before rotation." >&2
  echo >&2
  if [ -z "$sandbox_placeholder" ]; then
    echo "Could not read the sandbox's USAI_API_KEY placeholder. Aborting attach." >&2
    return 1
  fi

  if [ -n "$global_placeholder" ] && [ "$sandbox_placeholder" = "$global_placeholder" ]; then
    echo "'$name' already uses the current global placeholder, so this is not" >&2
    echo "a stale-placeholder case. Aborting attach." >&2
    return 1
  fi

  echo "qsbx can repair this without deleting the sandbox by adding a" >&2
  echo "sandbox-scoped USAi custom secret that uses the placeholder already" >&2
  echo "injected into '$name'. You will be prompted for the current USAi key;" >&2
  echo "qsbx will not pass the key on the command line." >&2
  printf "Update sandbox-scoped USAi placeholder for '%s' now? [y/N] " "$name" >&2
  local repair_answer=""
  read -r repair_answer || true
  case "$repair_answer" in
    [yY]|[yY][eE][sS])
      sbx secret set-custom "$name" --host api.gsa.usai.gov \
        --env USAI_API_KEY --placeholder "$sandbox_placeholder"
      status=$(check_key "$name")
      if [ "$status" = "200" ]; then
        echo "Sandbox placeholder repaired and key validated. Continuing." >&2
        return 0
      fi
      echo "Sandbox placeholder updated, but key still not working (HTTP ${status:-unknown}). Aborting attach." >&2
      return 1
      ;;
  esac

  echo "Leaving existing sandbox unchanged. Aborting attach." >&2
  return 1
}

# Validate the sandbox's key and, if it is not working, walk the user through
# rotating it via scripts/rotate-apikey. Best-effort: if we cannot run the check
# (e.g. no curl in the sandbox), we warn and continue rather than block attach.
ensure_valid_key() {
  local name="$1"
  local status
  local fresh_status
  status=$(check_key "$name")

  if [ "$status" = "200" ]; then
    return 0
  fi

  if [ -z "$status" ]; then
    echo "warning: could not validate USAI_API_KEY for '$name' (skipping check)" >&2
    return 0
  fi

  fresh_status=$(check_fresh_sandbox_key)
  if [ "$fresh_status" = "200" ]; then
    offer_update_stale_placeholder "$name" "$status"
    return $?
  fi

  echo >&2
  echo "Your USAi API key looks invalid or expired (HTTP $status from the models API)." >&2
  echo "USAi keys expire every 7 days." >&2
  echo >&2
  echo "To rotate it:" >&2
  echo "  1. Open $KEY_MGMT_URL" >&2
  echo "  2. Choose 'Rotate' from the Actions menu for your key" >&2
  echo "  3. Copy the new key using the console copy button" >&2
  echo >&2

  if [ ! -x "$ROTATE_SCRIPT" ]; then
    echo "Cannot find scripts/rotate-apikey; rotate manually, then re-run." >&2
    return 1
  fi

  printf 'Have the new key ready to paste? Rotate now? [y/N] ' >&2
  local answer=""
  read -r answer || true
  case "$answer" in
    [yY]|[yY][eE][sS])
      "$ROTATE_SCRIPT"
      # Re-validate after rotation.
      status=$(check_key "$name")
      if [ "$status" = "200" ]; then
        echo "Key validated. Continuing." >&2
        return 0
      fi

      fresh_status=$(check_fresh_sandbox_key)
      if [ "$fresh_status" = "200" ]; then
        offer_update_stale_placeholder "$name" "$status"
        return $?
      fi

      echo "Key still not working (HTTP ${status:-unknown}). Aborting attach." >&2
      return 1
      ;;
    *)
      echo "Skipping rotation. Aborting attach; re-run when your key is rotated." >&2
      return 1
      ;;
  esac
}

# Allow tests to source this script for its functions without running the
# dispatch below: `QSBX_SOURCE_ONLY=1 . ./qsbx`. Normal invocation is unaffected.
if [ -n "${QSBX_SOURCE_ONLY:-}" ]; then
  return 0 2>/dev/null || exit 0
fi

subcommand="${1:-}"

case "$subcommand" in
  usai-rotate-api-key)
    # Front the standalone rotation helper as a subcommand so qsbx is the single
    # entry point for this repo's sbx extensions. The script stays runnable on
    # its own. Forward any extra args through to it.
    shift
    if [ ! -x "$ROTATE_SCRIPT" ]; then
      echo "qsbx: scripts/rotate-apikey not found or not executable" >&2
      exit 1
    fi
    exec "$ROTATE_SCRIPT" "$@"
    ;;

  create)
    shift
    require_sbx_version
    name=$(derive_name "$@") || exit 1
    [ -n "$name" ] || { echo "qsbx: could not determine sandbox name" >&2; exit 1; }
    create_with_config "$name" "$@"
    ;;

  run)
    shift
    require_sbx_version
    # Split args into the create portion (agent + paths + flags) and any agent
    # args after "--", which only apply on attach.
    create_args=()
    agent_args=()
    seen_sep=0
    for arg in "$@"; do
      if [ "$seen_sep" -eq 1 ]; then
        agent_args+=("$arg")
      elif [ "$arg" = "--" ]; then
        seen_sep=1
      else
        create_args+=("$arg")
      fi
    done

    first=""
    [ "${#create_args[@]}" -gt 0 ] && first=$(first_positional "${create_args[@]}")

    if [ -n "$first" ] && is_known_agent "$first"; then
      # AGENT form: create the sandbox if it does not exist, then attach to it.
      name=$(derive_name "${create_args[@]}") || exit 1
      [ -n "$name" ] || { echo "qsbx: could not determine sandbox name" >&2; exit 1; }
      if sandbox_exists "$name"; then
        # Existing sandbox. If it predates the kit migration (no USAi config),
        # in-place healing is blocked by upstream sbx#133 — offer to migrate its
        # sessions into a fresh, working sandbox of the same name, or halt with
        # options. Otherwise heal it in place (a no-op while auto-heal is gated).
        if sandbox_missing_usai "$name"; then
          migrate_or_halt "$name" "${create_args[@]}"
        else
          ensure_kit_applied "$name"
        fi
      else
        create_with_config "$name" "${create_args[@]}"
      fi

      # Verify the sandbox's USAi key works before attaching; prompt to rotate
      # if it does not.
      ensure_valid_key "$name"

      # Attach by name. `sbx run --name <name>` re-attaches independent of the
      # working directory; the agent positional is omitted on attach (sbx infers
      # it from the named sandbox and errors if a mismatching agent is passed).
      if [ "${#agent_args[@]}" -gt 0 ]; then
        sbx run --name "$name" -- "${agent_args[@]}"
      else
        sbx run --name "$name"
      fi
    else
      # No agent positional. If the first arg names an existing sandbox, attach
      # to it by name (the positional-sandbox form is deprecated in sbx); else
      # pass through unchanged (e.g. flags-only, or `sbx run` with no args).
      if [ -n "$first" ] && sandbox_exists "$first"; then
        # Existing sandbox attached by name. If it predates the kit migration,
        # in-place healing is blocked by upstream sbx#133. We can't recreate it
        # here (no agent positional was given, so we lack the create args), so we
        # halt with options rather than attach to a USAi-less, unusable sandbox.
        if sandbox_missing_usai "$first"; then
          halt_with_options "$first"
        fi
        ensure_kit_applied "$first"
        # Rebuild the arg list with the matched sandbox token removed (drop only
        # the first occurrence), so flags that appear before the name are
        # preserved and the name isn't duplicated. Positional `${@:2}` would be
        # wrong whenever the name isn't $1 (e.g. `qsbx run -t tpl mysandbox`).
        rest=(); dropped=0
        for arg in "$@"; do
          if [ "$dropped" -eq 0 ] && [ "$arg" = "$first" ]; then dropped=1; continue; fi
          rest+=("$arg")
        done
        # ${arr[@]+...} keeps this bash-3.2-safe under set -u when rest is empty.
        sbx run --name "$first" ${rest[@]+"${rest[@]}"}
      else
        sbx run "$@"
      fi
    fi
    ;;

  *)
    # --- Any other subcommand: pass through unmolested ---
    sbx "$@"
    ;;
esac
