#!/bin/bash
#
# qsbx — sbx wrapper that applies the quickstart's sbx mixin kits to sandboxes
#
# Problem: each new sbx sandbox is fresh, with no access to your persistent
# global config (agent settings, AGENTS.md, skills, etc.). Without this, you end
# up copying those files into every sandbox and manually keeping them in sync.
#
# Solution: when qsbx creates a sandbox it applies FOUR sbx mixin kits from the
# community agentic-coding-patterns repo, by remote reference pinned to a commit
# (see PATTERNS_KIT_REF below), so every sandbox is configured declaratively:
#   1. usai-provider     — configures the USAi OpenCode provider (stages
#      ~/usai-config/opencode.jsonc and merges it into OpenCode's global config
#      at ~/.config/opencode/opencode.jsonc at startup; allow-lists USAi
#      egress).
#   2. agentic-coding-playbook — at container startup, clones the playbook at a
#      pinned ref and symlinks its AGENTS.md + skills into each agent's search
#      paths.
#   3. zscaler-ca-certificate  — installs the public Zscaler Root CA into the
#      sandbox trust store, so HTTPS works on Zscaler-inspecting hosts (harmless
#      no-op elsewhere).
#   4. git-ssh-sign      — configures git to sign commits/tags with the SSH key
#      forwarded from the host's SSH agent (private key never leaves the host).
#      Fails closed if no key is loaded; qsbx warns before attaching.
# The kits live in GSA-TTS/agentic-coding-patterns under
# integrations/isolation/sbx-kits/. qsbx no longer carries copies of them; this
# repo just wires them together into one comprehensible path to a working
# sandbox. Set QSBX_EXTRA_KITS to apply additional kits on every invocation
# without repeating --kit flags. Before attaching with `qsbx run`, it also
# checks that the sandbox's USAi key works and, if not, offers to rotate it. All
# other subcommands pass straight through to sbx.
#
# Remote kits require the source prefix to be on sbx's kit.allowedSources
# allowlist (a v0.34+ safety gate). qsbx adds it automatically at the start of any
# create/run — no manual `sbx settings` step. See ensure_kit_sources_allowed().
#
# qsbx is also the single entry point for this repo's sbx extensions:
#   qsbx usai-rotate-api-key   # rotate the USAi key secret (scripts/rotate-apikey)

set -euo pipefail

# Resolve the absolute directory containing this script, following symlinks so
# qsbx works when invoked via a symlink on PATH. Portable across macOS (whose
# BSD `readlink` lacks `-f`) and Linux: walk the symlink chain manually.
script_dir() {
  local src="${BASH_SOURCE[0]}" dir
  while [ -h "$src" ]; do
    dir=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)
    src=$(readlink "$src")
    # Resolve relative symlink targets against the link's directory.
    case "$src" in
      /*) ;;
      *) src="$dir/$src" ;;
    esac
  done
  cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd
}

# Absolute directory of this script, used both as the default clone location and
# to locate sibling scripts (scripts/rotate-apikey).
SCRIPT_DIR=$(script_dir) || { echo "qsbx: could not resolve script directory" >&2; exit 1; }

# The quickstart clone defaults to this script's directory; QUICKSTART_CLONE
# overrides it if exported. Used only to locate sibling helper scripts and to
# support editing this repo as a project — the kits themselves are remote (below).
# Record whether the user overrode it, so `version` can surface that (an override
# is another way "which clone am I really using?" gets confusing).
if [ -n "${QUICKSTART_CLONE:-}" ]; then QUICKSTART_CLONE_OVERRIDDEN=1; else QUICKSTART_CLONE_OVERRIDDEN=""; fi
QUICKSTART_CLONE="${QUICKSTART_CLONE:-$SCRIPT_DIR}"

# The absolute path of the qsbx file actually being executed, with symlinks
# resolved. This is the single most useful fact when a user reports "I pulled
# the branch but the old behavior persists": a `qsbx`/`qsb` on PATH is very
# often a symlink into a DIFFERENT clone than the one they edited/pulled, so
# they run stale code. `version` prints this and the startup hint compares it
# against the invoking repo. SCRIPT_DIR already followed the symlink chain, so
# the resolved file is SCRIPT_DIR + this script's basename.
QSBX_RESOLVED_PATH="$SCRIPT_DIR/$(basename "${BASH_SOURCE[0]}")"

# Print the version/identity of the qsbx that is actually running: the resolved
# script path, the clone's git branch + short SHA + dirty flag (if the clone is
# a git repo), and the pinned patterns-kit ref. This exists so "which qsbx am I
# running?" is answerable in one command — the failure the wrong-clone class of
# bug reports keeps hitting. Best-effort: git details are omitted (not faked) if
# git is absent or SCRIPT_DIR is not a work tree.
print_version() {
  echo "qsbx"
  echo "  script:      $QSBX_RESOLVED_PATH"
  echo "  clone dir:   $SCRIPT_DIR"
  if command -v git >/dev/null 2>&1 \
      && git -C "$SCRIPT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    local branch sha dirty=""
    branch=$(git -C "$SCRIPT_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "?")
    sha=$(git -C "$SCRIPT_DIR" rev-parse --short HEAD 2>/dev/null || echo "?")
    # Mark the tree dirty only if THIS clone has uncommitted changes.
    git -C "$SCRIPT_DIR" diff --quiet 2>/dev/null && git -C "$SCRIPT_DIR" diff --cached --quiet 2>/dev/null || dirty=" (dirty)"
    echo "  git:         ${branch}@${sha}${dirty}"
  else
    echo "  git:         (not a git clone — cannot report branch/commit)"
  fi
  echo "  patterns kit ref: $PATTERNS_KIT_REF"
  echo "  min sbx:     $MIN_SBX_VERSION"
  [ -n "${QUICKSTART_CLONE_OVERRIDDEN:-}" ] \
    && echo "  note: QUICKSTART_CLONE is set in your environment ($QUICKSTART_CLONE)."
}

# Startup hint for the wrong-clone / didn't-switch failure mode. When the user
# runs qsbx from inside a git clone of THIS repo (cwd is a work tree) but the
# qsbx that actually executed lives in a DIFFERENT clone, they are almost
# certainly editing/pulling one clone and running another. Warn (never block),
# and only when we can be confident: both the cwd and the resolved script's
# clone are git work trees AND their toplevels differ. Silent otherwise.
warn_if_running_foreign_clone() {
  command -v git >/dev/null 2>&1 || return 0
  local cwd_top script_top
  cwd_top=$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null) || return 0
  script_top=$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null) || return 0
  [ -n "$cwd_top" ] && [ -n "$script_top" ] || return 0
  [ "$cwd_top" = "$script_top" ] && return 0
  # Only nag when the cwd clone looks like a quickstart checkout (has a qsbx),
  # so we don't warn for every unrelated project the user runs qsbx against.
  [ -f "$cwd_top/qsbx" ] || return 0
  echo "qsbx: note — you are inside a quickstart clone at:" >&2
  echo "        $cwd_top" >&2
  echo "      but the qsbx actually running lives in a DIFFERENT clone:" >&2
  echo "        $QSBX_RESOLVED_PATH" >&2
  echo "      If you pulled/switched branches in the first but see stale" >&2
  echo "      behavior, you are running the other clone. Run 'qsbx version'" >&2
  echo "      to confirm, and either re-point your qsbx symlink or run" >&2
  echo "      ./qsbx from the clone you updated." >&2
}

# ============================================================================
# KITS — the four sbx mixin kits applied to every sandbox, sourced from the
# community agentic-coding-patterns repo. To adopt newer kits, bump the pinned
# commit below (sbx requires remote kit refs to be a full 40-char commit SHA).
# ============================================================================
PATTERNS_KIT_REPO="git+https://github.com/GSA-TTS/agentic-coding-patterns.git"
PATTERNS_KIT_REF="d2a379ff7cdff611d6d623a1ce7b21e543f76ea8"  # -patterns v1.5.0 release
PATTERNS_KIT_DIR="integrations/isolation/sbx-kits"

# Remote kit references (repo#ref=<sha>&dir=<subpath>). Applied in order via
# repeated --kit; mixins compose. Order: provider, playbook, CA, then signing.
USAI_KIT="${PATTERNS_KIT_REPO}#ref=${PATTERNS_KIT_REF}&dir=${PATTERNS_KIT_DIR}/usai-provider-kit"
PLAYBOOK_KIT="${PATTERNS_KIT_REPO}#ref=${PATTERNS_KIT_REF}&dir=${PATTERNS_KIT_DIR}/playbook-kit"
ZSCALER_KIT="${PATTERNS_KIT_REPO}#ref=${PATTERNS_KIT_REF}&dir=${PATTERNS_KIT_DIR}/zscaler-ca-certificate"
# git-ssh-sign: configures git in the sandbox to sign commits/tags with the SSH
# key forwarded from the host agent (private key never leaves the host). If no
# key is loaded on the host, git signing fails closed with a clear error; qsbx
# warns before attaching (see warn_if_no_ssh_signing_key). See ADR-0006.
# Signing alone does not make a commit GitHub-"Verified": that also needs a
# GitHub-verified user.email and a registered signing key. qsbx surfaces a
# missing identity up front (warn_if_no_git_identity). See ADR-0007 and
# patterns#211 for the end-to-end verification gap.
GITSSHSIGN_KIT="${PATTERNS_KIT_REPO}#ref=${PATTERNS_KIT_REF}&dir=${PATTERNS_KIT_DIR}/git-ssh-sign"

# Additional user-supplied kits. Set QSBX_EXTRA_KITS to a whitespace-separated
# list of kit references (local paths or remote refs) to apply on every sandbox,
# so you don't have to pass a long series of --kit flags each invocation. E.g.:
#   export QSBX_EXTRA_KITS="./my-kit git+https://github.com/acme/kits.git#ref=<sha>&dir=foo"
# These are appended AFTER the built-in kits (later kits win on conflicting
# env vars / overlay files, per sbx composition). Remote extras from a new host
# still need their prefix on kit.allowedSources — see QSBX_EXTRA_KIT_SOURCES.
QSBX_EXTRA_KITS="${QSBX_EXTRA_KITS:-}"

# Word-split a whitespace-separated env value into the named array WITHOUT
# filename globbing (a literal `*` in a kit ref must not expand against the cwd).
# Usage: split_noglob ARRAYNAME "$VALUE"
split_noglob() {
  local _name="$1" _val="$2" _oldopts
  _oldopts=$(set +o); set -f
  # shellcheck disable=SC2086
  set -- $_val
  eval "$_oldopts"
  eval "$_name=(\"\$@\")"
}

# Assemble the full ordered kit list once: the built-ins, then extras. Order
# matters for sbx composition (later kits win on conflicting env/overlay); the
# signing kit is independent of the others.
KITS=("$USAI_KIT" "$PLAYBOOK_KIT" "$ZSCALER_KIT" "$GITSSHSIGN_KIT")
if [ -n "$QSBX_EXTRA_KITS" ]; then
  split_noglob _extra_kits "$QSBX_EXTRA_KITS"
  # shellcheck disable=SC2154  # assigned indirectly by split_noglob via eval
  KITS+=("${_extra_kits[@]}")
fi

# Emit the --kit flags for the full kit list on stdout (one token per line) so
# callers can collect them into an array. Keeps the three create sites in sync.
kit_flags() {
  local k
  for k in "${KITS[@]}"; do
    printf '%s\n%s\n' "--kit" "$k"
  done
}

# The kit.allowedSources prefixes qsbx must ensure are allowlisted so the remote
# refs above resolve. Entries match as PATH-SEGMENT prefixes WITHOUT the scheme
# (per sbx docs), so this covers github.com/GSA-TTS/agentic-coding-patterns.
# Users applying remote extras from other hosts can add prefixes here via
# QSBX_EXTRA_KIT_SOURCES (whitespace-separated), e.g. "github.com/acme/".
KIT_SOURCE_PREFIX="github.com/GSA-TTS/"
QSBX_EXTRA_KIT_SOURCES="${QSBX_EXTRA_KIT_SOURCES:-}"
KIT_SOURCE_PREFIXES=("$KIT_SOURCE_PREFIX")
if [ -n "$QSBX_EXTRA_KIT_SOURCES" ]; then
  split_noglob _extra_sources "$QSBX_EXTRA_KIT_SOURCES"
  # shellcheck disable=SC2154  # assigned indirectly by split_noglob via eval
  KIT_SOURCE_PREFIXES+=("${_extra_sources[@]}")
fi

# In-place healing of sandboxes created before qsbx applied a given kit (e.g.
# created with an older qsbx, or a plain `sbx run` without the --kit refs) is
# done by `sbx kit add`. As of sbx 0.35.0 `sbx kit add` RECREATES the sandbox
# container with the augmented kit set and PRESERVES state (docker/sbx-releases
# fixed the earlier #133 defect, where `sbx kit add` failed with "failed to read
# tar header: unexpected EOF" on any kit shipping a static files/ payload — which
# the usai-provider kit does). Because qsbx now requires sbx >= 0.35.0
# (require_sbx_version), healing runs unconditionally; there is no longer a
# feature flag gating it. See ensure_kit_applied and ADR-0009.

USAI_MODELS_URL="https://api.gsa.usai.gov/api/v1/models"
KEY_MGMT_URL="https://console.gsa.usai.gov/key-management"

# Minimum sbx version qsbx requires. Remote SHA-pinned kit refs + the v2 kit
# schema + `sbx policy init` landed in 0.34.0; sbx 0.35.0 makes `sbx kit add`
# recreate the sandbox container preserving state (fixing #133), which qsbx
# relies on to heal pre-kit sandboxes in place (see ensure_kit_applied). NOTE:
# sbx 0.35.x ships NO Linux/ARM64 build (deferred to 0.36.x per the release
# notes); require_sbx_version detects that arch and gives targeted guidance.
MIN_SBX_VERSION="0.35.0"

# Max seconds to wait for `sbx exec` to become usable in a sandbox. Right after
# `sbx create` (or the first touch of a stopped sandbox), sbx exec fails with
# "inspect exec: context deadline exceeded" until the container is ready. We poll
# until a trivial exec succeeds before making the migrate/heal decision or
# running the migration's export/import, so a cold-start delay is never mistaken
# for "feature absent". Override with QSBX_EXEC_READY_TIMEOUT (seconds).
QSBX_EXEC_READY_TIMEOUT="${QSBX_EXEC_READY_TIMEOUT:-60}"

# Standalone helper scripts that qsbx fronts as subcommands. They remain runnable
# on their own; qsbx is just the single entry point for this repo's sbx extras.
ROTATE_SCRIPT="$SCRIPT_DIR/scripts/rotate-apikey"

# Agents understood by `sbx run AGENT [PATH...]`. Used to tell whether the first
# positional after `run` is an agent (create-if-missing form) or the name of an
# existing sandbox. qsbx always identifies sandboxes with `--name` (sbx's
# preferred form); a bare sandbox positional is still accepted and rewritten to
# `--name <sandbox>` since the positional-sandbox form is deprecated in sbx.
# Note: a sandbox literally named after an agent (e.g. `shell`) is treated as the
# agent form; attach such sandboxes with `sbx run --name <sandbox>` directly.
KNOWN_AGENTS=" claude codex copilot cursor docker-agent droid gemini kiro opencode shell "

# Ensure the kit source prefixes qsbx needs are on sbx's kit.allowedSources
# allowlist, so the remote --kit refs resolve. sbx (v0.34+) restricts kit installs
# to an allowlist of source prefixes (default: ["docker.io/"]); a Git URL fails
# until its host/path prefix is added. Rather than make this a documented manual
# setup step, qsbx ensures the prefixes are present at the top of any create/run.
#
# Important semantics (per sbx docs):
#   - The value is a JSON array; `settings set` REPLACES the whole list, so we
#     read the current list and add only missing prefixes, preserving existing
#     entries (notably the default "docker.io/").
#   - Entries are scheme-less, matched as prefixes on a path-segment boundary
#     (e.g. "github.com/GSA-TTS/"), NOT "git+https://..." URLs.
#
# FAIL SAFE: this rewrites a GLOBAL sbx policy list, so we never write a guess.
# We only add prefixes when we can read the current value AND parse it as a JSON
# array (via jq). If jq is missing, the read fails, or the value isn't an array
# (e.g. a transient/flaky read), we warn and print the manual command but DO NOT
# write — so a blip can't silently narrow or corrupt an operator's allowlist.
# Prefixes are added with `jq --arg` (never string-concatenated), so a stray
# quote in QSBX_EXTRA_KIT_SOURCES can't inject an array element.
ensure_kit_sources_allowed() {
  local current desired

  if ! command -v jq >/dev/null 2>&1; then
    _kit_sources_manual_hint "jq not found; cannot safely update the allowlist"
    return 0
  fi

  current=$(sbx settings get kit.allowedSources 2>/dev/null || true)

  # Validate: must be a JSON array. Anything else (empty, error text, object) is
  # treated as unreadable — warn, don't write.
  if ! printf '%s' "$current" | jq -e 'type == "array"' >/dev/null 2>&1; then
    _kit_sources_manual_hint "could not read kit.allowedSources as a JSON array"
    return 0
  fi

  # Compute the new array = current followed by any required prefixes not already
  # present (order preserved, deduped). Prefixes come in as jq args, so a stray
  # quote can't inject an element.
  desired=$(printf '%s' "$current" | jq -c --args \
    'reduce $ARGS.positional[] as $p (.; if index($p) then . else . + [$p] end)' \
    "${KIT_SOURCE_PREFIXES[@]}" 2>/dev/null)
  if [ -z "$desired" ]; then
    _kit_sources_manual_hint "failed to compute updated allowlist"
    return 0
  fi

  # No change needed? (current already contained every required prefix)
  if [ "$(printf '%s' "$current" | jq -cS .)" = "$(printf '%s' "$desired" | jq -cS .)" ]; then
    return 0
  fi

  if sbx settings set kit.allowedSources "$desired" </dev/null >/dev/null 2>&1; then
    echo "qsbx: updated sbx kit.allowedSources to: $(printf '%s' "$desired" | jq -r '.[]' | tr '\n' ' ')" >&2
  else
    _kit_sources_manual_hint "could not write kit.allowedSources"
  fi
}

# Print a warning + the exact manual command to allow the required prefixes,
# using jq to build a well-formed array from whatever is currently set (falling
# back to the documented default). Never writes anything.
_kit_sources_manual_hint() {
  local reason="$1" cmd cur
  echo "qsbx: warning: $reason." >&2
  if command -v jq >/dev/null 2>&1; then
    cur=$(sbx settings get kit.allowedSources 2>/dev/null || true)
    printf '%s' "$cur" | jq -e 'type == "array"' >/dev/null 2>&1 || cur='["docker.io/"]'
    cmd=$(printf '%s' "$cur" | jq -c --args \
      'reduce $ARGS.positional[] as $p (.; if index($p) then . else . + [$p] end)' \
      "${KIT_SOURCE_PREFIXES[@]}" 2>/dev/null)
  fi
  [ -z "${cmd:-}" ] && cmd='["docker.io/","github.com/GSA-TTS/"]'
  echo "      If kit resolution fails, review the current value and run (the" >&2
  echo "      setting REPLACES the whole list — keep the entries you want):" >&2
  echo "        sbx settings set kit.allowedSources '${cmd}'" >&2
}

# Compare two dotted version strings. Echoes 0 if A >= B, 1 otherwise. Pads
# missing components with 0 and compares numerically per component, so e.g.
# 0.35 >= 0.35.0 and 0.35.1 >= 0.35.0. Non-numeric suffixes on a component
# (e.g. a "-rc1") are stripped to their leading digits before comparison.
version_ge() {
  local a="$1" b="$2" i a_part b_part
  local -a a_arr b_arr
  IFS='.' read -r -a a_arr <<EOF
$a
EOF
  IFS='.' read -r -a b_arr <<EOF
$b
EOF
  for i in 0 1 2; do
    a_part=${a_arr[i]:-0}; b_part=${b_arr[i]:-0}
    a_part=${a_part%%[!0-9]*}; b_part=${b_part%%[!0-9]*}
    a_part=${a_part:-0}; b_part=${b_part:-0}
    if [ "$a_part" -gt "$b_part" ]; then echo 0; return; fi
    if [ "$a_part" -lt "$b_part" ]; then echo 1; return; fi
  done
  echo 0
}

# Require sbx >= MIN_SBX_VERSION. qsbx depends on v2-schema kit support and
# `sbx policy init` (0.34.0) and on `sbx kit add` recreating the sandbox
# container while preserving state (0.35.0), which is how pre-kit sandboxes heal
# in place. If sbx is missing or its version can't be parsed, warn but don't
# block (don't fail closed on a version we simply couldn't read).
#
# ARM64 CAVEAT: sbx 0.35.x publishes NO Linux/ARM64 build (deferred to 0.36.x per
# the release notes), so a Linux/ARM64 host literally cannot install a version
# that satisfies this floor yet. When we detect that arch AND an older sbx, we
# give targeted guidance instead of a generic "upgrade" message.
require_sbx_version() {
  if ! command -v sbx >/dev/null 2>&1; then
    echo "error: sbx CLI not found on PATH. Install sbx >= $MIN_SBX_VERSION." >&2
    echo "       See README.md (Step 2: Install sbx CLI)." >&2
    exit 1
  fi

  local raw current
  # `sbx version` prints e.g. "sbx version: v0.35.0 <sha>". Extract the first
  # dotted-numeric token, tolerating a leading "v".
  raw=$(sbx version 2>/dev/null || true)
  current=$(printf '%s\n' "$raw" | grep -oE 'v?[0-9]+\.[0-9]+(\.[0-9]+)?' | head -n1 | sed 's/^v//')

  if [ -z "$current" ]; then
    echo "qsbx: warning: could not determine sbx version (need >= $MIN_SBX_VERSION); continuing." >&2
    return 0
  fi

  if [ "$(version_ge "$current" "$MIN_SBX_VERSION")" -ne 0 ]; then
    # Linux/ARM64 hosts can't get a 0.35.x build yet — give them a specific path
    # rather than an "upgrade" message they can't act on.
    local os arch
    os=$(uname -s 2>/dev/null || echo unknown)
    arch=$(uname -m 2>/dev/null || echo unknown)
    if [ "$os" = "Linux" ] && { [ "$arch" = "aarch64" ] || [ "$arch" = "arm64" ]; }; then
      echo "error: qsbx requires sbx >= $MIN_SBX_VERSION, but found $current, and" >&2
      echo "       sbx $MIN_SBX_VERSION.x publishes NO Linux/ARM64 build (deferred to" >&2
      echo "       0.36.x per the sbx release notes). On Linux/ARM64 you cannot yet" >&2
      echo "       install a version that satisfies this floor. Options:" >&2
      echo "         - run qsbx on an x86_64 host (sbx has a 0.35.x build there), or" >&2
      echo "         - wait for the sbx 0.36.x release, which restores ARM64 builds." >&2
      echo "       See README.md (Step 2) for the ARM64 note." >&2
      exit 1
    fi
    echo "error: qsbx requires sbx >= $MIN_SBX_VERSION, but found $current." >&2
    echo "       qsbx heals pre-kit sandboxes with 'sbx kit add', which recreates" >&2
    echo "       the sandbox preserving state as of sbx 0.35.0." >&2
    echo "       Upgrade sbx (see README.md, Step 2) and retry." >&2
    exit 1
  fi
}

# Canonicalize a directory path to an absolute, symlink-resolved form so we can
# compare a user-supplied workspace path against the clone dir. Echoes nothing
# if the path does not exist / is not a directory.
canonical_dir() {
  [ -d "$1" ] || return 0
  ( cd -P "$1" >/dev/null 2>&1 && pwd )
}

# True if PATH (a create/run positional) refers to the quickstart clone itself.
is_clone_path() {
  local resolved
  resolved=$(canonical_dir "$1")
  [ -n "$resolved" ] && [ "$resolved" = "$QUICKSTART_CLONE" ]
}

is_known_agent() {
  case "$KNOWN_AGENTS" in
    *" $1 "*) return 0 ;;
    *) return 1 ;;
  esac
}

# True if PREV is a flag that consumes the next argument as its value.
takes_value() {
  case "$1" in
    --name|--template|-t|--profile|--cpus|--memory|-m|--kit) return 0 ;;
    *) return 1 ;;
  esac
}

# Find the first non-flag positional in a create/run arg list, skipping flags
# and their values (e.g. `--name custom`). Echoes the token, or nothing.
first_positional() {
  local prev=""
  for arg in "$@"; do
    if takes_value "$prev"; then
      prev="$arg"
      continue
    fi
    case "$arg" in
      -*) prev="$arg"; continue ;;
    esac
    printf '%s\n' "$arg"
    return 0
  done
}

# Find the workspace path in an AGENT-form create/run arg list: the SECOND
# non-flag positional (the first is the agent). Echoes the path with any `:ro`
# mount-mode suffix stripped, or nothing if none was given (agent-only form,
# where the workspace defaults to the current directory — see caller). Mirrors
# the positional-scan in derive_name so the two agree on which token is the path.
workspace_path() {
  local agent="" prev=""
  for arg in "$@"; do
    if takes_value "$prev"; then prev="$arg"; continue; fi
    case "$arg" in
      -*) prev="$arg"; continue ;;
    esac
    if [ -z "$agent" ]; then
      agent="$arg"
    else
      printf '%s\n' "${arg%%:*}"   # strip any :ro suffix
      return 0
    fi
    prev="$arg"
  done
}

# Normalize a string into sbx's sandbox-name slug rules: lowercase, every run
# of non-alphanumerics collapsed to a single hyphen, leading/trailing hyphens
# trimmed. (Verified against sbx 0.32.0: My_App -> my-app, "with space" ->
# with-space, under_score_x -> under-score-x.)
slugify() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -e 's/[^a-z0-9]\{1,\}/-/g' -e 's/^-*//' -e 's/-*$//'
}

# Derive the sandbox name qsbx will own and pass to BOTH `sbx create --name` and
# the existence check, so the two always agree (rather than reconstructing and
# guessing at sbx's auto-generated slug). Honors an explicit `--name NAME`;
# otherwise builds "<agent>-<slug-of-basename>" using sbx's normalization rules.
derive_name() {
  local agent="" first_path="" prev=""
  for arg in "$@"; do
    if [ "$prev" = "--name" ]; then
      printf '%s\n' "$arg"
      return 0
    fi
    case "$arg" in
      --name=*)
        printf '%s\n' "${arg#--name=}"
        return 0
        ;;
    esac
    prev="$arg"
  done

  # No explicit --name: agent is the first non-flag token, path the next one.
  prev=""
  for arg in "$@"; do
    if takes_value "$prev"; then prev="$arg"; continue; fi
    case "$arg" in
      -*) prev="$arg"; continue ;;
    esac
    if [ -z "$agent" ]; then
      agent="$arg"
    elif [ -z "$first_path" ]; then
      first_path="${arg%%:*}"   # strip any :ro suffix
      break
    fi
    prev="$arg"
  done

  if [ -z "$agent" ]; then
    echo "error: could not determine agent for sandbox name" >&2
    return 1
  fi

  local base="."
  [ -n "$first_path" ] && base=$(basename "$first_path")
  [ "$base" = "." ] && base=$(basename "$PWD")
  printf '%s\n' "$(slugify "$agent")-$(slugify "$base")"
}

# Echo an explicit `--name NAME` / `--name=NAME` from an arg list, or nothing.
name_flag() {
  local prev=""
  for arg in "$@"; do
    if [ "$prev" = "--name" ]; then
      printf '%s\n' "$arg"
      return 0
    fi
    case "$arg" in
      --name=*) printf '%s\n' "${arg#--name=}"; return 0 ;;
    esac
    prev="$arg"
  done
}

# Drop any user-supplied `--name NAME` / `--name=NAME` from an arg list. qsbx
# always passes an explicit, derived name to `sbx create`, so the original must
# be removed to avoid a duplicate flag. Result is placed in the STRIPPED_ARGS
# global array (bash can't return arrays directly).
strip_name() {
  STRIPPED_ARGS=()
  local skip=0
  for arg in "$@"; do
    if [ "$skip" -eq 1 ]; then
      skip=0
      continue
    fi
    case "$arg" in
      --name) skip=1; continue ;;
      --name=*) continue ;;
    esac
    STRIPPED_ARGS+=("$arg")
  done
}

# Create a detached sandbox with both kits applied via --kit: the clone itself
# (usai-provider-kit: USAi provider config + egress) and the playbook kit
# (agentic-coding-playbook: clones the playbook at startup and links its
# AGENTS.md + skills into each agent's search paths). No read-only mount and no
# home-dir symlinking are needed any more — the kits do everything declaratively.
# Usage: create_with_config NAME CREATE_ARGS...
create_with_config() {
  ensure_kit_sources_allowed
  local name="$1"
  shift

  strip_name "$@"
  # Collect the --kit flags for all configured kits (built-ins + QSBX_EXTRA_KITS).
  local kf=(); while IFS= read -r line; do kf+=("$line"); done < <(kit_flags)
  # Guard the array expansion for bash 3.2 (macOS default): under `set -u` an
  # empty array expansion is an "unbound variable" error there. Return sbx's exit
  # status so callers can fail closed instead of proceeding on a broken sandbox.
  if [ "${#STRIPPED_ARGS[@]}" -gt 0 ]; then
    sbx create --name "$name" "${kf[@]}" "${STRIPPED_ARGS[@]}"
  else
    sbx create --name "$name" "${kf[@]}"
  fi
}

# Heal a sandbox created before qsbx applied these kits. Such sandboxes may lack
# the USAi provider config (no staged usai-config), the playbook clone, and/or
# the Zscaler CA. We detect each and inject the missing kit into the running
# sandbox with `sbx kit add` — no recreation needed. Best-effort: if the
# (experimental) command fails, warn with the manual recovery step and continue
# to attach.
#
# Wait until `sbx exec` works in a sandbox, or the readiness timeout elapses.
# Returns 0 once a trivial exec succeeds, 1 if it never does within the budget.
# This exists because sbx exec fails ("inspect exec: context deadline exceeded")
# for a while after a sandbox is created or first touched; callers must wait for
# readiness before probing for features or running commands, otherwise a
# cold-start delay is misread as "the command/feature failed/absent".
wait_for_exec_ready() {
  local name="$1" deadline out
  deadline=$(( $(date +%s) + QSBX_EXEC_READY_TIMEOUT ))
  while :; do
    # Capture rather than pipe to grep: under `set -o pipefail`, grep -q closing
    # the pipe early makes sbx see SIGPIPE and the pipeline reports failure even
    # though exec succeeded (notably on macOS). Strip CR so a CRLF 'ok\r' still
    # matches. A substring test tolerates any extra sbx chatter around it.
    out=$(sbx exec "$name" -- sh -c 'echo ok' </dev/null 2>/dev/null | tr -d '\r')
    case "$out" in
      *ok*) return 0 ;;
    esac
    [ "$(date +%s)" -ge "$deadline" ] && return 1
    sleep 2
  done
}

# Probe discipline: we distinguish "the probe ran and the feature is absent"
# (heal/migrate) from "the probe itself failed to run" (do NOT act on an
# unreliable probe). Callers MUST have waited for exec readiness first
# (wait_for_exec_ready); given that, a failing exec here is a genuine failure,
# not a cold-start blip, but we still retry a couple of times for robustness.
#
# CONTRACT: the snippet MUST decide presence purely by what it PRINTS, and MUST
# exit 0 either way. We cannot use the exec exit status to mean "feature absent"
# because a snippet like `test -f X && echo present` exits 1 when X is absent —
# indistinguishable from a genuine exec failure. So kit_feature_absent classifies
# on stdout: it wraps the snippet to always exit 0 and prints "present" (feature
# there) or "absent" (feature not there); an empty/garbled result means the probe
# didn't run cleanly. Returns:
#   0 = ran, feature absent   1 = ran, feature present   2 = probe failed to run
kit_feature_absent() {
  local name="$1" snippet="$2" out tries=0
  # Force exit 0 and a definitive token regardless of the snippet's own status.
  local wrapped="if ${snippet%% && echo present}"' >/dev/null 2>&1; then echo present; else echo absent; fi'
  while [ "$tries" -lt 5 ]; do
    tries=$((tries + 1))
    out=$(sbx exec "$name" -- sh -c "$wrapped" </dev/null 2>/dev/null | tr -d '\r')
    case "$out" in
      *present*) return 1 ;;   # ran, feature present
      *absent*)  return 0 ;;   # ran, feature absent
    esac
    # Neither token: probe didn't run cleanly (exec blip). Back off and retry.
    sleep 2
  done
  return 2   # probe never ran cleanly
}

# Run a snippet inside a sandbox, retrying on the transient failure sbx exec
# exhibits right after a sandbox (re)starts ("inspect exec: context deadline
# exceeded"). Echoes the snippet's stdout; returns 0 on the first clean run, or
# the last non-zero status if it never succeeds. Used for the migration
# export/import steps, which run against a just-recreated sandbox.
sbx_exec_retry() {
  local name="$1" snippet="$2" out rc tries=0
  while [ "$tries" -lt 5 ]; do
    tries=$((tries + 1))
    out=$(sbx exec "$name" -- sh -c "$snippet" </dev/null 2>/dev/null)
    rc=$?
    [ "$rc" -eq 0 ] && { printf '%s' "$out"; return 0; }
    sleep 2
  done
  printf '%s' "$out"
  return "$rc"
}

# In-place kit healing for pre-kit sandboxes (created by an older qsbx, or a
# plain `sbx run` without the --kit refs). For each built-in kit we probe whether
# its footprint is present in the sandbox and, if not, inject it with `sbx kit
# add`. As of sbx 0.35.0 `sbx kit add` recreates the sandbox container with the
# augmented kit set and PRESERVES state, so this heals a USAi-less sandbox in
# place — no export/recreate/import dance needed (qsbx requires sbx >= 0.35.0;
# see require_sbx_version and ADR-0009). Best-effort: if a `kit add` fails, warn
# with the manual recovery step and continue to attach.
ensure_kit_applied() {
  local name="$1"

  ensure_kit_sources_allowed

  # 1) USAi provider kit: present iff the kit's staged config file is present.
  #    (We probe the file the kit ships, not any env var: the kit no longer sets
  #    OPENCODE_CONFIG, and kit-injected env is not reliably visible to an exec
  #    shell anyway — see USAI_KIT_CONFIG_PATH.)
  if kit_feature_absent "$name" "test -f '$USAI_KIT_CONFIG_PATH' && echo present"; then
    echo "qsbx: '$name' is missing the USAi kit (no config file); injecting it" >&2
    echo "      with 'sbx kit add' (recreates the sandbox, preserving state)..." >&2
    if sbx kit add "$name" "$USAI_KIT" </dev/null >/dev/null 2>&1; then
      # The kit's startup step merges its config into the GLOBAL path
      # (~/.config/opencode/opencode.jsonc). A leftover dangling SYMLINK there
      # from a much older layout (when that path symlinked into a since-removed
      # opencode/ dir) would block that write, so remove it if — and only if — it
      # is a symlink that no longer resolves. A real merged config file is left
      # untouched (the guard requires -L).
      sbx exec "$name" -- sh -c \
        'f="$HOME/.config/opencode/opencode.jsonc"; if [ -L "$f" ] && [ ! -e "$f" ]; then rm -f "$f"; fi' \
        </dev/null >/dev/null 2>&1 || true
      echo "qsbx: USAi kit injected into '$name'." >&2
    else
      echo "qsbx: warning: 'sbx kit add' (USAi kit) failed for '$name'." >&2
      echo "      Recover with: sbx kit add '$name' '$USAI_KIT'" >&2
    fi
  fi

  # 2) Playbook kit: present iff the startup clone exists. The startup command
  #    runs on the next start after kit add, so it self-heals.
  if kit_feature_absent "$name" 'test -e "$HOME/.agentic-coding-playbook/.git" && echo present'; then
    echo "qsbx: '$name' is missing the playbook kit; injecting it with 'sbx kit add'..." >&2
    if sbx kit add "$name" "$PLAYBOOK_KIT" </dev/null >/dev/null 2>&1; then
      echo "qsbx: playbook kit injected into '$name'. Restart the agent to pick it up." >&2
    else
      echo "qsbx: warning: 'sbx kit add' (playbook kit) failed for '$name'." >&2
      echo "      Recover with: sbx kit add '$name' '$PLAYBOOK_KIT'" >&2
    fi
  fi

  # 3) Zscaler CA kit: present iff the installed cert exists.
  if kit_feature_absent "$name" 'test -e /usr/local/share/ca-certificates/zscaler-ca.crt && echo present'; then
    echo "qsbx: '$name' is missing the Zscaler CA kit; injecting it with 'sbx kit add'..." >&2
    if sbx kit add "$name" "$ZSCALER_KIT" </dev/null >/dev/null 2>&1; then
      echo "qsbx: Zscaler CA kit injected into '$name'. Restart the agent to pick it up." >&2
    else
      echo "qsbx: warning: 'sbx kit add' (Zscaler CA kit) failed for '$name'." >&2
      echo "      Recover with: sbx kit add '$name' '$ZSCALER_KIT'" >&2
    fi
  fi

  # 4) User-supplied QSBX_EXTRA_KITS. These have no content signature qsbx can
  #    probe, so we track which extras were already applied to this sandbox in a
  #    marker file (~/.qsbx-extra-kits) and only `kit add` the ones not recorded.
  #    Idempotent across re-invocations; adding a new entry to QSBX_EXTRA_KITS
  #    injects just that one on the next `qsbx run <existing-sandbox>`.
  local applied k
  applied=$(sbx exec "$name" -- sh -c 'cat "$HOME/.qsbx-extra-kits" 2>/dev/null' </dev/null 2>/dev/null || true)
  local _extras=()
  [ -n "$QSBX_EXTRA_KITS" ] && split_noglob _extras "$QSBX_EXTRA_KITS"
  for k in ${_extras[@]+"${_extras[@]}"}; do
    case "$applied" in
      *"$k"*) continue ;;   # already applied to this sandbox
    esac
    echo "qsbx: applying extra kit to '$name': $k" >&2
    if sbx kit add "$name" "$k" </dev/null >/dev/null 2>&1; then
      # Record it so we don't re-add on the next invocation. Append via the
      # agent user's home; the marker is advisory, failures are non-fatal.
      sbx exec "$name" -- sh -c 'printf "%s\n" "$0" >> "$HOME/.qsbx-extra-kits"' "$k" </dev/null >/dev/null 2>&1 || true
    else
      echo "qsbx: warning: 'sbx kit add' (extra kit) failed for '$name'." >&2
      echo "      Recover with: sbx kit add '$name' '$k'" >&2
    fi
  done
}

sandbox_exists() {
  # `sbx ls -q` prints bare sandbox names, one per line (no header). Match the
  # whole line as a fixed string so names containing regex metacharacters (e.g.
  # a dotted path slug) can't accidentally match a different sandbox.
  sbx ls -q 2>/dev/null | grep -Fxq -- "$1"
}

# Absolute path where the usai-provider kit STAGES its OpenCode config. As of the
# patterns v1.5.0 kit this staged file is the merge SOURCE: a startup step merges
# it into OpenCode's GLOBAL config (~/.config/opencode/opencode.jsonc), and the
# kit no longer sets OPENCODE_CONFIG. We still detect the kit by the presence of
# THIS staged FILE (not an env var, and not the merged global config): the kit
# always ships it, so it is present iff the kit was applied — including in a
# stopped sandbox where the startup merge has not re-run. kit-injected env vars
# are also not reliably visible to a fresh `sbx exec … sh -c` shell. Keep in sync
# with the kit's spec.yaml.
USAI_KIT_CONFIG_PATH="/home/agent/usai-config/opencode.jsonc"

# Print the manual recovery options when a session-preserving recreate can't be
# completed (declined by the user, or a migration step failed). Reached from the
# ADR-0008 stale-placeholder recovery via migrate_or_halt; NOT from routine
# pre-kit healing, which is now handled in place by ensure_kit_applied. Exits
# non-zero (fail closed). $1 = sandbox name.
halt_with_options() {
  local name="$1"
  cat >&2 <<EOF
qsbx: Sandbox '$name' couldn't be recreated, so it was left as-is.

      What you can do:
        1. Try the session-preserving recreate again: re-run and answer 'y' at
           the prompt. qsbx saves your chat sessions, recreates the sandbox the
           current way (same name), and loads them back in.
        2. Rebind this sandbox's USAi key in place (no delete) — re-run and, when
           offered, decline the recreate and accept the rebind instead.
        3. Start over without your old chat history — delete this sandbox
           first, then create it fresh:
             sbx rm --force '$name'
             ./qsbx run opencode <your-project-folder>

      More detail: docs/KNOWN_FAILURE_MODES.md (section 23).
EOF
  exit 1
}

# Copy a migration's exported session JSON out of the temp workdir (which is
# removed by migrate_or_halt's EXIT trap) into a stable, private location so a
# failed migration doesn't lose the user's exported sessions. Prints the path.
# $1 = sandbox name (for the dir label); $2 = the temp workdir being abandoned.
_preserve_migration_exports() {
  local name="$1" src="$2" dest
  # Only bother if there is something to save.
  case "$(echo "$src"/*.json)" in *"*.json") return 0 ;; esac
  dest="${TMPDIR:-/tmp}/qsbx-sessions-$(slugify "$name")-$$"
  if mkdir -p "$dest" 2>/dev/null && cp "$src"/*.json "$dest"/ 2>/dev/null; then
    chmod 700 "$dest" 2>/dev/null || true
    echo "      Your saved sessions are here: $dest" >&2
  fi
}

# Session-preserving recreate of a sandbox. sbx has no rename, so to give the
# rebuilt sandbox the ORIGINAL name we must remove the old one — which is
# destructive. We therefore export first, verify we captured something, and only
# then remove + recreate + import. If the user declines or any step fails, we
# halt with options and never remove a sandbox without a verified export.
#
# Sole caller: the ADR-0008 stale-placeholder recovery
# (offer_update_stale_placeholder), where the sandbox's baked-in USAI_API_KEY
# placeholder no longer resolves and recreating it mints a current one. (Pre-kit
# sandboxes no longer use this path — they heal in place via ensure_kit_applied /
# `sbx kit add` on sbx >= 0.35.0; see ADR-0009.)
#
# Flow: prompt -> export --sanitize each session to a host temp dir -> verify
# non-empty -> sbx rm --force old -> wait for name release -> create_with_config
# under the original name -> sbx cp + opencode import each -> return so the
# caller attaches. $1 = sandbox name; remaining args = the create args to reuse.
migrate_or_halt() {
  local name="$1"; shift
  local create_args=("$@")

  echo "qsbx: To fix '$name', qsbx will recreate it — moving your existing chat" >&2
  echo "      sessions across so you don't lose them." >&2
  echo "" >&2
  echo "      Here's what will happen:" >&2
  echo "        - Your sessions are saved (with sensitive details redacted)." >&2
  echo "        - This sandbox is deleted and recreated the current way, same name." >&2
  echo "        - Your saved sessions are loaded back in." >&2
  echo "" >&2
  echo "      This can't be undone. Your work in the current sandbox is replaced" >&2
  echo "      by the recreated one. If you say no, nothing changes, and we'll leave" >&2
  echo "      you pointers on how to manually recover access to your previous" >&2
  echo "      sessions." >&2
  echo "" >&2
  printf "qsbx: Move your sessions and recreate '%s'? [y/N] " "$name" >&2
  local reply=""
  # Read the confirmation from the terminal by default so a prompt still works
  # when stdin is a pipe. Tests set QSBX_PROMPT_STDIN=1 to read from stdin
  # instead (no tty available in CI / a harness).
  if [ -n "${QSBX_PROMPT_STDIN:-}" ]; then
    read -r reply || true
  else
    read -r reply </dev/tty || true
  fi
  case "$reply" in
    y|Y|yes|YES) ;;
    *) echo "qsbx: Okay, leaving '$name' as-is." >&2; halt_with_options "$name" ;;
  esac

  # Export sessions to a private host temp dir. Session JSON is the user's data;
  # keep it under a 0700 dir in TMPDIR and always clean it up (trap), never log
  # its contents, never write it into the repo.
  local workdir
  workdir=$(mktemp -d "${TMPDIR:-/tmp}/qsbx-migrate.XXXXXX") || {
    echo "qsbx: could not create a temp dir for migration." >&2; halt_with_options "$name"; }
  chmod 700 "$workdir"
  # Clean the temp dir on ANY exit of this process, not just function return: the
  # failure paths below call `exit 1`, and a RETURN trap does not fire on exit,
  # which would leak the mktemp dir. On failure we copy sessions to a stable
  # location first (_preserve_migration_exports), so this only removes the
  # transient working copy. shellcheck disable=SC2064: expand workdir now so the
  # trap targets this exact dir.
  # shellcheck disable=SC2064
  trap "rm -rf '$workdir'" EXIT

  echo "qsbx: Saving your sessions..." >&2
  # The old sandbox may be stopped; wait for exec readiness before listing and
  # exporting, so a cold-start timeout isn't misread as "no sessions".
  if ! wait_for_exec_ready "$name"; then
    echo "qsbx: '$name' didn't start up in time (${QSBX_EXEC_READY_TIMEOUT}s), so" >&2
    echo "      qsbx couldn't read its sessions. Nothing was changed; try again." >&2
    halt_with_options "$name"
  fi
  local ids id count=0
  ids=$(sbx_exec_retry "$name" 'opencode session list 2>/dev/null' | extract_session_ids) || true
  for id in $ids; do
    if sbx_exec_retry "$name" "opencode export '$id' --sanitize" >"$workdir/$id.json" 2>/dev/null \
        && [ -s "$workdir/$id.json" ]; then
      count=$((count + 1))
    else
      rm -f "$workdir/$id.json"
    fi
  done

  if [ "$count" -eq 0 ]; then
    echo "qsbx: Couldn't save any sessions from '$name', so it was left as-is." >&2
    halt_with_options "$name"
  fi
  echo "qsbx: Saved $count session(s)." >&2

  # Destructive: remove the old sandbox so the name frees up, then wait until
  # sbx no longer lists it (create fails if the name is still taken).
  echo "qsbx: Deleting the old sandbox '$name'..." >&2
  sbx rm --force "$name" </dev/null >/dev/null 2>&1 || {
    echo "qsbx: Couldn't delete '$name'. Nothing was changed; try again." >&2; halt_with_options "$name"; }
  local tries=0
  while sandbox_exists "$name"; do
    tries=$((tries + 1))
    [ "$tries" -gt 30 ] && { echo "qsbx: '$name' is still around after deleting; stopping here." >&2; exit 1; }
    sleep 1
  done

  echo "qsbx: Recreating '$name' the new way..." >&2
  if ! create_with_config "$name" "${create_args[@]+"${create_args[@]}"}"; then
    echo "qsbx: Couldn't recreate '$name'." >&2
    _preserve_migration_exports "$name" "$workdir"
    exit 1
  fi

  # Fail closed: confirm the usai-provider kit actually landed. The create can
  # succeed at the sandbox level yet not apply the kit (e.g. kit source not
  # allow-listed, kit resolution error) — importing sessions into a USAi-less
  # sandbox would just recreate the problem we set out to fix. Wait for exec
  # readiness first (the sandbox was just created), then probe the kit's config
  # file — not a USAi HTTP call: the injected USAI_API_KEY answers 200 even with
  # no kit applied.
  if ! wait_for_exec_ready "$name"; then
    echo "qsbx: '$name' was recreated but didn't start up in time to check it." >&2
    echo "      Your saved sessions were not loaded, but they are kept safe:" >&2
    _preserve_migration_exports "$name" "$workdir"
    exit 1
  fi
  if kit_feature_absent "$name" "test -f '$USAI_KIT_CONFIG_PATH' && echo present"; then
    echo "qsbx: '$name' was recreated, but the new setup didn't take effect, so" >&2
    echo "      qsbx won't load your sessions into it. Your saved sessions are kept" >&2
    echo "      safe below. Please report this if it keeps happening." >&2
    _preserve_migration_exports "$name" "$workdir"
    exit 1
  fi

  echo "qsbx: Loading your saved sessions back in..." >&2
  local f base tries imported=0
  for f in "$workdir"/*.json; do
    [ -e "$f" ] || continue
    base=$(basename "$f")
    # The sandbox was just recreated; sbx cp can hit the transient post-start
    # "context deadline exceeded" too, so retry the copy briefly.
    tries=0
    while [ "$tries" -lt 5 ] && ! sbx cp "$f" "$name:/tmp/$base" </dev/null >/dev/null 2>&1; do
      tries=$((tries + 1)); sleep 2
    done
    if [ "$tries" -lt 5 ] \
        && sbx_exec_retry "$name" "opencode import '/tmp/$base'; rm -f '/tmp/$base'" >/dev/null 2>&1; then
      imported=$((imported + 1))
    else
      echo "qsbx: warning: couldn't load one saved session back in." >&2
    fi
  done
  echo "qsbx: Done — moved $imported of $count session(s) into '$name'. Opening it now." >&2
  # Success: drop the transient working copy now and disarm the EXIT trap so it
  # doesn't linger for the remainder of the process (attach).
  rm -rf "$workdir"
  trap - EXIT
}

# Extract session IDs from `opencode session list` output on stdin. The command
# is human-oriented, so pull the first whitespace-delimited token that looks like
# a session id (ses_… or a hex/alnum id) off each non-empty line.
extract_session_ids() {
  awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^ses_[A-Za-z0-9]+$/) { print $i; break } }'
}

# Probe the USAi API from inside the sandbox using its injected USAI_API_KEY.
# Echoes the HTTP status code (e.g. 200, 401). A non-200 means the key is
# missing, invalid, or expired. Mirrors the validation in scripts/rotate-apikey,
# but targets the sandbox we are about to attach to.
check_key() {
  local name="$1"
  sbx exec "$name" -- sh -c \
    "curl -sS -o /dev/null -w '%{http_code}' \
     -H \"Authorization: Bearer \$USAI_API_KEY\" \
     $USAI_MODELS_URL" </dev/null 2>/dev/null || true
}

check_fresh_sandbox_key() {
  local validation_sbx="qsbx-keycheck-$$"
  local status=""

  if ! sbx create --name "$validation_sbx" shell . </dev/null >/dev/null 2>&1; then
    return 0
  fi

  # Guarantee cleanup even if the exec/curl below fails or the user interrupts
  # (Ctrl-C) before the explicit rm — otherwise the validation sandbox leaks
  # (qsbx-keycheck-PID accumulates). Mirrors scripts/rotate-apikey. The trap is
  # disarmed once the explicit rm has run.
  # shellcheck disable=SC2064
  trap "sbx rm --force '$validation_sbx' </dev/null >/dev/null 2>&1 || true" EXIT

  status=$(sbx exec "$validation_sbx" -- sh -c \
    "curl -sS -o /dev/null -w '%{http_code}' \
     -H \"Authorization: Bearer \$USAI_API_KEY\" \
     $USAI_MODELS_URL" </dev/null 2>/dev/null || true)
  sbx rm --force "$validation_sbx" </dev/null >/dev/null 2>&1 || true
  trap - EXIT
  printf '%s\n' "$status"
}

global_usai_placeholder() {
  sbx secret ls -g 2>/dev/null \
    | awk '$0 ~ /api[.]gsa[.]usai[.]gov/ { for (i = 1; i <= NF; i++) if ($i == "USAI_API_KEY") { print $(i+1); exit } }'
}

sandbox_usai_placeholder() {
  local name="$1"
  sbx exec "$name" -- sh -c 'printf "%s" "${USAI_API_KEY:-}"' </dev/null 2>/dev/null || true
}

# Repair path for a sandbox whose baked-in USAI_API_KEY placeholder no longer
# resolves — the classic case being a global USAi secret that was DELETED and
# re-added (or otherwise regenerated), which mints a NEW placeholder. A fresh
# sandbox gets the new placeholder (so check_fresh_sandbox_key is 200), but the
# existing sandbox still carries the OLD placeholder, so the proxy resolves it to
# nothing and USAi returns 401. The old sandbox's baked-in value can even read
# back EMPTY. See docs/KNOWN_FAILURE_MODES.md section 23 and ADR-0008.
#
# Two recovery routes, offered in this order:
#   1. Recreate the sandbox via the session-preserving migration (migrate_or_halt)
#      — guarantees a correct, current placeholder and keeps chat sessions. This
#      is offered FIRST when we have the create args to do it.
#   2. Non-destructive rebind: add a sandbox-scoped custom secret bound to the
#      CURRENT GLOBAL placeholder (not the stale/empty sandbox one), prompting for
#      the key. Keeps the sandbox as-is.
#
# Usage: offer_update_stale_placeholder NAME STATUS [CREATE_ARGS...]
# CREATE_ARGS (optional) are the `sbx create`-style args used to offer route 1;
# when absent (e.g. attach-by-name), only route 2 is offered.
offer_update_stale_placeholder() {
  local name="$1"
  local status="$2"
  shift 2
  local create_args=("$@")
  local sandbox_placeholder=""
  local global_placeholder=""
  sandbox_placeholder=$(sandbox_usai_placeholder "$name")
  global_placeholder=$(global_usai_placeholder)

  echo >&2
  echo "The global USAi key works in a fresh sandbox, but '$name' still" >&2
  echo "fails with HTTP ${status:-unknown}. This usually means the existing" >&2
  echo "sandbox has a stale USAI_API_KEY placeholder — most often because the" >&2
  echo "global USAi secret was deleted and re-added, which regenerates the" >&2
  echo "placeholder. A fresh sandbox picks up the new one; this one still has" >&2
  echo "the old (now unresolvable) placeholder." >&2
  echo >&2

  # Not a stale-placeholder case: the sandbox already carries the SAME placeholder
  # as the current global secret, so rebinding it would change nothing. (An empty
  # sandbox placeholder never equals a non-empty global one, so this correctly
  # does NOT fire on the empty/orphaned case handled below.)
  if [ -n "$sandbox_placeholder" ] && [ -n "$global_placeholder" ] \
      && [ "$sandbox_placeholder" = "$global_placeholder" ]; then
    echo "'$name' already uses the current global placeholder, so this is not" >&2
    echo "a stale-placeholder case. Aborting attach." >&2
    return 1
  fi

  # Route 1 (preferred): session-preserving recreate. Offered only when we have
  # both the create args to rebuild the sandbox and the migration helper. This
  # keeps the user's chat sessions and guarantees a current placeholder.
  if [ "${#create_args[@]}" -gt 0 ] && command -v migrate_or_halt >/dev/null 2>&1; then
    echo "The most reliable fix is to recreate '$name' the current way, moving" >&2
    echo "your existing chat sessions across. This guarantees a working key." >&2
    printf "Recreate '%s' (keeping your sessions) now? [y/N] " "$name" >&2
    local recreate_answer=""
    if [ -n "${QSBX_PROMPT_STDIN:-}" ]; then
      read -r recreate_answer || true
    else
      read -r recreate_answer </dev/tty || true
    fi
    case "$recreate_answer" in
      [yY]|[yY][eE][sS])
        # migrate_or_halt exits the process on failure and returns 0 on success,
        # after which the caller attaches. It re-exports/imports sessions itself.
        migrate_or_halt "$name" "${create_args[@]}"
        return 0
        ;;
    esac
    echo >&2
  fi

  # Route 2: non-destructive rebind to the CURRENT GLOBAL placeholder. We must
  # have a global placeholder to bind to — binding to the stale/empty sandbox
  # placeholder is exactly what left the sandbox broken, so never do that.
  if [ -z "$global_placeholder" ]; then
    echo "Could not read a current global USAi placeholder to rebind to, so" >&2
    echo "qsbx cannot repair '$name' in place. Recreate it with:" >&2
    echo "  sbx rm --force '$name' && ./qsbx run opencode <your-project-folder>" >&2
    echo "Aborting attach." >&2
    return 1
  fi

  echo "Alternatively, qsbx can repair this WITHOUT deleting the sandbox by" >&2
  echo "adding a sandbox-scoped USAi secret bound to the CURRENT global" >&2
  echo "placeholder. You will be prompted for the current USAi key; qsbx will" >&2
  echo "not pass the key on the command line." >&2
  printf "Rebind '%s' to the current placeholder now? [y/N] " "$name" >&2
  local repair_answer=""
  if [ -n "${QSBX_PROMPT_STDIN:-}" ]; then
    read -r repair_answer || true
  else
    read -r repair_answer </dev/tty || true
  fi
  case "$repair_answer" in
    [yY]|[yY][eE][sS])
      sbx secret set-custom "$name" --host api.gsa.usai.gov \
        --env USAI_API_KEY --placeholder "$global_placeholder"
      status=$(check_key "$name")
      if [ "$status" = "200" ]; then
        echo "Sandbox placeholder repaired and key validated. Continuing." >&2
        return 0
      fi
      echo "Sandbox placeholder updated, but key still not working (HTTP ${status:-unknown}). Aborting attach." >&2
      return 1
      ;;
  esac

  echo "Leaving existing sandbox unchanged. Aborting attach." >&2
  return 1
}

# Warn (do not block) if the host has no SSH key loaded for the git-ssh-sign
# kit. The kit signs commits/tags with the forwarded SSH agent key and fails
# CLOSED at commit time if none is loaded — so surface it up front rather than
# letting the user discover it mid-commit. We check the HOST's agent (this
# script runs on the host); `ssh-add -L` exits non-zero / prints a notice when
# the agent is empty or absent. Purely advisory: never affects the exit path.
warn_if_no_ssh_signing_key() {
  local keys=""
  if command -v ssh-add >/dev/null 2>&1; then
    keys=$(ssh-add -L 2>/dev/null || true)
  fi
  case "$keys" in
    ssh-*|ecdsa-*|sk-*)
      return 0 ;;  # at least one key is loaded
  esac
  echo "qsbx: note — no SSH key is loaded in your host's SSH agent." >&2
  echo "      This sandbox signs git commits with your forwarded SSH key, and" >&2
  echo "      commits will FAIL until a key is loaded. To fix, on your host run:" >&2
  echo "        ssh-add ~/.ssh/id_ed25519   # or your signing key" >&2
  echo "      Then commit as usual. (You can still work; only committing needs it.)" >&2
}

# Warn (do not block) if the committer git identity that will be used inside the
# sandbox has no resolvable user.email. The git-ssh-sign kit signs commits, but
# GitHub only marks a signed commit "Verified" when the commit's user.email is a
# verified email on the committer's GitHub account AND the signing key is
# registered on that account as a *Signing Key*. Neither the kit nor its sibling
# kits set user.email, so absent identity yields signed-but-Unverified commits.
#
# CRITICAL: only the REPO-LOCAL identity crosses into the sandbox. sbx mounts the
# workspace (so the repo's .git/config is visible) but NOT the host home — the
# sandbox has its own empty $HOME, so the host's GLOBAL/system git identity is
# invisible inside it. We therefore check ONLY the workspace's local config
# (`git -C <path> config --local user.email`); a plain lookup would fall through
# to the host global and give a false-negative (staying silent when the sandbox
# will in fact have no identity). If no workspace path is known (attach-by-name),
# there is nothing meaningful to check on the host, so we skip. Purely advisory:
# fail-open if git is absent, and never affects the exit path.
# Usage: warn_if_no_git_identity WORKSPACE_PATH   (no-op if path is empty)
warn_if_no_git_identity() {
  local path="${1:-}" email=""
  command -v git >/dev/null 2>&1 || return 0
  # No workspace path (attach-by-name): the host global identity does NOT reach
  # the sandbox, so we can't meaningfully predict the sandbox identity. Skip.
  [ -n "$path" ] && [ -d "$path" ] || return 0
  # Repo-local only — the sole tier that reaches the sandbox via the mount.
  email=$(git -C "$path" config --local user.email 2>/dev/null || true)
  [ -n "$email" ] && return 0
  echo "qsbx: note — no repo-local git user.email is set for this project." >&2
  echo "      The sandbox has its own empty home, so your host's global git" >&2
  echo "      identity is NOT visible inside it. Commits will be SIGNED but show" >&2
  echo "      'Unverified' on GitHub until you set an identity that reaches the" >&2
  echo "      sandbox and register your signing key. Fix (in this project):" >&2
  echo "        git config user.email you@verified-on-github.example" >&2
  echo "        git config user.name  \"Your Name\"" >&2
  echo "      (repo-local config lives in the workspace, so the sandbox sees it.)" >&2
  echo "      Then add your PUBLIC signing key to GitHub as a SIGNING key:" >&2
  echo "      Settings > SSH and GPG keys > New SSH key > Key type: Signing Key." >&2
}

# Validate the sandbox's key and, if it is not working, walk the user through
# rotating it via scripts/rotate-apikey. Best-effort: if we cannot run the check
# (e.g. no curl in the sandbox), we warn and continue rather than block attach.
# Usage: ensure_valid_key NAME [CREATE_ARGS...]
# CREATE_ARGS (optional) are the `sbx create`-style args; when provided they let
# the stale-placeholder repair offer a session-preserving recreate as its first
# option (see offer_update_stale_placeholder). Attach-by-name omits them.
ensure_valid_key() {
  local name="$1"
  shift
  local create_args=("$@")
  local status
  local fresh_status
  status=$(check_key "$name")

  if [ "$status" = "200" ]; then
    return 0
  fi

  if [ -z "$status" ]; then
    echo "warning: could not validate USAI_API_KEY for '$name' (skipping check)" >&2
    return 0
  fi

  fresh_status=$(check_fresh_sandbox_key)
  if [ "$fresh_status" = "200" ]; then
    offer_update_stale_placeholder "$name" "$status" "${create_args[@]+"${create_args[@]}"}"
    return $?
  fi

  echo >&2
  echo "Your USAi API key looks invalid or expired (HTTP $status from the models API)." >&2
  echo "USAi keys expire every 7 days." >&2
  echo >&2
  echo "To rotate it:" >&2
  echo "  1. Open $KEY_MGMT_URL" >&2
  echo "  2. Choose 'Rotate' from the Actions menu for your key" >&2
  echo "  3. Copy the new key using the console copy button" >&2
  echo >&2

  if [ ! -x "$ROTATE_SCRIPT" ]; then
    echo "Cannot find scripts/rotate-apikey; rotate manually, then re-run." >&2
    return 1
  fi

  printf 'Have the new key ready to paste? Rotate now? [y/N] ' >&2
  local answer=""
  read -r answer || true
  case "$answer" in
    [yY]|[yY][eE][sS])
      "$ROTATE_SCRIPT"
      # Re-validate after rotation.
      status=$(check_key "$name")
      if [ "$status" = "200" ]; then
        echo "Key validated. Continuing." >&2
        return 0
      fi

      fresh_status=$(check_fresh_sandbox_key)
      if [ "$fresh_status" = "200" ]; then
        offer_update_stale_placeholder "$name" "$status" "${create_args[@]+"${create_args[@]}"}"
        return $?
      fi

      echo "Key still not working (HTTP ${status:-unknown}). Aborting attach." >&2
      return 1
      ;;
    *)
      echo "Skipping rotation. Aborting attach; re-run when your key is rotated." >&2
      return 1
      ;;
  esac
}

# Allow tests to source this script for its functions without running the
# dispatch below: `QSBX_SOURCE_ONLY=1 . ./qsbx`. Normal invocation is unaffected.
if [ -n "${QSBX_SOURCE_ONLY:-}" ]; then  return 0 2>/dev/null || exit 0
fi

# qsbx is deprecated in 1.1.0. Use ./acq instead (same commands on the sbx backend).
# This notice is silenceable for tests/CI; qsbx remains fully functional until 2.0.0.
if [ -z "${QSBX_SILENCE_DEPRECATION:-}" ]; then
  echo "qsbx: note — qsbx is deprecated; use ./acq (same commands on the sbx backend)." >&2
  echo "      This notice will be removed when qsbx is removed in 2.0.0." >&2
  echo "      Set QSBX_SILENCE_DEPRECATION=1 to hide this." >&2
fi

subcommand="${1:-}"

case "$subcommand" in
  version|--version|-v)
    # Report which qsbx is actually running (resolved path + clone git state).
    # This is deliberately NOT passed through to `sbx version`; use `sbx version`
    # directly for the sbx CLI's own version.
    print_version
    exit 0
    ;;

  usai-rotate-api-key)
    # Front the standalone rotation helper as a subcommand so qsbx is the single
    # entry point for this repo's sbx extensions. The script stays runnable on
    # its own. Forward any extra args through to it.
    shift
    if [ ! -x "$ROTATE_SCRIPT" ]; then
      echo "qsbx: scripts/rotate-apikey not found or not executable" >&2
      exit 1
    fi
    exec "$ROTATE_SCRIPT" "$@"
    ;;

  create)
    shift
    require_sbx_version
    name=$(derive_name "$@") || exit 1
    [ -n "$name" ] || { echo "qsbx: could not determine sandbox name" >&2; exit 1; }
    create_with_config "$name" "$@"
    ;;

  run)
    shift
    require_sbx_version
    # Surface the wrong-clone / didn't-switch trap up front: if the user is
    # inside one quickstart clone but the running qsbx lives in another, they may
    # be running stale code. Advisory only.
    warn_if_running_foreign_clone
    # Split args into the create portion (agent + paths + flags) and any agent
    # args after "--", which only apply on attach.
    create_args=()
    agent_args=()
    seen_sep=0
    for arg in "$@"; do
      if [ "$seen_sep" -eq 1 ]; then
        agent_args+=("$arg")
      elif [ "$arg" = "--" ]; then
        seen_sep=1
      else
        create_args+=("$arg")
      fi
    done

    first=""
    [ "${#create_args[@]}" -gt 0 ] && first=$(first_positional "${create_args[@]}")

    if [ -n "$first" ] && is_known_agent "$first"; then
      # AGENT form: create the sandbox if it does not exist, then attach to it.
      name=$(derive_name "${create_args[@]}") || exit 1
      [ -n "$name" ] || { echo "qsbx: could not determine sandbox name" >&2; exit 1; }
      if sandbox_exists "$name"; then
        # Existing sandbox. Heal any missing kits in place: on sbx >= 0.35.0
        # `sbx kit add` recreates the container with the augmented kit set and
        # preserves state, so a pre-kit (USAi-less) sandbox is fixed without any
        # export/recreate/import dance. See ensure_kit_applied and ADR-0009.
        ensure_kit_applied "$name"
      else
        create_with_config "$name" "${create_args[@]}"
      fi

      # Verify the sandbox's USAi key works before attaching; prompt to rotate
      # if it does not. Pass the create args so a stale-placeholder repair can
      # offer a session-preserving recreate as its first option.
      ensure_valid_key "$name" "${create_args[@]}"

      # Advisory: the git-ssh-sign kit signs commits with the forwarded SSH key
      # and fails closed if the host agent has no key loaded. Warn up front.
      warn_if_no_ssh_signing_key

      # Advisory: signing alone doesn't make commits GitHub-"Verified" — that
      # needs a repo-local user.email (the only identity tier that reaches the
      # sandbox via the workspace mount; the host's global config does not).
      # Probe the workspace git will use: the path arg if given, else $PWD
      # (sbx's default workspace, which is mounted).
      ws=$(workspace_path "${create_args[@]}"); [ -n "$ws" ] || ws="$PWD"
      warn_if_no_git_identity "$ws"

      # Attach by name. `sbx run --name <name>` re-attaches independent of the
      # working directory; the agent positional is omitted on attach (sbx infers
      # it from the named sandbox and errors if a mismatching agent is passed).
      if [ "${#agent_args[@]}" -gt 0 ]; then
        sbx run --name "$name" -- "${agent_args[@]}"
      else
        sbx run --name "$name"
      fi
    else
      # No agent positional. If the first arg names an existing sandbox, attach
      # to it by name (the positional-sandbox form is deprecated in sbx); else
      # pass through unchanged (e.g. flags-only, or `sbx run` with no args).
      if [ -n "$first" ] && sandbox_exists "$first"; then
        # Existing sandbox attached by name. Heal any missing kits in place:
        # `sbx kit add` on sbx >= 0.35.0 recreates the container preserving
        # state, so a pre-kit (USAi-less) sandbox is fixed without recreation
        # arguments. See ensure_kit_applied and ADR-0009.
        ensure_kit_applied "$first"
        warn_if_no_ssh_signing_key
        # Attach-by-name: no workspace path is in the args, and the host's global
        # git identity does NOT reach the sandbox, so there's nothing meaningful
        # to check here — the identity advisory is a no-op without a path.
        # Rebuild the arg list with the matched sandbox token removed (drop only
        # the first occurrence), so flags that appear before the name are
        # preserved and the name isn't duplicated. Positional `${@:2}` would be
        # wrong whenever the name isn't $1 (e.g. `qsbx run -t tpl mysandbox`).
        rest=(); dropped=0
        for arg in "$@"; do
          if [ "$dropped" -eq 0 ] && [ "$arg" = "$first" ]; then dropped=1; continue; fi
          rest+=("$arg")
        done
        # ${arr[@]+...} keeps this bash-3.2-safe under set -u when rest is empty.
        sbx run --name "$first" ${rest[@]+"${rest[@]}"}
      else
        sbx run "$@"
      fi
    fi
    ;;

  *)
    # --- Any other subcommand: pass through unmolested ---
    sbx "$@"
    ;;
esac
