*.ps1 text eol=lf

# Shell sources keep LF endings in every checkout. Git for Windows defaults to
# core.autocrlf=true, which would give them CRLF endings, and bash under Git Bash
# fails on the CRs (`set -euo pipefail\r` is an invalid option). That breaks
# the default acq path in a plain Windows clone and any Bash step on a Windows CI
# runner that checks out with autocrlf=true (as the release job does).
# py-acq/tests/test_line_endings.py fails when a tracked shell script is not
# covered here.
*.sh text eol=lf
*.bash text eol=lf
*.bats text eol=lf
acq text eol=lf
acq-python text eol=lf
